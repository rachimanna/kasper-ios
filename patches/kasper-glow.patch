diff --git a/submodules/TelegramUI/Sources/Kasper/KasperTouchGlow.swift b/submodules/TelegramUI/Sources/Kasper/KasperTouchGlow.swift
new file mode 100644
index 00000000..1200c3b5
--- /dev/null
+++ b/submodules/TelegramUI/Sources/Kasper/KasperTouchGlow.swift
@@ -0,0 +1,145 @@
+import Foundation
+import UIKit
+import UIKit.UIGestureRecognizerSubclass
+
+/// Мягкое свечение под каждым касанием по всему Kasper.
+///
+/// На каждое окно ставится «наблюдатель» касаний. Он ничего не перехватывает:
+/// касание сразу уходит дальше, в кнопки и списки, как обычно. Наблюдатель только
+/// рисует поверх окна маленькую фиолетовую вспышку, которая за полсекунды тает.
+/// Клавиатуру не трогаем, чтобы не мешать набору текста.
+/// Если в настройках iPhone включено «Уменьшение движения», свечения нет.
+final class KasperTouchGlow: NSObject, UIGestureRecognizerDelegate {
+    static let shared = KasperTouchGlow()
+
+    private var observer: NSObjectProtocol?
+    private let glowColor = UIColor(red: 0.64, green: 0.45, blue: 1.0, alpha: 1.0)
+
+    func start() {
+        guard self.observer == nil else {
+            return
+        }
+        self.observer = NotificationCenter.default.addObserver(forName: UIWindow.didBecomeVisibleNotification, object: nil, queue: .main, using: { [weak self] notification in
+            if let window = notification.object as? UIWindow {
+                self?.install(on: window)
+            }
+        })
+        DispatchQueue.main.async { [weak self] in
+            guard let self else {
+                return
+            }
+            for scene in UIApplication.shared.connectedScenes {
+                guard let windowScene = scene as? UIWindowScene else {
+                    continue
+                }
+                for window in windowScene.windows {
+                    self.install(on: window)
+                }
+            }
+        }
+    }
+
+    private func install(on window: UIWindow) {
+        let className = NSStringFromClass(type(of: window))
+        if className.contains("Keyboard") || className.contains("TextEffects") {
+            return
+        }
+        if window.gestureRecognizers?.contains(where: { $0 is KasperTouchObserver }) == true {
+            return
+        }
+        let recognizer = KasperTouchObserver(target: nil, action: nil)
+        recognizer.cancelsTouchesInView = false
+        recognizer.delaysTouchesBegan = false
+        recognizer.delaysTouchesEnded = false
+        recognizer.delegate = self
+        recognizer.onTouch = { [weak self, weak window] point in
+            guard let self, let window else {
+                return
+            }
+            self.flash(at: point, in: window)
+        }
+        window.addGestureRecognizer(recognizer)
+    }
+
+    private func flash(at point: CGPoint, in window: UIWindow) {
+        if UIAccessibility.isReduceMotionEnabled {
+            return
+        }
+        let size: CGFloat = 64.0
+        let glow = CAGradientLayer()
+        glow.type = .radial
+        glow.colors = [
+            self.glowColor.withAlphaComponent(0.42).cgColor,
+            self.glowColor.withAlphaComponent(0.16).cgColor,
+            self.glowColor.withAlphaComponent(0.0).cgColor
+        ]
+        glow.locations = [0.0, 0.45, 1.0]
+        glow.startPoint = CGPoint(x: 0.5, y: 0.5)
+        glow.endPoint = CGPoint(x: 1.0, y: 1.0)
+        glow.frame = CGRect(x: point.x - size / 2.0, y: point.y - size / 2.0, width: size, height: size)
+        glow.zPosition = 10_000.0
+        glow.opacity = 0.0
+
+        window.layer.addSublayer(glow)
+
+        let scale = CABasicAnimation(keyPath: "transform.scale")
+        scale.fromValue = 0.35
+        scale.toValue = 1.35
+
+        let fade = CAKeyframeAnimation(keyPath: "opacity")
+        fade.values = [0.0, 1.0, 0.0]
+        fade.keyTimes = [0.0, 0.18, 1.0]
+
+        let group = CAAnimationGroup()
+        group.animations = [scale, fade]
+        group.duration = 0.5
+        group.timingFunction = CAMediaTimingFunction(name: .easeOut)
+        group.isRemovedOnCompletion = true
+
+        CATransaction.begin()
+        CATransaction.setCompletionBlock {
+            glow.removeFromSuperlayer()
+        }
+        glow.add(group, forKey: "kasperTouchGlow")
+        CATransaction.commit()
+    }
+
+    // Наблюдатель никогда не мешает другим жестам
+    func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith otherGestureRecognizer: UIGestureRecognizer) -> Bool {
+        return true
+    }
+}
+
+/// Жест, который никогда не срабатывает: только сообщает, где коснулись, и сразу сдаётся.
+private final class KasperTouchObserver: UIGestureRecognizer {
+    var onTouch: ((CGPoint) -> Void)?
+
+    override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent) {
+        if let view = self.view {
+            for touch in touches {
+                self.onTouch?(touch.location(in: view))
+            }
+        }
+        self.state = .failed
+    }
+
+    override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent) {
+        self.state = .failed
+    }
+
+    override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent) {
+        self.state = .failed
+    }
+
+    override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent) {
+        self.state = .failed
+    }
+
+    override func canPrevent(_ preventedGestureRecognizer: UIGestureRecognizer) -> Bool {
+        return false
+    }
+
+    override func canBePrevented(by preventingGestureRecognizer: UIGestureRecognizer) -> Bool {
+        return false
+    }
+}
