diff --git a/submodules/Display/Source/Font.swift b/submodules/Display/Source/Font.swift
index 4f1a4c0..416db50 100644
--- a/submodules/Display/Source/Font.swift
+++ b/submodules/Display/Source/Font.swift
@@ -1,6 +1,117 @@
 import Foundation
 import UIKit
 
+/// Kasper: свой шрифт для всего приложения (раздел «Шрифты»).
+/// Display не видит TelegramCore, поэтому выбор читаем по ключам UserDefaults.
+/// Значения берутся один раз при запуске: так весь интерфейс остаётся в одном шрифте,
+/// а новый выбор применяется после перезапуска Kasper.
+public enum KasperFontOverride {
+    /// Папка со шрифтами, которые пользователь добавил сам (.ttf / .otf).
+    public static var customFontsFolder: URL? {
+        guard let directory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+            return nil
+        }
+        return directory.appendingPathComponent("Kasper", isDirectory: true).appendingPathComponent("Fonts", isDirectory: true)
+    }
+
+    /// Регистрирует добавленные шрифты, чтобы iOS их увидела. Можно вызывать повторно.
+    @discardableResult
+    public static func registerCustomFonts() -> [String] {
+        guard let folder = customFontsFolder, let files = try? FileManager.default.contentsOfDirectory(at: folder, includingPropertiesForKeys: nil) else {
+            return []
+        }
+        var families: [String] = []
+        for file in files {
+            let ext = file.pathExtension.lowercased()
+            guard ext == "ttf" || ext == "otf" else {
+                continue
+            }
+            CTFontManagerRegisterFontsForURL(file as CFURL, .process, nil)
+            if let descriptors = CTFontManagerCreateFontDescriptorsFromURL(file as CFURL) {
+                for index in 0 ..< CFArrayGetCount(descriptors) {
+                    guard let rawValue = CFArrayGetValueAtIndex(descriptors, index) else {
+                        continue
+                    }
+                    let descriptor = unsafeBitCast(rawValue, to: CTFontDescriptor.self)
+                    if let family = CTFontDescriptorCopyAttribute(descriptor, kCTFontFamilyNameAttribute) as? String, !families.contains(family) {
+                        families.append(family)
+                    }
+                }
+            }
+        }
+        return families
+    }
+
+    private struct State {
+        let family: String
+        let weightShift: Int
+    }
+
+    private static let state: State? = {
+        let defaults = UserDefaults.standard
+        let family = defaults.string(forKey: "kasper.font.family") ?? "system"
+        let shift = max(-2, min(2, defaults.integer(forKey: "kasper.font.weightShift")))
+        if family == "system" && shift == 0 {
+            return nil
+        }
+        switch family {
+        case "system", "rounded", "serif", "mono":
+            break
+        default:
+            registerCustomFonts()
+            // шрифт удалили или он недоступен — остаёмся на системном
+            if !UIFont.familyNames.contains(family) {
+                return shift == 0 ? nil : State(family: "system", weightShift: shift)
+            }
+        }
+        return State(family: family, weightShift: shift)
+    }()
+
+    public static var isActive: Bool {
+        return state != nil
+    }
+
+    private static let weights: [UIFont.Weight] = [.ultraLight, .thin, .light, .regular, .medium, .semibold, .bold, .heavy, .black]
+
+    private static func shifted(_ weight: UIFont.Weight, by shift: Int) -> UIFont.Weight {
+        guard shift != 0 else {
+            return weight
+        }
+        var index = weights.firstIndex(where: { $0.rawValue >= weight.rawValue - 0.01 }) ?? 3
+        index = max(0, min(weights.count - 1, index + shift))
+        return weights[index]
+    }
+
+    /// Шрифт Kasper вместо системного или nil, если пользователь ничего не менял.
+    public static func font(size: CGFloat, weight: UIFont.Weight, italic: Bool) -> UIFont? {
+        guard let state = state else {
+            return nil
+        }
