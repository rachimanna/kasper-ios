+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import LegacyMediaPickerUI
+
+private func kasperAlert(_ context: AccountContext, _ navigation: KasperNavigation, title: String?, text: String) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    navigation.present(textAlertController(context: context, title: title, text: text, actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]))
+}
+
+private func kasperPickFile(_ context: AccountContext, _ navigation: KasperNavigation, types: [String], completion: @escaping (URL) -> Void) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let picker = legacyICloudFilePicker(theme: presentationData.theme, mode: .import, documentTypes: types, completion: { urls in
+        if let url = urls.first {
+            completion(url)
+        }
+    })
+    navigation.present(picker)
+}
+
+// MARK: - Шрифты
+
+private let kasperFontChoices: [(String, String)] = [
+    ("system", "Системный (San Francisco)"),
+    ("rounded", "Округлый"),
+    ("serif", "С засечками (New York)"),
+    ("mono", "Моноширинный"),
+    ("Avenir Next", "Avenir Next"),
+    ("Helvetica Neue", "Helvetica Neue"),
+    ("Georgia", "Georgia"),
+    ("Futura", "Futura"),
+    ("Gill Sans", "Gill Sans"),
+    ("Palatino", "Palatino")
+]
+
+func kasperFontsController(context: AccountContext) -> ViewController {
+    let navigation = KasperNavigation()
+    let refresh = ValuePromise<Int>(0, ignoreRepeated: false)
+    var tick = 0
+    let reload: () -> Void = {
+        tick += 1
+        refresh.set(tick)
+    }
+    let defaults = UserDefaults.standard
+    let appliedFamily = defaults.string(forKey: "kasper.font.family") ?? "system"
+    let appliedShift = defaults.integer(forKey: "kasper.font.weightShift")
+
+    let groups = refresh.get()
+    |> map { _ -> [KasperGroup] in
+        let family = defaults.string(forKey: "kasper.font.family") ?? "system"
+        let shift = defaults.integer(forKey: "kasper.font.weightShift")
+        let custom = KasperFontOverride.registerCustomFonts()
+
+        var fontRows: KasperGroup = [.sectionTitle(id: "font-title", text: "ШРИФТ")]
+        for (key, title) in kasperFontChoices {
+            fontRows.append(.choice(id: "font-\(key)", title: title, selected: family == key, action: {
+                defaults.set(key, forKey: "kasper.font.family")
+                reload()
+            }))
+        }
+        for name in custom where !kasperFontChoices.contains(where: { $0.0 == name }) {
+            fontRows.append(.choice(id: "font-custom-\(name)", title: "\(name) · свой", selected: family == name, action: {
+                defaults.set(name, forKey: "kasper.font.family")
+                reload()
+            }))
+        }
+        fontRows.append(.action(id: "font-import", title: "Добавить свой шрифт (.ttf, .otf)…", destructive: false, action: {
+            kasperPickFile(context, navigation, types: ["public.truetype-ttf-font", "public.opentype-font", "public.font"], completion: { url in
+                guard let folder = KasperFontOverride.customFontsFolder else {
+                    return
+                }
+                try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true, attributes: nil)
+                let destination = folder.appendingPathComponent(url.lastPathComponent)
+                try? FileManager.default.removeItem(at: destination)
+                do {
+                    try FileManager.default.copyItem(at: url, to: destination)
+                } catch {
+                    kasperAlert(context, navigation, title: "Не удалось добавить шрифт", text: error.localizedDescription)
+                    return
+                }
+                let before = Set(custom)
+                let after = KasperFontOverride.registerCustomFonts()
+                if let added = after.first(where: { !before.contains($0) }) ?? after.last {
+                    defaults.set(added, forKey: "kasper.font.family")
+                }
+                reload()
+            })
+        }))
+
+        let weightRows: KasperGroup = [
+            .sectionTitle(id: "weight-title", text: "ТОЛЩИНА"),
+            .choice(id: "weight-thin", title: "Тоньше", selected: shift < 0, action: {
+                defaults.set(-1, forKey: "kasper.font.weightShift")
+                reload()
+            }),
+            .choice(id: "weight-normal", title: "Обычная", selected: shift == 0, action: {
+                defaults.set(0, forKey: "kasper.font.weightShift")
+                reload()
+            }),
+            .choice(id: "weight-bold", title: "Жирнее", selected: shift > 0, action: {
+                defaults.set(1, forKey: "kasper.font.weightShift")
+                reload()
+            })
+        ]
+
+        var groups: [KasperGroup] = [fontRows, weightRows]
+        if family != appliedFamily || shift != appliedShift {
+            groups.insert([
+                .text(id: "font-restart", text: "Шрифт сменится после перезапуска Kasper: закройте его в переключателе приложений и откройте снова. Так весь интерфейс сразу будет в одном шрифте.")
+            ], at: 0)
+        }
+        groups.append([
+            .sectionTitle(id: "preview-title", text: "ПРЕДПРОСМОТР (ТЕКУЩИЙ ШРИФТ)"),
+            .detail(id: "preview", title: "Съешь же ещё этих мягких французских булок", text: "Да выпей чаю. Kasper 0123456789", copy: nil),
+            .link(id: "font-size", title: "Размер текста", subtitle: "Размер текста в чатах настраивается в «Темы и цвета»", symbol: "textformat.size", badge: nil, action: {
+                navigation.push(themeSettingsController(context: context))
+            }),
+            .text(id: "font-na", text: "Недоступно: межстрочный интервал и отдельный шрифт только для чатов — Telegram размечает текст в чатах своим кодом, и шрифт в нём берётся из того же общего места, что и во всём приложении.")
+        ])
+        return groups
+    }
+    return kasperListController(context: context, title: "Шрифты", navigation: navigation, groups: groups)
+}
+
+// MARK: - Радио
+
+func kasperRadioController(context: AccountContext) -> ViewController {
+    let navigation = KasperNavigation()
+    let radio = KasperRadio.shared
+    let query = ValuePromise<String>("", ignoreRepeated: true)
+    let stations = Promise<[KasperRadioStation]?>(nil)
+
+    let searchDisposable = MetaDisposable()
+    let loadStations: (String) -> Void = { text in
+        stations.set(.single(nil))
+        let country: String? = text.trimmingCharacters(in: .whitespaces).isEmpty ? "RU" : nil
+        searchDisposable.set((KasperRadio.stations(query: text, countryCode: country)
+        |> deliverOnMainQueue).start(next: { list in
+            stations.set(.single(list))
+        }))
+    }
+    loadStations("")
+
+    let stationRow: (String, KasperRadioStation) -> KasperRow = { prefix, station in
+        let playing = radio.current?.id == station.id
+        var subtitle = [station.country, station.tags.split(separator: ",").prefix(3).joined(separator: ", ")].filter({ !$0.isEmpty }).joined(separator: " · ")
+        if playing {
+            subtitle = radio.isPlaying ? "▶︎ Играет" : "⏸ На паузе"
+        }
+        return .link(id: "\(prefix)-\(station.id)", title: station.name, subtitle: subtitle.isEmpty ? nil : subtitle, symbol: playing ? "speaker.wave.2.fill" : "dot.radiowaves.left.and.right", badge: radio.isFavorite(station) ? "★" : nil, action: {
+            if radio.current?.id == station.id {
+                radio.togglePause()
+            } else {
+                radio.play(station)
+            }
+        })
+    }
+
+    let groups = combineLatest(kasperNotifications(KasperRadio.changedNotification), query.get(), stations.get())
+    |> map { _, text, list -> [KasperGroup] in
+        var groups: [KasperGroup] = []
+        if let current = radio.current {
+            var nowPlaying: KasperGroup = [
+                .sectionTitle(id: "now-title", text: "СЕЙЧАС ИГРАЕТ"),
+                .detail(id: "now", title: current.name, text: radio.isLoading ? "Подключаюсь к станции…" : (radio.isPlaying ? "Играет" : "На паузе"), copy: nil),
+                .action(id: "now-toggle", title: radio.isPlaying ? "Пауза" : "Продолжить", destructive: false, action: {
+                    radio.togglePause()
+                }),
+                .action(id: "now-favorite", title: radio.isFavorite(current) ? "Убрать из избранного" : "В избранное ★", destructive: false, action: {
+                    radio.toggleFavorite(current)
+                }),
+                .action(id: "now-stop", title: "Выключить радио", destructive: true, action: {
+                    radio.stop()
+                })
+            ]
+            if let error = radio.lastError {
+                nowPlaying.append(.text(id: "now-error", text: error))
+            }
+            groups.append(nowPlaying)
+        } else if let error = radio.lastError {
+            groups.append([.text(id: "radio-error", text: error)])
+        }
+
+        let volume = radio.volume
+        var volumeRows: KasperGroup = [.sectionTitle(id: "volume-title", text: "ГРОМКОСТЬ")]
+        for (label, level) in [("25%", Float(0.25)), ("50%", Float(0.5)), ("75%", Float(0.75)), ("100%", Float(1.0))] {
+            volumeRows.append(.choice(id: "volume-\(label)", title: label, selected: abs(volume - level) < 0.05, action: {
+                radio.volume = level
+            }))
+        }
+        volumeRows.append(.toggle(id: "background", title: "Играть в фоне", value: radio.playInBackground, enabled: true, set: { value in
+            radio.playInBackground = value
+        }))
+        groups.append(volumeRows)
+
+        let favorites = radio.favorites
+        if !favorites.isEmpty {
+            var favoriteRows: KasperGroup = [.sectionTitle(id: "fav-title", text: "ИЗБРАННОЕ")]
+            for station in favorites {
+                favoriteRows.append(stationRow("fav", station))
+            }
+            groups.append(favoriteRows)
+        }
+
+        groups.append([
+            .input(id: "radio-search", title: "🔍", placeholder: "Найти станцию по названию", value: text, set: { value in
+                query.set(value)
+                loadStations(value)
+            })
+        ])
+        if let list = list {
+            if list.isEmpty {
+                groups.append([.text(id: "radio-empty", text: "Ничего не нашлось. Попробуйте другое название.")])
+            } else {
+                let title = text.trimmingCharacters(in: .whitespaces).isEmpty ? "ПОПУЛЯРНЫЕ В РОССИИ" : "НАЙДЕНО"
+                var listRows: KasperGroup = [.sectionTitle(id: "list-title", text: title)]
+                for station in list {
+                    listRows.append(stationRow("list", station))
+                }
+                groups.append(listRows)
+            }
+        } else {
+            groups.append([.text(id: "radio-loading", text: "Загружаю станции…")])
+        }
+
+        let history = radio.history
+        if !history.isEmpty {
+            var historyRows: KasperGroup = [.sectionTitle(id: "history-title", text: "НЕДАВНО СЛУШАЛИ")]
+            for station in history.prefix(10) {
+                historyRows.append(stationRow("history", station))
+            }
+            historyRows.append(.action(id: "history-clear", title: "Очистить историю", destructive: true, action: {
+                radio.clearHistory()
+            }))
+            groups.append(historyRows)
+        }
+        groups.append([.text(id: "radio-footer", text: "Станции из открытого каталога radio-browser.info. Нажмите на станцию, чтобы включить, ещё раз — пауза. Радио играет и когда вы в чатах; если в Kasper запустить голосовое или видео, радио приглушится.")])
+        return groups
+    }
+    return kasperListController(context: context, title: "Радио", navigation: navigation, groups: groups)
+}
