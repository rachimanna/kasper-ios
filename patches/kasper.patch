 }
 
 func openExternalUrlImpl(context: AccountContext, urlContext: OpenURLContext, url: String, forceExternal: Bool, presentationData: PresentationData, navigationController: NavigationController?, dismissInput: @escaping () -> Void) {
+    // Kasper: перед открытием ссылки спрашиваем VirusTotal (раздел VirusTotal → «Проверять ссылки»).
+    // Если отчёта нет или VirusTotal не ответил за 6 секунд — открываем как обычно.
+    if KasperVirusTotal.shouldAutoCheck(url) {
+        let reopen: () -> Void = {
+            KasperVirusTotal.approveOnce(url)
+            openExternalUrlImpl(context: context, urlContext: urlContext, url: url, forceExternal: forceExternal, presentationData: presentationData, navigationController: navigationController, dismissInput: dismissInput)
+        }
+        let lookup = KasperVirusTotal.lookupUrl(url, apiKey: KasperSettings.virusTotalKey)
+        |> map(Optional.init)
+        |> `catch` { _ -> Signal<KasperVirusTotalReport?, NoError> in
+            return .single(nil)
+        }
+        |> timeout(6.0, queue: Queue.mainQueue(), alternate: .single(nil))
+        let _ = (lookup
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { report in
+            guard let report = report, report.isDangerous else {
+                reopen()
+                return
