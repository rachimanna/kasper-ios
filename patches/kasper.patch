+func kasperPluginsController(context: AccountContext) -> ViewController {
+    let navigation = KasperNavigation()
+    let manager = KasperPluginManager.shared
+    let code = ValuePromise<String>("", ignoreRepeated: true)
+    var codeValue = ""
+
+    let install: (String) -> Void = { text in
+        do {
+            let plugin = try manager.install(code: text)
+            code.set("")
+            codeValue = ""
+            kasperAlert(context, navigation, title: "Плагин установлен", text: "«\(plugin.name)» \(plugin.version) от \(plugin.author). Разрешения можно проверить на его странице.")
+        } catch let error as KasperPluginError {
+            kasperAlert(context, navigation, title: "Не удалось установить", text: error.text)
+        } catch {
+            kasperAlert(context, navigation, title: "Не удалось установить", text: error.localizedDescription)
+        }
+    }
+
+    let groups = combineLatest(kasperNotifications(KasperPluginManager.changedNotification), code.get())
+    |> map { _, text -> [KasperGroup] in
+        var groups: [KasperGroup] = [[
+            .text(id: "plugins-intro", text: "JS-плагины расширяют Kasper без пересборки. Каждый плагин выполняется в отдельной изолированной среде JavaScriptCore: он не видит ваши чаты, файлы, сеть и другие плагины — только объект kasper и только то, что вы разрешили.")
+        ]]
+        let plugins = manager.plugins
+        if !plugins.isEmpty {
+            var rows: KasperGroup = [.sectionTitle(id: "plugins-title", text: "УСТАНОВЛЕННЫЕ")]
+            for plugin in plugins {
+                rows.append(.link(id: "plugin-\(plugin.id)", title: plugin.name, subtitle: "\(plugin.version) · \(plugin.author)\(plugin.enabled ? "" : " · выключен")", symbol: "puzzlepiece.extension.fill", badge: nil, action: {
+                    navigation.push(kasperPluginController(context: context, id: plugin.id))
+                }))
+            }
+            groups.append(rows)
+        }
+        groups.append([
+            .sectionTitle(id: "install-title", text: "УСТАНОВИТЬ"),
+            .input(id: "plugin-code", title: "JS", placeholder: "Вставьте код плагина", value: text, set: { value in
+                codeValue = value
+                code.set(value)
+            }),
+            .action(id: "plugin-install", title: "Установить из вставленного кода", destructive: false, action: {
+                install(codeValue)
+            }),
+            .action(id: "plugin-file", title: "Установить из файла .js…", destructive: false, action: {
+                kasperPickFile(context, navigation, types: ["com.netscape.javascript-source", "public.plain-text", "public.item"], completion: { url in
+                    guard let data = try? Data(contentsOf: url), let source = String(data: data, encoding: .utf8) else {
+                        kasperAlert(context, navigation, title: nil, text: "Не удалось прочитать файл.")
+                        return
+                    }
+                    install(source)
+                })
+            }),
+            .action(id: "plugin-sample", title: "Установить пример плагина", destructive: false, action: {
+                install(KasperPluginManager.sampleCode)
+            }),
+            .text(id: "plugin-format", text: "Формат: в начале кода строки «// @name Название», «// @version 1.0», «// @author Автор», «// @description Что делает», «// @permissions storage, notify, stars». Точка входа — function main().\n\nAPI: kasper.log(текст), kasper.version, kasper.storage.get(ключ) / set(ключ, значение), kasper.notify(текст), kasper.stars.get() / add(число).")
+        ])
+        return groups
+    }
+    return kasperListController(context: context, title: "Плагины", navigation: navigation, groups: groups)
+}
+
+func kasperPluginController(context: AccountContext, id: String) -> ViewController {
+    let navigation = KasperNavigation()
+    let manager = KasperPluginManager.shared
+
+    let groups = kasperNotifications(KasperPluginManager.changedNotification)
+    |> map { _ -> [KasperGroup] in
+        guard let plugin = manager.plugin(id: id) else {
+            return [[.text(id: "plugin-removed", text: "Плагин удалён.")]]
+        }
+        var groups: [KasperGroup] = [
+            [
+                .info(id: "p-version", title: "Версия", value: plugin.version, copy: nil),
+                .info(id: "p-author", title: "Автор", value: plugin.author, copy: nil),
+                .text(id: "p-summary", text: plugin.summary.isEmpty ? "Автор не добавил описание." : plugin.summary)
+            ],
+            [
+                .toggle(id: "p-enabled", title: "Включён", value: plugin.enabled, enabled: true, set: { value in
+                    manager.setEnabled(id, value)
+                }),
+                .action(id: "p-run", title: "Запустить", destructive: false, action: {
+                    manager.run(id, notify: { title, text in
+                        kasperAlert(context, navigation, title: title, text: text)
+                    })
+                })
+            ]
+        ]
+        var permissionRows: KasperGroup = [.sectionTitle(id: "p-perm-title", text: "РАЗРЕШЕНИЯ")]
+        for permission in KasperPluginPermission.allCases {
+            permissionRows.append(.toggle(id: "p-perm-\(permission.rawValue)", title: permission.title, value: plugin.permissions.contains(permission.rawValue), enabled: true, set: { value in
+                manager.setPermission(id, permission, granted: value)
+            }))
+        }
+        permissionRows.append(.text(id: "p-perm-footer", text: "Плагин запрашивает разрешения в своём коде, но решаете вы: без разрешения соответствующая функция kasper просто не сработает и напишет об этом в лог."))
+        groups.append(permissionRows)
+
+        let storage = manager.storage(id)
+        if !storage.isEmpty {
+            var storageRows: KasperGroup = [.sectionTitle(id: "p-storage-title", text: "ДАННЫЕ ПЛАГИНА")]
+            for key in storage.keys.sorted().prefix(30) {
+                storageRows.append(.info(id: "p-storage-\(key)", title: key, value: storage[key] ?? "", copy: storage[key]))
+            }
+            groups.append(storageRows)
+        }
+
+        let log = manager.log(id)
+        var logRows: KasperGroup = [.sectionTitle(id: "p-log-title", text: "ЛОГ")]
+        if log.isEmpty {
+            logRows.append(.text(id: "p-log-empty", text: "Пока пусто. Сюда попадают kasper.log(), ошибки и отказы в разрешениях."))
+        } else {
+            logRows.append(.detail(id: "p-log", title: "Последние записи", text: log.suffix(30).joined(separator: "\n"), copy: log.joined(separator: "\n")))
+            logRows.append(.action(id: "p-log-clear", title: "Очистить лог", destructive: false, action: {
+                manager.clearLog(id)
+            }))
+        }
+        groups.append(logRows)
+
+        groups.append([
+            .action(id: "p-remove", title: "Удалить плагин", destructive: true, action: {
+                manager.remove(id)
+            })
+        ])
+        return groups
+    }
+    return kasperListController(context: context, title: "Плагин", navigation: navigation, groups: groups)
+}
