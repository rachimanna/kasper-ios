+private func kasperConnectionText(_ status: ConnectionStatus) -> String {
+    switch status {
+    case .waitingForNetwork:
+        return "Ждёт сеть"
+    case let .connecting(proxy, issues):
+        if let proxy = proxy {
+            return issues ? "Подключение через прокси \(proxy) — есть проблемы" : "Подключение через прокси \(proxy)"
+        }
+        return "Подключение…"
+    case let .updating(proxy):
+        return proxy.map { "Обновление через прокси \($0)" } ?? "Обновление…"
+    case let .online(proxy):
+        return proxy.map { "В сети через прокси \($0)" } ?? "В сети напрямую"
+    }
+}
