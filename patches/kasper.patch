+// MARK: - Строки списка
+
+private enum KasperSettingsSection: Int32 {
+    case ghost
+    case interface
+    case voice
+    case deleted
+    case nickname
+    case profile
+    case about
+}
+
+private enum KasperSettingsEntry: ItemListNodeEntry {
+    case ghostSection(KasperSettingsState)
+    case ghostFooter
+
+    case interfaceSection(KasperSettingsState)
+    case interfaceFooter
+
+    case voiceSection(KasperSettingsState)
+    case voiceRealistic(Bool)
+    case voiceKey(String)
+    case voiceStatus(String)
+    case voiceReload
+    case voiceCalls(Bool)
+    case voiceFooter(String)
+
+    case deletedSection(KasperSettingsState)
+    case deletedCount(Int)
+    case deletedFooter
+
+    case nicknameInput(String)
+    case nicknameFooter
+
+    case profileFooter
+
+    case about
+
+    var section: ItemListSectionId {
+        switch self {
+        case .ghostSection, .ghostFooter:
+            return KasperSettingsSection.ghost.rawValue
+        case .interfaceSection, .interfaceFooter:
+            return KasperSettingsSection.interface.rawValue
+        case .voiceSection, .voiceRealistic, .voiceKey, .voiceStatus, .voiceReload, .voiceCalls, .voiceFooter:
+            return KasperSettingsSection.voice.rawValue
+        case .deletedSection, .deletedCount, .deletedFooter:
