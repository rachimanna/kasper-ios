+                navigation.present(textAlertController(context: context, title: "Обновлений нет", text: "У вас последняя сборка Kasper: \(KasperAbout.versionString).", actions: [ok]))
+            case let .available(build, url):
+                navigation.present(textAlertController(context: context, title: "Есть новая сборка", text: "Доступна сборка \(build), у вас \(KasperAbout.buildNumber). Скачайте Kasper.ipa и установите поверх — настройки сохранятся.", actions: [
+                    TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+                    TextAlertAction(type: .defaultAction, title: "Открыть", action: {
+                        openUrl(url)
+                    })
+                ]))
+            case let .failed(reason):
+                navigation.present(textAlertController(context: context, title: "Не удалось проверить", text: reason, actions: [ok]))
+            }
+        }))
+    }
+
+    let groups = checking.get()
+    |> map { isChecking -> [KasperGroup] in
+        return [
+            [.header(title: "Kasper", version: KasperAbout.versionString)],
+            [
+                .info(id: "version", title: "Версия", value: KasperAbout.shortVersion, copy: KasperAbout.versionString),
+                .info(id: "build", title: "Сборка", value: KasperAbout.buildNumber, copy: KasperAbout.buildNumber),
+                .info(id: "base", title: "Основа", value: "Telegram-iOS \(KasperAbout.shortVersion)", copy: nil),
+                .link(id: "update", title: isChecking ? "Проверяю…" : "Проверить обновления", subtitle: "Сравнить с последней сборкой на GitHub", symbol: "arrow.triangle.2.circlepath", badge: nil, action: {
+                    if !isChecking {
+                        checkUpdates()
+                    }
+                })
+            ],
+            [
+                .link(id: "source", title: "Исходный код", subtitle: "github.com/rachimanna/kasper-ios", symbol: "chevron.left.forwardslash.chevron.right", badge: nil, action: {
+                    openUrl(KasperAbout.repository)
+                }),
+                .link(id: "releases", title: "Все сборки", subtitle: "Скачать Kasper.ipa", symbol: "shippingbox.fill", badge: nil, action: {
+                    openUrl(KasperAbout.repository + "/releases")
+                }),
+                .link(id: "license", title: "Лицензия", subtitle: "GPL v2 — как у Telegram-iOS, на котором основан Kasper", symbol: "doc.text.fill", badge: nil, action: {
+                    openUrl("https://github.com/TelegramMessenger/Telegram-iOS/blob/master/LICENSE")
+                })
+            ],
+            [
+                .info(id: "developer", title: "Разработчик", value: "rachimanna", copy: nil),
+                .text(id: "about-footer", text: "Kasper — неофициальный клиент на открытом коде Telegram, для личного использования. Работает через официальный API Telegram и не связан с Telegram FZ-LLC. Настройки Kasper хранятся только на этом устройстве.")
