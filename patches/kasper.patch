@@ -0,0 +1,205 @@
+import Foundation
+import UIKit
+
+/// Kasper: визуальные подарки — локальные анимации поверх чата.
+/// Не отправляются на сервер, видны только отправителю.
+public final class KasperGiftAnimation {
+    public enum GiftType: String, CaseIterable {
+        case heart
+        case star
+        case fire
+        case diamond
+        case crown
+        case rocket
+        case confetti
+        case nft
+
+        public var emoji: String {
+            switch self {
+            case .heart: return "❤️"
+            case .star: return "⭐"
+            case .fire: return "🔥"
+            case .diamond: return "💎"
+            case .crown: return "👑"
+            case .rocket: return "🚀"
+            case .confetti: return "🎉"
+            case .nft: return "🖼"
+            }
+        }
+
+        public var title: String {
+            switch self {
+            case .heart: return "Сердце"
+            case .star: return "Звезда"
+            case .fire: return "Огонь"
+            case .diamond: return "Алмаз"
+            case .crown: return "Корона"
+            case .rocket: return "Ракета"
+            case .confetti: return "Конфетти"
+            case .nft: return "NFT"
+            }
+        }
+    }
+
+    /// Показывает анимацию подарка поверх указанного view.
+    public static func play(_ type: GiftType, over view: UIView) {
+        let overlay = UIView(frame: view.bounds)
+        overlay.isUserInteractionEnabled = false
+        overlay.backgroundColor = .clear
+        view.addSubview(overlay)
+
+        switch type {
+        case .heart:
+            playHeartAnimation(in: overlay)
+        case .star:
+            playStarAnimation(in: overlay)
+        case .fire:
+            playFireAnimation(in: overlay)
+        case .confetti:
+            playConfettiAnimation(in: overlay)
+        default:
+            playGenericEmojiAnimation(type.emoji, in: overlay)
+        }
+
+        DispatchQueue.main.asyncAfter(deadline: .now() + 3.0) {
+            UIView.animate(withDuration: 0.5, animations: {
+                overlay.alpha = 0.0
+            }, completion: { _ in
+                overlay.removeFromSuperview()
+            })
+        }
+    }
+
+    private static func playHeartAnimation(in container: UIView) {
+        let count = 12
+        for i in 0 ..< count {
+            let label = UILabel()
+            label.text = "❤️"
+            label.font = .systemFont(ofSize: CGFloat.random(in: 24...48))
+            label.sizeToFit()
+            let startX = CGFloat.random(in: 0...container.bounds.width)
+            label.center = CGPoint(x: startX, y: container.bounds.height + 20)
+            container.addSubview(label)
+
+            let delay = Double(i) * 0.15
+            UIView.animate(withDuration: 2.0, delay: delay, options: .curveEaseOut, animations: {
+                label.center = CGPoint(
+                    x: startX + CGFloat.random(in: -60...60),
+                    y: CGFloat.random(in: -50...container.bounds.height * 0.3)
+                )
+                label.alpha = 0.0
+                label.transform = CGAffineTransform(scaleX: 1.5, y: 1.5).rotated(by: CGFloat.random(in: -0.5...0.5))
+            }, completion: { _ in
+                label.removeFromSuperview()
+            })
+        }
+    }
+
+    private static func playStarAnimation(in container: UIView) {
+        let count = 15
+        let center = CGPoint(x: container.bounds.midX, y: container.bounds.midY)
+        for i in 0 ..< count {
+            let label = UILabel()
+            label.text = ["⭐", "🌟", "✨"].randomElement()!
+            label.font = .systemFont(ofSize: CGFloat.random(in: 20...40))
+            label.sizeToFit()
+            label.center = center
+            label.alpha = 0.0
+            container.addSubview(label)
+
+            let angle = CGFloat.random(in: 0...(2 * .pi))
+            let radius = CGFloat.random(in: 80...200)
+            let delay = Double(i) * 0.1
+
+            UIView.animate(withDuration: 1.5, delay: delay, options: .curveEaseOut, animations: {
+                label.center = CGPoint(
+                    x: center.x + cos(angle) * radius,
+                    y: center.y + sin(angle) * radius
+                )
+                label.alpha = 1.0
+                label.transform = CGAffineTransform(scaleX: 1.3, y: 1.3)
+            }, completion: { _ in
+                UIView.animate(withDuration: 0.5, animations: {
+                    label.alpha = 0.0
+                }, completion: { _ in
+                    label.removeFromSuperview()
+                })
+            })
+        }
+    }
+
+    private static func playFireAnimation(in container: UIView) {
+        let count = 20
+        for i in 0 ..< count {
+            let label = UILabel()
+            label.text = ["🔥", "🧡", "💛"].randomElement()!
+            label.font = .systemFont(ofSize: CGFloat.random(in: 20...36))
+            label.sizeToFit()
+            let startX = container.bounds.midX + CGFloat.random(in: -40...40)
+            label.center = CGPoint(x: startX, y: container.bounds.height - 20)
+            label.alpha = 0.8
+            container.addSubview(label)
+
+            let delay = Double(i) * 0.08
+            UIView.animate(withDuration: 1.5, delay: delay, options: .curveEaseIn, animations: {
+                label.center = CGPoint(
+                    x: startX + CGFloat.random(in: -30...30),
+                    y: container.bounds.midY - CGFloat.random(in: 50...150)
+                )
+                label.alpha = 0.0
+                label.transform = CGAffineTransform(scaleX: 0.5, y: 0.5)
+            }, completion: { _ in
+                label.removeFromSuperview()
+            })
+        }
+    }
+
+    private static func playConfettiAnimation(in container: UIView) {
+        let emojis = ["🎉", "🎊", "✨", "🌈", "🎈", "💫", "🎀", "🎁"]
+        let count = 25
+        for i in 0 ..< count {
+            let label = UILabel()
+            label.text = emojis.randomElement()!
+            label.font = .systemFont(ofSize: CGFloat.random(in: 16...32))
+            label.sizeToFit()
+            let startX = CGFloat.random(in: 0...container.bounds.width)
+            label.center = CGPoint(x: startX, y: -20)
+            label.alpha = 1.0
+            container.addSubview(label)
+
+            let delay = Double(i) * 0.06
+            UIView.animate(withDuration: 2.5, delay: delay, options: .curveEaseIn, animations: {
+                label.center = CGPoint(
+                    x: startX + CGFloat.random(in: -80...80),
+                    y: container.bounds.height + 20
+                )
+                label.transform = CGAffineTransform(rotationAngle: CGFloat.random(in: -3...3))
+            }, completion: { _ in
+                label.removeFromSuperview()
+            })
+        }
+    }
+
+    private static func playGenericEmojiAnimation(_ emoji: String, in container: UIView) {
+        let label = UILabel()
+        label.text = emoji
+        label.font = .systemFont(ofSize: 80)
+        label.sizeToFit()
+        label.center = CGPoint(x: container.bounds.midX, y: container.bounds.midY)
+        label.alpha = 0.0
+        label.transform = CGAffineTransform(scaleX: 0.3, y: 0.3)
+        container.addSubview(label)
+
+        UIView.animate(withDuration: 0.6, delay: 0, usingSpringWithDamping: 0.5, initialSpringVelocity: 0.8, options: [], animations: {
+            label.alpha = 1.0
+            label.transform = .identity
+        }, completion: { _ in
+            UIView.animate(withDuration: 1.0, delay: 1.0, options: .curveEaseIn, animations: {
+                label.alpha = 0.0
+                label.transform = CGAffineTransform(scaleX: 2.0, y: 2.0)
+            }, completion: { _ in
+                label.removeFromSuperview()
+            })
+        })
+    }
+}
