+++ b/submodules/SettingsUI/Sources/Kasper/KasperPlugins.swift
@@ -0,0 +1,347 @@
+import Foundation
+import JavaScriptCore
+import TelegramCore
+
+/// JS-плагин Kasper. Заголовок плагина — комментарии в начале кода:
+///
+///     // @name Мой плагин
+///     // @version 1.0
+///     // @author Имя
+///     // @description Что делает плагин
+///     // @permissions storage, notify, stars
+///
+/// Точка входа — функция `main()`. Код выполняется в отдельном JavaScriptCore без доступа
+/// к чатам, файлам и сети: плагин видит только объект `kasper` и только разрешённые части.
+struct KasperPlugin: Codable, Equatable {
+    let id: String
+    var name: String
+    var version: String
+    var author: String
+    var summary: String
+    var permissions: [String]
+    var code: String
+    var enabled: Bool
+    var installed: Double
+}
+
+enum KasperPluginPermission: String, CaseIterable {
+    case storage
+    case notify
+    case stars
+
+    var title: String {
+        switch self {
+        case .storage:
+            return "Хранить свои данные"
+        case .notify:
+            return "Показывать сообщения"
+        case .stars:
+            return "Менять локальные звёзды"
+        }
+    }
+}
+
+enum KasperPluginError: Error {
+    case noName
+    case tooLarge
+
+    var text: String {
+        switch self {
+        case .noName:
+            return "В начале кода нет строки «// @name Название плагина»."
+        case .tooLarge:
+            return "Плагин больше 200 КБ — это слишком много для Kasper."
+        }
+    }
+}
+
+final class KasperPluginManager {
+    static let shared = KasperPluginManager()
+    static let changedNotification = Notification.Name("kasper.plugins.changed")
+
+    private let lock = NSLock()
+    private let queue = DispatchQueue(label: "org.kasper.plugins")
+    private var logs: [String: [String]] = [:]
+
+    private var fileUrl: URL? {
+        guard let directory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+            return nil
+        }
+        let folder = directory.appendingPathComponent("Kasper", isDirectory: true)
+        try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true, attributes: nil)
+        return folder.appendingPathComponent("plugins.json")
+    }
+
+    // MARK: Список
+
+    var plugins: [KasperPlugin] {
+        self.lock.lock()
+        defer {
+            self.lock.unlock()
+        }
+        guard let url = self.fileUrl, let data = try? Data(contentsOf: url), let list = try? JSONDecoder().decode([KasperPlugin].self, from: data) else {
+            return []
+        }
+        return list
+    }
+
+    private func save(_ list: [KasperPlugin]) {
+        self.lock.lock()
+        if let url = self.fileUrl, let data = try? JSONEncoder().encode(list) {
+            try? data.write(to: url, options: .atomic)
+        }
+        self.lock.unlock()
+        DispatchQueue.main.async {
+            NotificationCenter.default.post(name: KasperPluginManager.changedNotification, object: nil)
+        }
+    }
+
+    func plugin(id: String) -> KasperPlugin? {
+        return self.plugins.first(where: { $0.id == id })
+    }
+
+    /// Разбирает заголовок и устанавливает плагин. Плагин с тем же названием обновляется.
+    @discardableResult
+    func install(code: String) throws -> KasperPlugin {
+        guard code.utf8.count <= 200 * 1024 else {
+            throw KasperPluginError.tooLarge
+        }
+        var header: [String: String] = [:]
+        for line in code.components(separatedBy: .newlines).prefix(40) {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            guard trimmed.hasPrefix("//") else {
+                continue
+            }
+            let body = trimmed.dropFirst(2).trimmingCharacters(in: .whitespaces)
+            guard body.hasPrefix("@") else {
+                continue
+            }
+            let parts = body.dropFirst().split(separator: " ", maxSplits: 1).map(String.init)
+            if parts.count == 2 {
+                header[parts[0].lowercased()] = parts[1].trimmingCharacters(in: .whitespaces)
+            }
+        }
+        guard let name = header["name"], !name.isEmpty else {
+            throw KasperPluginError.noName
+        }
+        let requested = (header["permissions"] ?? "")
+            .split(whereSeparator: { $0 == "," || $0 == " " })
+            .map { String($0).lowercased() }
+            .filter { KasperPluginPermission(rawValue: $0) != nil }
+        var list = self.plugins
+        let existing = list.firstIndex(where: { $0.name == name })
+        let plugin = KasperPlugin(
+            id: existing.map { list[$0].id } ?? UUID().uuidString,
+            name: name,
+            version: header["version"] ?? "1.0",
+            author: header["author"] ?? "неизвестен",
+            summary: header["description"] ?? "",
+            permissions: requested,
+            code: code,
+            enabled: existing.map { list[$0].enabled } ?? true,
+            installed: Date().timeIntervalSince1970
+        )
+        if let existing = existing {
+            list[existing] = plugin
+        } else {
+            list.append(plugin)
+        }
+        self.save(list)
+        self.appendLog(plugin.id, "Установлен \(plugin.name) \(plugin.version)")
+        return plugin
+    }
+
+    func setEnabled(_ id: String, _ enabled: Bool) {
+        var list = self.plugins
+        if let index = list.firstIndex(where: { $0.id == id }) {
+            list[index].enabled = enabled
+            self.save(list)
+        }
+    }
+
+    /// Отозвать или вернуть разрешение: плагин получает только то, что вы оставили.
+    func setPermission(_ id: String, _ permission: KasperPluginPermission, granted: Bool) {
+        var list = self.plugins
+        guard let index = list.firstIndex(where: { $0.id == id }) else {
+            return
+        }
+        var permissions = list[index].permissions.filter { $0 != permission.rawValue }
+        if granted {
+            permissions.append(permission.rawValue)
+        }
+        list[index].permissions = permissions
+        self.save(list)
+    }
+
+    func remove(_ id: String) {
+        self.save(self.plugins.filter { $0.id != id })
+        UserDefaults.standard.removeObject(forKey: "kasper.plugin.storage.\(id)")
+        self.lock.lock()
+        self.logs[id] = nil
+        self.lock.unlock()
+    }
+
+    // MARK: Логи
+
+    func log(_ id: String) -> [String] {
+        self.lock.lock()
+        defer {
+            self.lock.unlock()
+        }
+        return self.logs[id] ?? []
+    }
+
+    func clearLog(_ id: String) {
+        self.lock.lock()
+        self.logs[id] = []
+        self.lock.unlock()
+        DispatchQueue.main.async {
+            NotificationCenter.default.post(name: KasperPluginManager.changedNotification, object: nil)
+        }
+    }
+
+    private func appendLog(_ id: String, _ line: String) {
+        let formatter = DateFormatter()
+        formatter.dateFormat = "HH:mm:ss"
+        self.lock.lock()
+        var list = self.logs[id] ?? []
+        list.append("\(formatter.string(from: Date()))  \(line)")
+        if list.count > 100 {
+            list.removeFirst(list.count - 100)
+        }
+        self.logs[id] = list
+        self.lock.unlock()
+        DispatchQueue.main.async {
+            NotificationCenter.default.post(name: KasperPluginManager.changedNotification, object: nil)
+        }
+    }
+
+    // MARK: Хранилище плагина
+
+    func storage(_ id: String) -> [String: String] {
+        return (UserDefaults.standard.dictionary(forKey: "kasper.plugin.storage.\(id)") as? [String: String]) ?? [:]
+    }
+
+    private func setStorage(_ id: String, key: String, value: String?) {
+        var dict = self.storage(id)
+        if let value = value {
+            dict[key] = String(value.prefix(10_000))
+        } else {
+            dict[key] = nil
+        }
+        if dict.count <= 200 {
+            UserDefaults.standard.set(dict, forKey: "kasper.plugin.storage.\(id)")
+        }
+    }
+
+    // MARK: Запуск
+
+    /// Выполняет `main()` плагина в новой изолированной среде JavaScriptCore.
+    /// `notify` показывает сообщение плагина пользователю.
+    func run(_ id: String, notify: @escaping (String, String) -> Void) {
+        guard let plugin = self.plugin(id: id) else {
+            return
+        }
+        guard plugin.enabled else {
+            self.appendLog(id, "Плагин выключен — запуск отменён")
+            return
+        }
+        self.queue.async { [weak self] in
+            guard let self = self else {
+                return
+            }
+            // Отдельная виртуальная машина: плагины не видят друг друга и сам Kasper
+            guard let context = JSContext(virtualMachine: JSVirtualMachine()) else {
+                self.appendLog(id, "Не удалось создать среду JavaScriptCore")
+                return
+            }
+            context.exceptionHandler = { [weak self] _, exception in
+                self?.appendLog(id, "Ошибка: \(exception?.toString() ?? "неизвестная")")
+            }
+            let permissions = Set(plugin.permissions)
+            let api = JSValue(newObjectIn: context)
+
+            let log: @convention(block) (String) -> Void = { [weak self] text in
+                self?.appendLog(id, String(text.prefix(500)))
+            }
+            api?.setObject(log, forKeyedSubscript: "log" as NSString)
+            api?.setObject("Kasper \(KasperAbout.versionString)", forKeyedSubscript: "version" as NSString)
+
+            let storage = JSValue(newObjectIn: context)
+            let storageGet: @convention(block) (String) -> String? = { [weak self] key in
+                guard permissions.contains(KasperPluginPermission.storage.rawValue) else {
+                    self?.appendLog(id, "Нет разрешения «\(KasperPluginPermission.storage.title)»")
+                    return nil
+                }
+                return self?.storage(id)[key]
+            }
+            let storageSet: @convention(block) (String, String?) -> Void = { [weak self] key, value in
+                guard permissions.contains(KasperPluginPermission.storage.rawValue) else {
+                    self?.appendLog(id, "Нет разрешения «\(KasperPluginPermission.storage.title)»")
+                    return
+                }
+                self?.setStorage(id, key: key, value: value)
+            }
+            storage?.setObject(storageGet, forKeyedSubscript: "get" as NSString)
+            storage?.setObject(storageSet, forKeyedSubscript: "set" as NSString)
+            api?.setObject(storage, forKeyedSubscript: "storage" as NSString)
+
+            let show: @convention(block) (String) -> Void = { [weak self] text in
+                guard permissions.contains(KasperPluginPermission.notify.rawValue) else {
+                    self?.appendLog(id, "Нет разрешения «\(KasperPluginPermission.notify.title)»")
+                    return
+                }
+                let message = String(text.prefix(1000))
+                DispatchQueue.main.async {
+                    notify(plugin.name, message)
+                }
+            }
+            api?.setObject(show, forKeyedSubscript: "notify" as NSString)
+
+            let stars = JSValue(newObjectIn: context)
+            let starsGet: @convention(block) () -> Int = {
+                return KasperSettings.localStars
+            }
+            let starsAdd: @convention(block) (Int) -> Int = { [weak self] delta in
+                guard permissions.contains(KasperPluginPermission.stars.rawValue) else {
+                    self?.appendLog(id, "Нет разрешения «\(KasperPluginPermission.stars.title)»")
+                    return KasperSettings.localStars
+                }
+                let value = KasperSettings.localStars + max(-1_000_000, min(1_000_000, delta))
+                DispatchQueue.main.async {
+                    KasperSettings.localStars = value
+                }
+                return max(0, value)
+            }
+            stars?.setObject(starsGet, forKeyedSubscript: "get" as NSString)
+            stars?.setObject(starsAdd, forKeyedSubscript: "add" as NSString)
+            api?.setObject(stars, forKeyedSubscript: "stars" as NSString)
+
+            context.setObject(api, forKeyedSubscript: "kasper" as NSString)
+            context.evaluateScript(plugin.code)
+            if let main = context.objectForKeyedSubscript("main"), !main.isUndefined {
+                main.call(withArguments: [])
+                self.appendLog(id, "main() выполнена")
+            } else {
+                self.appendLog(id, "В плагине нет функции main()")
+            }
+        }
+    }
+
+    /// Пример плагина, чтобы было с чего начать.
+    static let sampleCode = """
+    // @name Счётчик запусков
+    // @version 1.0
+    // @author Kasper
+    // @description Считает запуски и дарит 10 локальных звёзд
+    // @permissions storage, notify, stars
+
+    function main() {
+        var count = parseInt(kasper.storage.get("count") || "0") + 1;
+        kasper.storage.set("count", String(count));
+        var balance = kasper.stars.add(10);
+        kasper.log("Запуск номер " + count);
+        kasper.notify("Это запуск номер " + count + ". Локальных звёзд: " + balance);
+    }
+    """
+}
