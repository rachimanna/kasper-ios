+/// Монохромная иконка раздела, как в оболочке: белый символ без цветной подложки.
+func kasperSectionIcon(_ symbol: String, color: UIColor) -> UIImage? {
+    if symbol == "kasper.logo" {
+        return kasperLogoImage(size: 24.0, color: color)
+    }
+    let configuration = UIImage.SymbolConfiguration(pointSize: 19.0, weight: .medium)
+    guard let image = UIImage(systemName: symbol, withConfiguration: configuration) else {
+        return nil
+    }
+    // Все иконки в одну рамку 28×28, чтобы названия стояли ровной колонкой.
+    let box = CGSize(width: 28.0, height: 28.0)
+    let renderer = UIGraphicsImageRenderer(size: box)
+    return renderer.image { _ in
+        let tinted = image.withTintColor(color, renderingMode: .alwaysOriginal)
+        let fit = min(box.width / tinted.size.width, box.height / tinted.size.height, 1.0)
+        let drawSize = CGSize(width: tinted.size.width * fit, height: tinted.size.height * fit)
+        tinted.draw(in: CGRect(x: (box.width - drawSize.width) / 2.0, y: (box.height - drawSize.height) / 2.0, width: drawSize.width, height: drawSize.height))
+    }
+}
+
+/// Цвет подложки для стиля «Цветные подложки» — как у разделов настроек iOS.
+private func kasperIconBackground(_ symbol: String) -> UIColor {
+    switch symbol {
+    case "magnifyingglass", "list.bullet", "info.circle.fill", "person.fill":
+        return UIColor(red: 0.56, green: 0.56, blue: 0.58, alpha: 1.0)
+    case "paintbrush.pointed.fill", "paintpalette.fill", "textformat", "square.grid.2x2.fill":
+        return UIColor(red: 0.20, green: 0.47, blue: 0.96, alpha: 1.0)
+    case "bell.fill", "bell.slash.fill", "heart.fill":
+        return UIColor(red: 1.0, green: 0.23, blue: 0.19, alpha: 1.0)
+    case "drop.fill", "globe", "network.badge.shield.half.filled", "server.rack", "antenna.radiowaves.left.and.right", "arrow.up.arrow.down":
+        return UIColor(red: 0.18, green: 0.69, blue: 0.93, alpha: 1.0)
+    case "bubble.left.fill", "clock.arrow.circlepath", "internaldrive.fill":
+        return UIColor(red: 0.20, green: 0.78, blue: 0.35, alpha: 1.0)
+    case "camera.fill", "photo.on.rectangle", "slider.horizontal.3", "bolt.fill":
+        return UIColor(red: 1.0, green: 0.58, blue: 0.0, alpha: 1.0)
+    case "eye.slash.fill", "lock.fill", "hand.raised.fill", "faceid", "archivebox.fill", "checkmark.shield.fill":
+        return UIColor(red: 0.35, green: 0.34, blue: 0.84, alpha: 1.0)
+    case "star.fill":
+        return UIColor(red: 1.0, green: 0.80, blue: 0.0, alpha: 1.0)
+    case "waveform.badge.mic", "music.note", "dot.radiowaves.left.and.right":
+        return UIColor(red: 1.0, green: 0.18, blue: 0.33, alpha: 1.0)
+    case "puzzlepiece.extension.fill", "square.grid.3x1.below.line.grid.1x2", "eye.trianglebadge.exclamationmark.fill":
+        return UIColor(red: 0.69, green: 0.32, blue: 0.87, alpha: 1.0)
+    case "kasper.logo":
+        return UIColor.black
+    default:
+        return UIColor(red: 0.45, green: 0.45, blue: 0.50, alpha: 1.0)
+    }
+}
+
+/// Иконка на цветной скруглённой подложке с белым символом внутри.
+func kasperColoredSectionIcon(_ symbol: String) -> UIImage? {
+    let box = CGSize(width: 29.0, height: 29.0)
+    let renderer = UIGraphicsImageRenderer(size: box)
+    return renderer.image { _ in
+        let rect = CGRect(origin: .zero, size: box)
+        kasperIconBackground(symbol).setFill()
+        UIBezierPath(roundedRect: rect, cornerRadius: 7.0).fill()
+        let inner: UIImage?
+        if symbol == "kasper.logo" {
+            inner = kasperLogoImage(size: 21.0, color: .white)
+        } else {
+            let configuration = UIImage.SymbolConfiguration(pointSize: 14.0, weight: .semibold)
+            inner = UIImage(systemName: symbol, withConfiguration: configuration)?.withTintColor(.white, renderingMode: .alwaysOriginal)
+        }
+        if let inner = inner {
+            let fit = min(19.0 / inner.size.width, 19.0 / inner.size.height, 1.0)
+            let size = CGSize(width: inner.size.width * fit, height: inner.size.height * fit)
+            inner.draw(in: CGRect(x: (box.width - size.width) / 2.0, y: (box.height - size.height) / 2.0, width: size.width, height: size.height))
+        }
+    }
+}
