diff --git a/submodules/TgVoipWebrtc/Sources/KasperCallVoice.h b/submodules/TgVoipWebrtc/Sources/KasperCallVoice.h
new file mode 100644
index 00000000..bfa1936b
--- /dev/null
+++ b/submodules/TgVoipWebrtc/Sources/KasperCallVoice.h
@@ -0,0 +1,287 @@
+#ifndef KasperCallVoice_h
+#define KasperCallVoice_h
+
+#import <Foundation/Foundation.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+// Изменение голоса Kasper в звонках.
+//
+// Обрабатывает звук с микрофона прямо перед тем, как он попадёт в движок звонка.
+// Настройки берутся из тех же UserDefaults, что и остальной Kasper:
+//   kasper.voice       — выбранный голос ("female", "male", "child", "robot", "pixel", "echo")
+//   kasper.voice.calls — включено ли изменение голоса в звонках
+//
+// Работает только с моно-звуком 16 бит (так звонки и захватывают микрофон).
+// Если формат другой или голос выключен, звук идёт без изменений.
+namespace KasperCall {
+
+enum class Voice {
+    None,
+    Female,
+    Male,
+    Child,
+    Robot,
+    Pixel,
+    Echo,
+    Monster,
+    OldMan
+};
+
+inline Voice parseVoice(NSString *value) {
+    if (value == nil) {
+        return Voice::None;
+    } else if ([value isEqualToString:@"female"]) {
+        return Voice::Female;
+    } else if ([value isEqualToString:@"male"]) {
+        return Voice::Male;
+    } else if ([value isEqualToString:@"child"]) {
+        return Voice::Child;
+    } else if ([value isEqualToString:@"robot"]) {
+        return Voice::Robot;
+    } else if ([value isEqualToString:@"pixel"]) {
+        return Voice::Pixel;
+    } else if ([value isEqualToString:@"echo"]) {
+        return Voice::Echo;
+    } else if ([value isEqualToString:@"monster"]) {
+        return Voice::Monster;
+    } else if ([value isEqualToString:@"oldMan"]) {
+        return Voice::OldMan;
+    }
+    return Voice::None;
+}
+
+inline double pitchRatio(Voice voice) {
+    switch (voice) {
+        case Voice::Female:
+            return 1.34;
+        case Voice::Male:
+            return 0.76;
+        case Voice::Child:
+            return 1.6;
+        case Voice::Robot:
+            return 0.85;
+        case Voice::Monster:
+            return 0.58;
+        case Voice::OldMan:
+            return 0.9;
+        default:
+            return 1.0;
+    }
+}
+
+inline float outputGain(Voice voice) {
+    switch (voice) {
+        case Voice::Male:
+            return 1.08f;
+        case Voice::Robot:
+            return 0.9f;
+        case Voice::Pixel:
+            return 1.1f;
+        case Voice::Monster:
+            return 1.15f;
+        default:
+            return 1.0f;
+    }
+}
+
+class Processor {
+public:
+    Processor() {
+        memset(_buffer, 0, sizeof(_buffer));
+        memset(_echoBuffer, 0, sizeof(_echoBuffer));
+        memset(_output, 0, sizeof(_output));
+    }
+
+    /// Возвращает указатель на обработанный звук либо исходный, если менять ничего не нужно.
+    const void *processIfNeeded(const void *audioSamples, size_t sampleCount, size_t bytesPerSample, size_t channels, uint32_t sampleRate) {
+        refreshSettings();
+        if (_voice == Voice::None || audioSamples == nullptr) {
+            return audioSamples;
+        }
+        if (bytesPerSample != 2 || channels != 1 || sampleCount == 0 || sampleCount > kMaxSamples || sampleRate < 8000) {
+            // непонятный формат — не трогаем звук, чтобы не сломать звонок
+            return audioSamples;
+        }
+
+        const int16_t *input = reinterpret_cast<const int16_t *>(audioSamples);
+        const double window = std::max(64.0, (double)sampleRate / 25.0);
+        const int holdLimit = std::max(1, (int)(sampleRate / 5300));
+        const size_t echoDelay = std::min((size_t)(sampleRate * 0.28), (size_t)(kEchoSize - 1));
+
+        for (size_t i = 0; i < sampleCount; i++) {
+            float value = (float)input[i] / 32768.0f;
+
+            switch (_voice) {
+                case Voice::Female:
+                case Voice::Male:
+                case Voice::Child:
+                    value = pitchShifted(value, window);
+                    break;
+                case Voice::Robot:
+                    value = robot(pitchShifted(value, window), sampleRate);
+                    break;
+                case Voice::Pixel:
+                    value = pixel(value, holdLimit);
+                    break;
+                case Voice::Echo:
+                    value = echo(value, echoDelay);
+                    break;
+                case Voice::Monster:
+                    value = monster(pitchShifted(value, window), sampleRate);
+                    break;
+                case Voice::OldMan:
+                    _ratio = oldManRatio(sampleRate);
+                    value = pitchShifted(value, window) * (float)(0.9 + 0.1 * sin(_vibratoPhase));
+                    break;
+                case Voice::None:
+                    break;
+            }
+
+            value *= outputGain(_voice);
+            if (value > 1.0f) {
+                value = 1.0f;
+            } else if (value < -1.0f) {
+                value = -1.0f;
+            }
+            _output[i] = (int16_t)(value * 32767.0f);
+        }
+        return _output;
+    }
+
+private:
+    static const size_t kBufferSize = 16384;
+    static const size_t kEchoSize = 24000;
+    static const size_t kMaxSamples = 8192;
+
+    Voice _voice = Voice::None;
+    double _ratio = 1.0;
+    double _lastSettingsCheck = 0.0;
+
+    float _buffer[kBufferSize];
+    size_t _writePosition = 0;
+    double _readPhase = 0.0;
+
+    double _modulatorPhase = 0.0;
+    double _growlPhase = 0.0;
+    double _vibratoPhase = 0.0;
+    double _baseRatio = 1.0;
+
+    float _holdValue = 0.0f;
+    int _holdCounter = 0;
+
+    float _echoBuffer[kEchoSize];
+    size_t _echoPosition = 0;
+
+    int16_t _output[kMaxSamples];
+
+    void refreshSettings() {
+        double now = CFAbsoluteTimeGetCurrent();
+        if (now - _lastSettingsCheck < 0.5) {
+            return;
+        }
+        _lastSettingsCheck = now;
+        NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+        Voice voice = Voice::None;
+        if ([defaults boolForKey:@"kasper.voice.calls"]) {
+            voice = parseVoice([defaults stringForKey:@"kasper.voice"]);
+        }
+        if (voice != _voice) {
+            _voice = voice;
+            _ratio = pitchRatio(voice);
+            _baseRatio = _ratio;
+            _growlPhase = 0.0;
+            _vibratoPhase = 0.0;
+            _readPhase = 0.0;
+            _writePosition = 0;
+            _echoPosition = 0;
+            _holdCounter = 0;
+            memset(_buffer, 0, sizeof(_buffer));
+            memset(_echoBuffer, 0, sizeof(_echoBuffer));
+        }
+    }
+
+    float sampleAt(double delay) {
+        double index = (double)_writePosition - delay;
+        while (index < 0.0) {
+            index += (double)kBufferSize;
+        }
+        while (index >= (double)kBufferSize) {
+            index -= (double)kBufferSize;
+        }
+        size_t i0 = (size_t)index;
+        size_t i1 = (i0 + 1) % kBufferSize;
+        float fraction = (float)(index - (double)i0);
+        return _buffer[i0] * (1.0f - fraction) + _buffer[i1] * fraction;
+    }
+
+    float pitchShifted(float input, double window) {
+        _buffer[_writePosition] = input;
+        _writePosition = (_writePosition + 1) % kBufferSize;
+        if (_ratio == 1.0) {
+            return input;
+        }
+        _readPhase -= _ratio - 1.0;
+        if (_readPhase >= window) {
+            _readPhase -= window;
+        } else if (_readPhase < 0.0) {
+            _readPhase += window;
+        }
+        double phase1 = _readPhase;
+        double phase2 = phase1 < window / 2.0 ? phase1 + window / 2.0 : phase1 - window / 2.0;
+        float gain1 = (float)sin(M_PI * phase1 / window);
+        float gain2 = (float)sin(M_PI * phase2 / window);
+        return sampleAt(phase1) * gain1 + sampleAt(phase2) * gain2;
+    }
+
+    float robot(float input, uint32_t sampleRate) {
+        _modulatorPhase += 2.0 * M_PI * 95.0 / (double)sampleRate;
+        if (_modulatorPhase > 2.0 * M_PI) {
+            _modulatorPhase -= 2.0 * M_PI;
+        }
+        return input * (float)(0.45 + 0.55 * sin(_modulatorPhase)) * 1.4f;
+    }
+
+    float monster(float input, uint32_t sampleRate) {
+        _growlPhase += 2.0 * M_PI * 28.0 / (double)sampleRate;
+        if (_growlPhase > 2.0 * M_PI) {
+            _growlPhase -= 2.0 * M_PI;
+        }
+        float growled = input * (float)(0.78 + 0.22 * sin(_growlPhase));
+        return tanhf(growled * 1.6f) * 0.8f;
+    }
+
+    double oldManRatio(uint32_t sampleRate) {
+        _vibratoPhase += 2.0 * M_PI * 5.5 / (double)sampleRate;
+        if (_vibratoPhase > 2.0 * M_PI) {
+            _vibratoPhase -= 2.0 * M_PI;
+        }
+        return _baseRatio * (1.0 + 0.014 * sin(_vibratoPhase));
+    }
+
+    float pixel(float input, int holdLimit) {
+        if (_holdCounter <= 0) {
+            const float levels = 14.0f;
+            _holdValue = roundf(input * levels) / levels;
+            _holdCounter = holdLimit;
+        } else {
+            _holdCounter -= 1;
+        }
+        return _holdValue;
+    }
+
+    float echo(float input, size_t delaySamples) {
+        size_t readPosition = (_echoPosition + kEchoSize - delaySamples) % kEchoSize;
+        float delayed = _echoBuffer[readPosition];
+        _echoBuffer[_echoPosition] = input + delayed * 0.45f;
+        _echoPosition = (_echoPosition + 1) % kEchoSize;
+        return input * 0.75f + delayed * 0.55f;
+    }
+};
+
+}  // namespace KasperCall
