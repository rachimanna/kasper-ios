+    /// Локальный ник: виден только в Kasper и не меняет настоящий username.
+    public static var localNickname: String {
+        get { return defaults.string(forKey: Key.localNickname) ?? "" }
+        set { defaults.set(newValue, forKey: Key.localNickname) }
+    }
+
+    // MARK: - Сообщения, удалённые самим пользователем
+
+    private static let selfDeletedLock = NSLock()
+    private static var selfDeleted: [MessageId: Double] = [:]
+
+    /// Запоминаем то, что пользователь удалил сам, чтобы не «воскресить» это обратно.
+    public static func noteSelfDeleted(_ messageIds: [MessageId]) {
+        guard !messageIds.isEmpty else {
+            return
+        }
+        let now = CFAbsoluteTimeGetCurrent()
+        selfDeletedLock.lock()
+        for id in messageIds {
+            selfDeleted[id] = now
+        }
+        if selfDeleted.count > 512 {
+            for (id, timestamp) in selfDeleted where now - timestamp > 600.0 {
+                selfDeleted.removeValue(forKey: id)
+            }
+        }
+        selfDeletedLock.unlock()
+    }
+
+    static func wasDeletedBySelf(_ messageId: MessageId) -> Bool {
+        selfDeletedLock.lock()
+        let timestamp = selfDeleted[messageId]
+        selfDeletedLock.unlock()
+        guard let timestamp = timestamp else {
+            return false
+        }
+        return CFAbsoluteTimeGetCurrent() - timestamp < 600.0
+    }
+}
+
+/// Призрак: просим сервер считать нас офлайн. Telegram отмечает пользователя онлайн после
+/// отправки сообщения, поэтому сразу после отправки возвращаем статус обратно.
+func kasperPushOfflineStatus(network: Network) {
+    guard KasperSettings.ghostHideOnline else {
+        return
+    }
+    let sendOffline: () -> Void = {
+        let _ = (network.request(Api.functions.account.updateStatus(offline: .boolTrue))
+        |> `catch` { _ -> Signal<Api.Bool, NoError> in
+            return .single(.boolFalse)
+        }).start()
+    }
+    sendOffline()
+    // ответ сервера на отправку сообщения может прийти позже — повторяем через пару секунд
+    let _ = (Signal<Void, NoError>.single(Void())
+    |> delay(2.5, queue: Queue.concurrentDefaultQueue())).start(next: { _ in
+        sendOffline()
+    })
+}
+
+/// Сообщения, удалённые собеседником, остаются на телефоне с пометкой «🗑 Удалено».
+/// Возвращает глобальные id, которые нужно удалить обычным способом.
+func kasperKeepRemotelyDeletedMessages(transaction: Transaction, globalIds: [Int32]) -> [Int32] {
+    guard KasperSettings.keepDeletedMessages else {
+        return globalIds
+    }
+    var remaining: [Int32] = []
+    var caught = 0
+    for globalId in globalIds {
+        guard let messageId = transaction.messageIdsForGlobalIds([globalId]).first,
+              let message = transaction.getMessage(messageId),
+              message.flags.contains(.Incoming),
+              !KasperSettings.wasDeletedBySelf(messageId) else {
+            remaining.append(globalId)
+            continue
+        }
+        let namespace = messageId.peerId.namespace
+        let isPrivate = namespace == Namespaces.Peer.CloudUser
+        let isGroup = namespace == Namespaces.Peer.CloudGroup || namespace == Namespaces.Peer.CloudChannel
+        guard isPrivate || (isGroup && KasperSettings.keepDeletedInGroups) else {
+            remaining.append(globalId)
+            continue
+        }
+        if message.text.hasSuffix(KasperSettings.deletedMarker) {
+            // уже помечено: сервер может прислать удаление повторно
+            continue
+        }
+        let markedText: String
+        if message.text.isEmpty {
+            markedText = KasperSettings.deletedMarker
+        } else {
+            markedText = message.text + "\n\n" + KasperSettings.deletedMarker
+        }
+        transaction.updateMessage(messageId, update: { currentMessage in
+            var storeForwardInfo: StoreMessageForwardInfo?
+            if let forwardInfo = currentMessage.forwardInfo {
+                storeForwardInfo = StoreMessageForwardInfo(authorId: forwardInfo.author?.id, sourceId: forwardInfo.source?.id, sourceMessageId: forwardInfo.sourceMessageId, date: forwardInfo.date, authorSignature: forwardInfo.authorSignature, psaType: forwardInfo.psaType, flags: forwardInfo.flags)
+            }
+            return .update(StoreMessage(
+                id: currentMessage.id,
+                customStableId: nil,
+                globallyUniqueId: currentMessage.globallyUniqueId,
+                groupingKey: currentMessage.groupingKey,
+                threadId: currentMessage.threadId,
+                timestamp: currentMessage.timestamp,
+                flags: StoreMessageFlags(currentMessage.flags),
+                tags: currentMessage.tags,
+                globalTags: currentMessage.globalTags,
+                localTags: currentMessage.localTags,
+                forwardInfo: storeForwardInfo,
+                authorId: currentMessage.author?.id,
+                text: markedText,
+                attributes: currentMessage.attributes,
+                media: currentMessage.media
+            ))
+        })
+        caught += 1
+    }
+    if caught != 0 {
+        KasperSettings.deletedCaught += caught
+    }
+    return remaining
+}
+
+/// Эффекты голоса для голосовых сообщений Kasper. Обработка идёт на телефоне,
+/// в Telegram уходит уже изменённая запись.
+public enum KasperVoice: String, CaseIterable {
+    case none
+    case female
+    case male
+    case child
+    case robot
+    case pixel
+    case echo
+    case monster
+    case oldMan
+
+    public var title: String {
+        switch self {
+        case .none:
+            return "Обычный голос"
+        case .female:
+            return "Женский"
+        case .male:
+            return "Мужской"
+        case .child:
+            return "Детский"
+        case .robot:
+            return "Робот"
+        case .pixel:
+            return "Пиксель"
+        case .echo:
+            return "Эхо"
+        case .monster:
+            return "Монстр"
+        case .oldMan:
+            return "Старик"
+        }
+    }
+
+    public var emoji: String {
+        switch self {
+        case .none:
+            return "🙂"
+        case .female:
+            return "👩"
+        case .male:
+            return "👨"
+        case .child:
+            return "🧒"
+        case .robot:
+            return "🤖"
+        case .pixel:
+            return "👾"
+        case .echo:
+            return "🌀"
+        case .monster:
+            return "👹"
+        case .oldMan:
+            return "🧓"
+        }
+    }
+
+    /// Во сколько раз меняется высота голоса (1.0 — не меняется).
+    public var pitchRatio: Double {
+        switch self {
+        case .none, .pixel, .echo:
+            return 1.0
+        case .female:
+            return 1.34
+        case .male:
+            return 0.76
+        case .child:
+            return 1.6
+        case .robot:
+            return 0.85
+        case .monster:
+            return 0.58
+        case .oldMan:
+            return 0.9
+        }
+    }
+
+    /// Поправка громкости после обработки.
+    public var outputGain: Float {
+        switch self {
+        case .none, .female, .child, .echo:
+            return 1.0
+        case .male:
+            return 1.08
+        case .robot:
+            return 0.9
+        case .pixel:
+            return 1.1
+        case .monster:
+            return 1.15
+        case .oldMan:
+            return 1.0
+        }
+    }
+}
+
+/// Kasper: файл в формате WAV (по типу или по расширению имени).
+func kasperIsWavFile(mimeType: String?, fileName: String?) -> Bool {
+    let type = (mimeType ?? "").lowercased()
+    if type == "audio/wav" || type == "audio/x-wav" || type == "audio/wave" || type == "audio/vnd.wave" {
+        return true
+    }
+    if let fileName = fileName, fileName.lowercased().hasSuffix(".wav") {
+        return true
+    }
+    return false
+}
