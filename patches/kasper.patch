@@ -0,0 +1,279 @@
+import Foundation
+import SwiftSignalKit
+
+/// Голос из библиотеки ElevenLabs.
+public struct KasperElevenLabsVoice: Equatable {
+    public let id: String
+    public let name: String
+    public let gender: String
+    public let age: String
+
+    public init(id: String, name: String, gender: String, age: String) {
+        self.id = id
+        self.name = name
+        self.gender = gender
+        self.age = age
+    }
+}
+
+public enum KasperElevenLabsError: Error, Equatable {
+    case noKey
+    case network(String)
+    case http(Int, String)
+    case badResponse
+
+    /// Понятное описание для экрана настроек.
+    public var text: String {
+        switch self {
+        case .noKey:
+            return "Не указан API-ключ ElevenLabs"
+        case let .network(message):
+            return "Нет связи с ElevenLabs: \(message)"
+        case let .http(code, message):
+            let lower = message.lowercased()
+            switch code {
+            case 401, 403:
+                if lower.contains("quota") || lower.contains("credits") {
+                    return "На аккаунте ElevenLabs закончились кредиты"
+                }
+                if lower.contains("permission") || lower.contains("missing_permissions") {
+                    return "У ключа не хватает прав — включите Voices и Speech to Speech"
+                }
+                return message.isEmpty ? "Ключ ElevenLabs не подходит (\(code))" : "ElevenLabs отклонил ключ: \(message)"
+            case 402:
+                return "На аккаунте ElevenLabs закончились кредиты"
+            case 422:
+                return message.isEmpty ? "ElevenLabs не принял запись (422)" : "ElevenLabs не принял запись: \(message)"
+            case 429:
+                return "Слишком много запросов к ElevenLabs, попробуйте через минуту"
+            default:
+                return message.isEmpty ? "Ошибка ElevenLabs (\(code))" : "Ошибка ElevenLabs (\(code)): \(message)"
+            }
+        case .badResponse:
+            return "ElevenLabs вернул пустой ответ"
+        }
+    }
+
+    /// Запись в этом формате ElevenLabs не принял — есть смысл переслать её иначе.
+    public var isFormatRejection: Bool {
+        if case let .http(code, _) = self {
+            return code == 400 || code == 415 || code == 422
+        }
+        return false
+    }
+}
+
+/// Клиент ElevenLabs для Kasper: библиотека голосов и Voice Changer (speech-to-speech).
+/// Запросы уходят напрямую с телефона на api.elevenlabs.io с ключом пользователя.
+public enum KasperElevenLabs {
+    /// Многоязычная модель Voice Changer — понимает русскую речь.
+    public static let modelId = "eleven_multilingual_sts_v2"
+    /// Ответ просим сжатым: по мобильному интернету это в разы быстрее, чем PCM.
+    public static let outputFormat = "mp3_22050_32"
+
+    private static let baseUrl = "https://api.elevenlabs.io"
+
+    private static let session: URLSession = {
+        let configuration = URLSessionConfiguration.default
+        // Голосовое не должно «висеть»: лучше быстро вернуться к локальному эффекту.
+        configuration.timeoutIntervalForRequest = 20.0
+        configuration.timeoutIntervalForResource = 25.0
+        configuration.waitsForConnectivity = false
+        return URLSession(configuration: configuration)
+    }()
+
+    private static func errorMessage(from data: Data?) -> String {
+        guard let data = data, !data.isEmpty else {
+            return ""
+        }
+        if let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] {
+            if let detail = json["detail"] as? [String: Any] {
+                if let message = detail["message"] as? String {
+                    return message
+                }
+                if let status = detail["status"] as? String {
+                    return status
+                }
+            }
+            if let detail = json["detail"] as? String {
+                return detail
+            }
+            if let message = json["message"] as? String {
+                return message
+            }
+        }
+        return String(data: data.prefix(160), encoding: .utf8) ?? ""
+    }
+
+    private static func perform(_ request: URLRequest, completion: @escaping (Swift.Result<Data, KasperElevenLabsError>) -> Void) -> URLSessionDataTask {
+        let task = session.dataTask(with: request, completionHandler: { data, response, error in
+            if let error = error {
+                if (error as NSError).code == NSURLErrorCancelled {
+                    return
+                }
+                completion(.failure(.network(error.localizedDescription)))
+                return
+            }
+            guard let response = response as? HTTPURLResponse else {
+                completion(.failure(.badResponse))
+                return
+            }
+            guard (200 ..< 300).contains(response.statusCode) else {
+                completion(.failure(.http(response.statusCode, errorMessage(from: data))))
+                return
+            }
+            guard let data = data, !data.isEmpty else {
+                completion(.failure(.badResponse))
+                return
+            }
+            completion(.success(data))
+        })
+        task.resume()
+        return task
+    }
+
+    private static func parseVoices(_ data: Data) -> [KasperElevenLabsVoice] {
+        guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any], let items = json["voices"] as? [[String: Any]] else {
+            return []
+        }
+        var result: [KasperElevenLabsVoice] = []
+        for item in items {
+            guard let id = item["voice_id"] as? String, let name = item["name"] as? String else {
+                continue
+            }
+            let labels = item["labels"] as? [String: Any]
+            let gender = (labels?["gender"] as? String) ?? ""
+            let age = (labels?["age"] as? String) ?? ""
+            result.append(KasperElevenLabsVoice(id: id, name: name, gender: gender.lowercased(), age: age.lowercased()))
+        }
+        return result
+    }
+
+    private static func voicesRequest(apiKey: String, defaultsOnly: Bool) -> Signal<[KasperElevenLabsVoice], KasperElevenLabsError> {
+        return Signal { subscriber in
+            var components = URLComponents(string: baseUrl + "/v2/voices")!
+            var query = [URLQueryItem(name: "page_size", value: "100")]
+            if defaultsOnly {
+                query.append(URLQueryItem(name: "voice_type", value: "default"))
+            }
+            components.queryItems = query
+            var request = URLRequest(url: components.url!)
+            request.httpMethod = "GET"
+            request.setValue(apiKey, forHTTPHeaderField: "xi-api-key")
+            request.setValue("application/json", forHTTPHeaderField: "Accept")
+
+            let task = perform(request, completion: { result in
+                switch result {
+                case let .failure(error):
+                    subscriber.putError(error)
+                case let .success(data):
+                    subscriber.putNext(parseVoices(data))
+                    subscriber.putCompletion()
+                }
+            })
+            return ActionDisposable {
+                task.cancel()
+            }
+        }
+    }
+
+    /// Все голоса, доступные аккаунту: свои и сохранённые плюс стандартная библиотека.
+    public static func voices(apiKey: String) -> Signal<[KasperElevenLabsVoice], KasperElevenLabsError> {
+        let key = apiKey.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !key.isEmpty else {
+            return .fail(.noKey)
+        }
+        let own = voicesRequest(apiKey: key, defaultsOnly: false)
+        // Стандартные голоса лежат отдельно и нужны нам как запасной вариант,
+        // поэтому их отсутствие не должно ломать весь список.
+        let premade = voicesRequest(apiKey: key, defaultsOnly: true)
+        |> `catch` { _ -> Signal<[KasperElevenLabsVoice], KasperElevenLabsError> in
+            return .single([])
+        }
+        return combineLatest(own, premade)
+        |> map { own, premade -> [KasperElevenLabsVoice] in
+            var result = own
+            var known = Set(own.map({ $0.id }))
+            for voice in premade where !known.contains(voice.id) {
+                known.insert(voice.id)
+                result.append(voice)
+            }
+            return result
+        }
+    }
+
+    /// Подбирает каждому голосу Kasper голос ElevenLabs: сперва по имени, затем по меткам.
+    public static func match(voice: KasperVoice, in library: [KasperElevenLabsVoice]) -> KasperElevenLabsVoice? {
+        guard !library.isEmpty else {
+            return nil
+        }
+        for name in voice.elevenLabsNames {
+            if let found = library.first(where: { $0.name.caseInsensitiveCompare(name) == .orderedSame }) {
+                return found
+            }
+        }
+        let labels = voice.elevenLabsLabels
+        if !labels.gender.isEmpty {
+            if !labels.age.isEmpty, let found = library.first(where: { $0.gender == labels.gender && $0.age == labels.age }) {
+                return found
+            }
+            if let found = library.first(where: { $0.gender == labels.gender }) {
+                return found
+            }
+        }
+        return library.first
+    }
+
+    /// Voice Changer: отправляет запись и возвращает ту же речь выбранным голосом.
+    /// `audio` — готовое голосовое (ogg/opus) или WAV; ответ приходит в MP3.
+    public static func changeVoice(audio: Data, fileName: String, mimeType: String, voiceId: String, apiKey: String) -> Signal<Data, KasperElevenLabsError> {
+        return Signal { subscriber in
+            let key = apiKey.trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !key.isEmpty else {
+                subscriber.putError(.noKey)
+                return EmptyDisposable
+            }
+            let voicePath = voiceId.trimmingCharacters(in: .whitespacesAndNewlines).addingPercentEncoding(withAllowedCharacters: .urlPathAllowed) ?? voiceId
+            var components = URLComponents(string: baseUrl + "/v1/speech-to-speech/" + voicePath)!
+            components.queryItems = [
+                URLQueryItem(name: "output_format", value: outputFormat)
+            ]
+            var request = URLRequest(url: components.url!)
+            request.httpMethod = "POST"
+            request.setValue(key, forHTTPHeaderField: "xi-api-key")
+
+            let boundary = "KasperBoundary\(UInt64.random(in: 0 ... UInt64.max))"
+            request.setValue("multipart/form-data; boundary=\(boundary)", forHTTPHeaderField: "Content-Type")
+
+            var body = Data()
+            func appendField(_ name: String, _ value: String) {
+                body.append("--\(boundary)\r\n".data(using: .utf8)!)
+                body.append("Content-Disposition: form-data; name=\"\(name)\"\r\n\r\n".data(using: .utf8)!)
+                body.append("\(value)\r\n".data(using: .utf8)!)
+            }
+            appendField("model_id", modelId)
+            appendField("remove_background_noise", "false")
+            // Близко к исходнику: сохраняем интонации, но полностью меняем тембр.
+            appendField("voice_settings", "{\"stability\":0.5,\"similarity_boost\":0.85,\"style\":0.0,\"use_speaker_boost\":true}")
+            body.append("--\(boundary)\r\n".data(using: .utf8)!)
+            body.append("Content-Disposition: form-data; name=\"audio\"; filename=\"\(fileName)\"\r\n".data(using: .utf8)!)
+            body.append("Content-Type: \(mimeType)\r\n\r\n".data(using: .utf8)!)
+            body.append(audio)
+            body.append("\r\n--\(boundary)--\r\n".data(using: .utf8)!)
+            request.httpBody = body
+
+            let task = perform(request, completion: { result in
+                switch result {
+                case let .failure(error):
+                    subscriber.putError(error)
+                case let .success(data):
+                    subscriber.putNext(data)
+                    subscriber.putCompletion()
+                }
+            })
+            return ActionDisposable {
+                task.cancel()
+            }
+        }
+    }
+}
