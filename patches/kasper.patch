+// MARK: - VirusTotal
+
+func kasperVirusTotalController(context: AccountContext) -> ViewController {
+    let navigation = KasperNavigation()
+    let link = ValuePromise<String>("", ignoreRepeated: true)
+    var linkValue = ""
+    let busy = ValuePromise<String?>(nil, ignoreRepeated: true)
+    let checkDisposable = MetaDisposable()
+    let keyRefresh = ValuePromise<Int>(0, ignoreRepeated: false)
+    var keyTick = 0
+
+    let openUrl: (String) -> Void = { url in
+        context.sharedContext.applicationBindings.openUrl(url)
+    }
+    let finish: (String, Bool, String, Signal<KasperVirusTotalReport, KasperVirusTotalError>) -> Void = { title, isFile, webLink, signal in
+        busy.set(isFile ? "Проверяю файл…" : "Проверяю ссылку…")
+        checkDisposable.set((signal |> deliverOnMainQueue).start(next: { report in
+            busy.set(nil)
+            KasperVirusTotal.addToHistory(KasperVirusTotalCheck(title: title, isFile: isFile, link: webLink, report: report, date: Date().timeIntervalSince1970))
+            kasperAlert(context, navigation, title: title, text: report.verdict)
+        }, error: { error in
+            busy.set(nil)
+            kasperAlert(context, navigation, title: "Проверка не удалась", text: error.text)
+        }))
+    }
+
+    let checkLink: () -> Void = {
+        var url = linkValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !url.isEmpty else {
+            kasperAlert(context, navigation, title: nil, text: "Вставьте ссылку, которую нужно проверить.")
+            return
+        }
+        if !url.lowercased().hasPrefix("http://") && !url.lowercased().hasPrefix("https://") {
+            url = "https://" + url
+        }
+        finish(url, false, KasperVirusTotal.webLink(url: url), KasperVirusTotal.checkUrl(url, apiKey: KasperSettings.virusTotalKey))
+    }
+
+    let checkFile: () -> Void = {
+        kasperPickFile(context, navigation, types: ["public.item"], completion: { url in
+            guard let data = try? Data(contentsOf: url, options: .mappedIfSafe) else {
+                kasperAlert(context, navigation, title: nil, text: "Не удалось прочитать файл.")
+                return
+            }
+            let name = url.lastPathComponent
+            let hash = KasperVirusTotal.sha256(data)
+            let apiKey = KasperSettings.virusTotalKey
+            busy.set("Ищу файл в VirusTotal…")
+            checkDisposable.set((KasperVirusTotal.lookupFile(sha256: hash, apiKey: apiKey) |> deliverOnMainQueue).start(next: { report in
+                busy.set(nil)
+                KasperVirusTotal.addToHistory(KasperVirusTotalCheck(title: name, isFile: true, link: KasperVirusTotal.webLink(sha256: hash), report: report, date: Date().timeIntervalSince1970))
+                kasperAlert(context, navigation, title: name, text: report.verdict)
+            }, error: { error in
+                busy.set(nil)
+                guard case .notFound = error else {
+                    kasperAlert(context, navigation, title: "Проверка не удалась", text: error.text)
+                    return
+                }
+                let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+                navigation.present(textAlertController(context: context, title: "Файла нет в базе", text: "VirusTotal ещё не видел «\(name)». Можно загрузить его на проверку, но тогда файл станет доступен сообществу VirusTotal. Не загружайте личные документы и фото.", actions: [
+                    TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+                    TextAlertAction(type: .defaultAction, title: "Загрузить", action: {
+                        finish(name, true, KasperVirusTotal.webLink(sha256: hash), KasperVirusTotal.uploadFile(data: data, name: name, apiKey: apiKey))
+                    })
+                ], actionLayout: .vertical))
+            }))
+        })
+    }
+
+    let groups = combineLatest(link.get(), busy.get(), keyRefresh.get(), kasperNotifications(KasperVirusTotal.historyChangedNotification))
+    |> map { text, busyText, _, _ -> [KasperGroup] in
+        let hasKey = !KasperSettings.virusTotalKey.isEmpty
+        var groups: [KasperGroup] = [
+            [
+                .secret(id: "vt-key", title: "Ключ", placeholder: "API key из virustotal.com", value: KasperSettings.virusTotalKey, set: { value in
+                    KasperSettings.virusTotalKey = value
+                    keyTick += 1
+                    keyRefresh.set(keyTick)
+                }),
+                .toggle(id: "vt-auto", title: "Проверять ссылки из чатов", value: KasperSettings.virusTotalAutoCheck, enabled: hasKey, set: { value in
+                    KasperSettings.virusTotalAutoCheck = value
+                    keyTick += 1
+                    keyRefresh.set(keyTick)
+                }),
+                .text(id: "vt-key-footer", text: "Ключ бесплатный: зарегистрируйтесь на virustotal.com → профиль → API key. Автопроверка перед открытием ссылки спрашивает VirusTotal и предупреждает, если антивирусы считают её опасной. Ссылки Telegram не проверяются.")
+            ]
+        ]
+        if hasKey {
+            var checkRows: KasperGroup = [
+                .input(id: "vt-link", title: "🔗", placeholder: "Ссылка для проверки", value: text, set: { value in
+                    linkValue = value
+                    link.set(value)
+                }),
+                .action(id: "vt-check-link", title: "Проверить ссылку", destructive: false, action: {
+                    checkLink()
+                }),
+                .action(id: "vt-check-file", title: "Проверить файл…", destructive: false, action: {
+                    checkFile()
+                })
+            ]
+            if let busyText = busyText {
+                checkRows.append(.text(id: "vt-busy", text: busyText))
+            }
+            checkRows.append(.text(id: "vt-check-footer", text: "Файл сначала проверяется по отпечатку (SHA-256) — сам файл никуда не уходит. Бесплатный ключ: до 4 проверок в минуту и 500 в день."))
+            groups.append(checkRows)
+        }
+        let history = KasperVirusTotal.history()
+        if !history.isEmpty {
+            let formatter = DateFormatter()
+            formatter.locale = Locale(identifier: "ru_RU")
+            formatter.dateFormat = "d MMM, HH:mm"
+            var rows: KasperGroup = [.sectionTitle(id: "vt-history-title", text: "РЕЗУЛЬТАТЫ")]
+            for (index, check) in history.prefix(30).enumerated() {
+                let date = formatter.string(from: Date(timeIntervalSince1970: check.date))
+                rows.append(.link(id: "vt-\(index)-\(Int(check.date))", title: check.title, subtitle: "\(check.report.verdict)\n\(date) · подробнее на VirusTotal", symbol: check.isFile ? "doc.fill" : "link", badge: nil, action: {
+                    openUrl(check.link)
+                }))
+            }
+            rows.append(.action(id: "vt-history-clear", title: "Очистить результаты", destructive: true, action: {
+                KasperVirusTotal.clearHistory()
+            }))
+            groups.append(rows)
+        }
+        return groups
+    }
+    return kasperListController(context: context, title: "VirusTotal", navigation: navigation, groups: groups)
+}
