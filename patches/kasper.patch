diff --git a/Telegram/BUILD b/Telegram/BUILD
index 9ad13cf3..cddd6e2c 100644
--- a/Telegram/BUILD
+++ b/Telegram/BUILD
@@ -71,7 +71,9 @@ config_setting(
 
 bool_flag(
     name = "disableExtensions",
-    build_setting_default = False,
+    # Kasper: собираем без расширений (виджеты, «Поделиться», уведомления) —
+    # их нельзя нормально подписать бесплатным Apple ID
+    build_setting_default = True,
     visibility = ["//visibility:public"],
 )
 
@@ -329,6 +331,11 @@ alternate_icon_folders = [
     "Premium",
     "PremiumBlack",
     "PremiumTurbo",
+    # Kasper: цветные иконки, выбираются в Kasper → «Иконка приложения»
+    "KasperViolet",
+    "KasperBlue",
+    "KasperRed",
+    "KasperWhite",
 ]
 
 composer_icon_folders = ["Telegram"]
@@ -629,7 +636,7 @@ plist_fragment(
     template =
     """
     <key>CFBundleDisplayName</key>
-    <string>Telegram</string>
+    <string>Kasper</string>
     """
 )
 
@@ -1568,7 +1575,7 @@ plist_fragment(
     <key>CFBundleDevelopmentRegion</key>
     <string>en</string>
     <key>CFBundleDisplayName</key>
-    <string>Telegram</string>
+    <string>Kasper</string>
     <key>CFBundleIdentifier</key>
     <string>{telegram_bundle_id}</string>
     <key>CFBundleName</key>
