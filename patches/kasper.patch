+// MARK: - Плеер
+
+private func kasperPlayerRows(context: AccountContext, navigation: KasperNavigation, reload: @escaping () -> Void) -> [KasperGroup] {
+    let defaults = UserDefaults.standard
+    let eqEnabled = defaults.bool(forKey: "kasper.eq.enabled")
+    let bass = defaults.double(forKey: "kasper.eq.bass")
+    let mid = defaults.double(forKey: "kasper.eq.mid")
+    let treble = defaults.double(forKey: "kasper.eq.treble")
+
+    let presets: [(String, Double, Double, Double)] = [
+        ("Ровно", 0.0, 0.0, 0.0),
+        ("Больше баса", 6.0, 0.0, -1.0),
+        ("Вокал", -2.0, 4.0, 1.0),
+        ("Рок", 4.0, -1.0, 3.0),
+        ("Яркий звук", 0.0, 1.0, 5.0),
+        ("Меньше баса", -6.0, 0.0, 0.0)
+    ]
+    let apply: (Double, Double, Double) -> Void = { b, m, t in
+        defaults.set(b, forKey: "kasper.eq.bass")
+        defaults.set(m, forKey: "kasper.eq.mid")
+        defaults.set(t, forKey: "kasper.eq.treble")
+        reload()
+    }
+    func levelRows(_ id: String, _ title: String, _ value: Double, _ set: @escaping (Double) -> Void) -> [KasperRow] {
+        var rows: [KasperRow] = [.sectionTitle(id: "\(id)-title", text: title)]
+        for (label, level) in [("−6 дБ", -6.0), ("−3 дБ", -3.0), ("0", 0.0), ("+3 дБ", 3.0), ("+6 дБ", 6.0)] {
+            rows.append(.choice(id: "\(id)-\(level)", title: label, selected: abs(value - level) < 0.1, action: {
+                set(level)
+            }))
+        }
+        return rows
+    }
+
+    var presetRows: KasperGroup = [.sectionTitle(id: "eq-presets-title", text: "ПРЕДУСТАНОВКИ")]
+    for (name, b, m, t) in presets {
+        let selected = abs(bass - b) < 0.1 && abs(mid - m) < 0.1 && abs(treble - t) < 0.1
+        presetRows.append(.choice(id: "eq-preset-\(name)", title: name, selected: selected, action: {
+            apply(b, m, t)
+        }))
+    }
+
+    var groups: [KasperGroup] = [
+        [
+            .toggle(id: "eq-enabled", title: "Эквалайзер", value: eqEnabled, enabled: true, set: { value in
+                defaults.set(value, forKey: "kasper.eq.enabled")
+                reload()
+            }),
+            .text(id: "eq-footer", text: "Работает для музыки и видео в Kasper. Голосовые и кружки не меняются. Новые настройки применяются со следующего трека.")
+        ]
+    ]
+    if eqEnabled {
+        groups.append(presetRows)
+        groups.append(levelRows("eq-bass", "НИЗКИЕ ЧАСТОТЫ (БАСЫ)", bass, { value in apply(value, mid, treble) }))
+        groups.append(levelRows("eq-mid", "СРЕДНИЕ ЧАСТОТЫ", mid, { value in apply(bass, value, treble) }))
+        groups.append(levelRows("eq-treble", "ВЫСОКИЕ ЧАСТОТЫ", treble, { value in apply(bass, mid, value) }))
+    }
+
+    let voiceRate = KasperPlayerState.shared.voiceRate
+    let order = KasperPlayerState.shared.order
+    let looping = KasperPlayerState.shared.looping
+    let updatePlayback: (@escaping (MusicPlaybackSettings) -> MusicPlaybackSettings) -> Void = { f in
+        let _ = (updateMusicPlaybackSettingsInteractively(accountManager: context.sharedContext.accountManager, f)
+        |> deliverOnMainQueue).start(completed: {
+            KasperPlayerState.shared.refresh(context: context, completion: reload)
+        })
+    }
