+/// Пояснение под разделом голоса: зависит от того, включены ли реалистичные голоса.
+private func kasperVoiceFooter(state: KasperSettingsState) -> String {
+    var text: String
+    if state.realisticVoice {
+        if state.elevenLabsApiKey.isEmpty {
+            text = "Вставьте API-ключ с elevenlabs.io → Developers → API Keys (права: Voices и Speech to Speech). Kasper сам подберёт каждому голосу подходящий голос ElevenLabs."
+        } else {
+            text = "Голосовое записывается как обычно, а после остановки ElevenLabs переозвучивает его выбранным голосом с вашими интонациями. Отправка задерживается на несколько секунд и тратит кредиты ElevenLabs (примерно 1000 за минуту записи). Робот, Пиксель, Эхо и Монстр — это голос ElevenLabs плюс эффект Kasper. В звонках и кружках реалистичные голоса не работают: там остаётся обработка на телефоне. Если ElevenLabs не ответит, настоящий голос не уйдёт — отправится запись с обычным эффектом."
+        }
+    } else {
+        text = "Голос меняется на телефоне во время записи. Включите «Реалистичные голоса», чтобы те же голоса звучали как настоящие — для этого нужен ключ ElevenLabs. Если в звонке пойдут помехи, выключите звонки — звук сразу станет обычным."
+    }
+    if !state.elevenLabsLastError.isEmpty {
+        text = "⚠️ Последняя запись: \(state.elevenLabsLastError)\n\n" + text
+    }
+    return text
+}
