+func kasperRadioController(context: AccountContext) -> ViewController {
+    let navigation = KasperNavigation()
+    let radio = KasperRadio.shared
+    let query = ValuePromise<String>("", ignoreRepeated: true)
+    let stations = Promise<[KasperRadioStation]?>(nil)
+
+    let searchDisposable = MetaDisposable()
+    let loadStations: (String) -> Void = { text in
+        stations.set(.single(nil))
+        let country: String? = text.trimmingCharacters(in: .whitespaces).isEmpty ? "RU" : nil
+        searchDisposable.set((KasperRadio.stations(query: text, countryCode: country)
+        |> deliverOnMainQueue).start(next: { list in
+            stations.set(.single(list))
+        }))
+    }
+    loadStations("")
+
+    let stationRow: (String, KasperRadioStation) -> KasperRow = { prefix, station in
+        let playing = radio.current?.id == station.id
+        var subtitle = [station.country, station.tags.split(separator: ",").prefix(3).joined(separator: ", ")].filter({ !$0.isEmpty }).joined(separator: " · ")
+        if playing {
+            subtitle = radio.isPlaying ? "▶︎ Играет" : "⏸ На паузе"
+        }
+        return .link(id: "\(prefix)-\(station.id)", title: station.name, subtitle: subtitle.isEmpty ? nil : subtitle, symbol: playing ? "speaker.wave.2.fill" : "dot.radiowaves.left.and.right", badge: radio.isFavorite(station) ? "★" : nil, action: {
+            if radio.current?.id == station.id {
+                radio.togglePause()
+            } else {
+                radio.play(station)
+            }
+        })
+    }
+
+    let groups = combineLatest(kasperNotifications(KasperRadio.changedNotification), query.get(), stations.get())
+    |> map { _, text, list -> [KasperGroup] in
+        var groups: [KasperGroup] = []
+        if let current = radio.current {
+            var nowPlaying: KasperGroup = [
+                .sectionTitle(id: "now-title", text: "СЕЙЧАС ИГРАЕТ"),
+                .detail(id: "now", title: current.name, text: radio.isLoading ? "Подключаюсь к станции…" : (radio.isPlaying ? "Играет" : "На паузе"), copy: nil),
+                .action(id: "now-toggle", title: radio.isPlaying ? "Пауза" : "Продолжить", destructive: false, action: {
+                    radio.togglePause()
+                }),
+                .action(id: "now-favorite", title: radio.isFavorite(current) ? "Убрать из избранного" : "В избранное ★", destructive: false, action: {
+                    radio.toggleFavorite(current)
+                }),
+                .action(id: "now-stop", title: "Выключить радио", destructive: true, action: {
+                    radio.stop()
+                })
+            ]
+            if let error = radio.lastError {
+                nowPlaying.append(.text(id: "now-error", text: error))
+            }
+            groups.append(nowPlaying)
+        } else if let error = radio.lastError {
+            groups.append([.text(id: "radio-error", text: error)])
+        }
+
+        let volume = radio.volume
+        var volumeRows: KasperGroup = [.sectionTitle(id: "volume-title", text: "ГРОМКОСТЬ")]
+        for (label, level) in [("25%", Float(0.25)), ("50%", Float(0.5)), ("75%", Float(0.75)), ("100%", Float(1.0))] {
+            volumeRows.append(.choice(id: "volume-\(label)", title: label, selected: abs(volume - level) < 0.05, action: {
+                radio.volume = level
+            }))
+        }
+        volumeRows.append(.toggle(id: "background", title: "Играть в фоне", value: radio.playInBackground, enabled: true, set: { value in
+            radio.playInBackground = value
+        }))
+        groups.append(volumeRows)
+
+        let favorites = radio.favorites
+        if !favorites.isEmpty {
+            var favoriteRows: KasperGroup = [.sectionTitle(id: "fav-title", text: "ИЗБРАННОЕ")]
+            for station in favorites {
+                favoriteRows.append(stationRow("fav", station))
+            }
+            groups.append(favoriteRows)
+        }
+
+        groups.append([
+            .input(id: "radio-search", title: "🔍", placeholder: "Найти станцию по названию", value: text, set: { value in
+                query.set(value)
+                loadStations(value)
+            })
+        ])
+        if let list = list {
+            if list.isEmpty {
+                groups.append([.text(id: "radio-empty", text: "Ничего не нашлось. Попробуйте другое название.")])
+            } else {
+                let title = text.trimmingCharacters(in: .whitespaces).isEmpty ? "ПОПУЛЯРНЫЕ В РОССИИ" : "НАЙДЕНО"
+                var listRows: KasperGroup = [.sectionTitle(id: "list-title", text: title)]
+                for station in list {
+                    listRows.append(stationRow("list", station))
+                }
+                groups.append(listRows)
+            }
+        } else {
+            groups.append([.text(id: "radio-loading", text: "Загружаю станции…")])
+        }
+
+        let history = radio.history
+        if !history.isEmpty {
+            var historyRows: KasperGroup = [.sectionTitle(id: "history-title", text: "НЕДАВНО СЛУШАЛИ")]
+            for station in history.prefix(10) {
+                historyRows.append(stationRow("history", station))
+            }
+            historyRows.append(.action(id: "history-clear", title: "Очистить историю", destructive: true, action: {
+                radio.clearHistory()
+            }))
+            groups.append(historyRows)
+        }
+        groups.append([.text(id: "radio-footer", text: "Станции из открытого каталога radio-browser.info. Нажмите на станцию, чтобы включить, ещё раз — пауза. Радио играет и когда вы в чатах; если в Kasper запустить голосовое или видео, радио приглушится.")])
+        return groups
+    }
+    return kasperListController(context: context, title: "Радио", navigation: navigation, groups: groups)
+}
