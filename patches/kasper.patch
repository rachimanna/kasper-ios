+enum KasperAbout {
+    static let repository = "https://github.com/rachimanna/kasper-ios"
+
+    static var shortVersion: String {
+        return (Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String) ?? "—"
+    }
+
+    static var buildNumber: String {
+        return (Bundle.main.infoDictionary?["CFBundleVersion"] as? String) ?? "—"
+    }
+
+    static var versionString: String {
+        return "\(shortVersion) (\(buildNumber))"
+    }
+
+    enum UpdateCheck {
+        case upToDate
+        case available(build: Int, url: String)
+        case failed(String)
+    }
+
+    /// Последний релиз из GitHub. Сборки публикуются с тегом kasper-<номер сборки>.
+    static func checkForUpdate() -> Signal<UpdateCheck, NoError> {
+        return Signal { subscriber in
+            guard let url = URL(string: "https://api.github.com/repos/rachimanna/kasper-ios/releases/latest") else {
+                subscriber.putNext(.failed("неверный адрес"))
+                subscriber.putCompletion()
+                return EmptyDisposable
+            }
+            var request = URLRequest(url: url, timeoutInterval: 15.0)
+            request.setValue("application/vnd.github+json", forHTTPHeaderField: "Accept")
+            let task = URLSession.shared.dataTask(with: request, completionHandler: { data, _, error in
+                if let error = error {
+                    if (error as NSError).code != NSURLErrorCancelled {
+                        subscriber.putNext(.failed(error.localizedDescription))
+                        subscriber.putCompletion()
+                    }
+                    return
+                }
+                guard let data = data, let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any], let tag = json["tag_name"] as? String else {
+                    subscriber.putNext(.failed("GitHub не вернул информацию о релизе"))
+                    subscriber.putCompletion()
+                    return
+                }
+                let latest = Int(tag.components(separatedBy: "-").last ?? "") ?? 0
+                let current = Int(buildNumber) ?? 0
+                let page = (json["html_url"] as? String) ?? (repository + "/releases/latest")
+                if latest > current {
+                    subscriber.putNext(.available(build: latest, url: page))
+                } else {
+                    subscriber.putNext(.upToDate)
+                }
+                subscriber.putCompletion()
+            })
+            task.resume()
+            return ActionDisposable {
+                task.cancel()
+            }
+        }
+    }
+}
