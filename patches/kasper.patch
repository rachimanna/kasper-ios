+// MARK: - Иконка приложения
+
+/// Иконки Kasper, которые лежат в сборке как альтернативные (Telegram/BUILD, папки *.alticon).
+enum KasperAppIcon: String, CaseIterable {
+    case standard = ""
+    case violet = "KasperViolet"
+    case blue = "KasperBlue"
+    case red = "KasperRed"
+    case white = "KasperWhite"
+
+    var title: String {
+        switch self {
+        case .standard: return "Чёрная (стандартная)"
+        case .violet: return "Фиолетовая"
+        case .blue: return "Синяя"
+        case .red: return "Красная"
+        case .white: return "Белая"
+        }
+    }
+
+    static func title(forName name: String) -> String {
+        if let icon = KasperAppIcon(rawValue: name) {
+            return icon.title
+        }
+        return "Иконка Telegram"
+    }
+
+    /// Имя текущей иконки: "" — стандартная.
+    static func currentName(context: AccountContext) -> String {
+        return context.sharedContext.applicationBindings.getAlternateIconName() ?? ""
+    }
+
+    static func set(_ icon: KasperAppIcon, context: AccountContext, completion: @escaping () -> Void) {
+        context.sharedContext.applicationBindings.requestSetAlternateIconName(icon.rawValue.isEmpty ? nil : icon.rawValue, { success in
+            Queue.mainQueue().async {
+                if success {
+                    KasperSettings.alternateAppIcon = icon.rawValue
+                }
+                completion()
+            }
+        })
+    }
+}
