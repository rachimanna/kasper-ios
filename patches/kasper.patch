+private func kasperSettingsEntries(state: KasperSettingsState) -> [KasperSettingsEntry] {
+    var entries: [KasperSettingsEntry] = []
+
+    entries.append(.ghostSection(state))
+    if state.isExpanded(.ghost) {
+        entries.append(.ghostFooter)
+    }
+
+    entries.append(.interfaceSection(state))
+    if state.isExpanded(.interface) {
+        entries.append(.interfaceFooter)
+    }
+
+    entries.append(.voiceSection(state))
+    if state.isExpanded(.voice) {
+        if state.voice != .none {
+            entries.append(.voiceCalls(state.voiceInCalls))
+        }
+        entries.append(.voiceFooter)
+    }
+
+    entries.append(.deletedSection(state))
+    if state.isExpanded(.deleted) {
+        entries.append(.deletedCount(state.deletedCaught))
+        entries.append(.deletedFooter)
+    }
+
+    entries.append(.nicknameInput(state.nickname))
+    entries.append(.nicknameFooter)
+
+    entries.append(.profileFooter)
+
+    entries.append(.about)
+
+    return entries
