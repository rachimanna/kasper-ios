+        case .male:
+            return ["Brian", "Adam", "Daniel", "George", "Antoni", "Liam", "Bill", "Josh"]
+        case .child:
+            return ["Mimi", "Gigi", "Elli", "Freya", "Lily"]
+        case .robot:
+            return ["George", "Daniel", "Adam", "Brian", "Antoni"]
+        case .pixel:
+            return ["Gigi", "Mimi", "Elli", "Alice", "Lily"]
+        case .echo:
+            return ["Sarah", "Brian", "Rachel", "Adam", "George"]
+        case .monster:
+            return ["Clyde", "Callum", "Arnold", "Patrick", "Bill", "Adam"]
+        case .oldMan:
+            return ["Michael", "Fin", "Giovanni", "Bill", "George"]
+        }
+    }
+
+    /// Если по именам ничего не нашлось — ищем по меткам голоса.
+    /// Пусто в поле значит «неважно».
+    public var elevenLabsLabels: (gender: String, age: String) {
+        switch self {
+        case .none:
+            return ("", "")
+        case .female, .echo:
+            return ("female", "")
+        case .child, .pixel:
+            return ("female", "young")
+        case .male, .robot:
+            return ("male", "")
+        case .monster:
+            return ("male", "middle_aged")
+        case .oldMan:
+            return ("male", "old")
+        }
+    }
+
+    /// Что Kasper доделывает на телефоне поверх голоса ElevenLabs.
+    /// Для обычных голосов — ничего: ElevenLabs уже выдал живой голос.
+    public var elevenLabsPostEffect: KasperVoice {
+        switch self {
+        case .none, .female, .male, .child, .oldMan:
+            return .none
+        case .robot, .pixel, .echo, .monster:
+            return self
+        }
+    }
+
+    /// Насколько двигать высоту в этой доработке. Голос ElevenLabs уже нужного тембра,
+    /// поэтому сдвиг делаем мягче, чем при обработке настоящего голоса.
+    public var elevenLabsPostPitch: Double? {
+        switch self {
+        case .monster:
+            return 0.82
+        case .robot:
+            return 0.95
+        default:
+            return nil
+        }
+    }
+
+    /// Поправка громкости после обработки.
+    public var outputGain: Float {
+        switch self {
+        case .none, .female, .child, .echo:
+            return 1.0
+        case .male:
+            return 1.08
+        case .robot:
+            return 0.9
+        case .pixel:
+            return 1.1
+        case .monster:
+            return 1.15
+        case .oldMan:
+            return 1.0
+        }
+    }
+}
+
+/// Kasper: файл в формате WAV (по типу или по расширению имени).
+func kasperIsWavFile(mimeType: String?, fileName: String?) -> Bool {
+    let type = (mimeType ?? "").lowercased()
+    if type == "audio/wav" || type == "audio/x-wav" || type == "audio/wave" || type == "audio/vnd.wave" {
+        return true
+    }
+    if let fileName = fileName, fileName.lowercased().hasSuffix(".wav") {
+        return true
+    }
+    return false
+}
