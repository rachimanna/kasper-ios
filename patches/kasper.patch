+/// Обычные разделы: строки берутся из `kasperPageRows`, переключатели сразу сохраняются.
+func kasperPageController(context: AccountContext, page: KasperPage) -> ViewController {
+    let navigation = KasperNavigation()
+    let refresh = ValuePromise<Int>(0, ignoreRepeated: false)
+    var tick = 0
+    let reload: () -> Void = {
+        tick += 1
+        refresh.set(tick)
+    }
+    if page == .player {
+        KasperPlayerState.shared.refresh(context: context, completion: reload)
+    }
+    let groups = refresh.get()
+    |> map { _ -> [KasperGroup] in
+        return kasperPageRows(page, context: context, navigation: navigation, reload: reload)
+    }
+    return kasperListController(context: context, title: page.title, navigation: navigation, groups: groups)
+}
