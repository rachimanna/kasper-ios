+// MARK: - Иконки
+
+enum KasperIconStyle {
+    static let changedNotification = Notification.Name("kasper.iconStyle.changed")
+
+    static func set(_ style: String) {
+        KasperSettings.iconStyle = style
+        NotificationCenter.default.post(name: changedNotification, object: nil)
+    }
+}
