+func kasperEditHistoryController(context: AccountContext) -> ViewController {
+    let navigation = KasperNavigation()
+    let formatter = DateFormatter()
+    formatter.locale = Locale(identifier: "ru_RU")
+    formatter.dateFormat = "d MMM, HH:mm"
+
+    let groups = kasperNotifications(KasperEditHistory.changedNotification)
+    |> map { _ -> [KasperGroup] in
+        let entries = KasperEditHistory.all()
+        guard !entries.isEmpty else {
+            return [[.text(id: "edits-empty", text: "Пока пусто. Когда собеседник изменит сообщение, здесь появится, что было написано до правки.")]]
+        }
+        var rows: KasperGroup = []
+        for (index, entry) in entries.prefix(150).enumerated() {
+            var title = entry.chat.isEmpty ? "Чат" : entry.chat
+            if !entry.author.isEmpty && entry.author != entry.chat {
+                title += " · \(entry.author)"
+            }
+            let date = formatter.string(from: Date(timeIntervalSince1970: entry.date))
+            let text = "Было: \(entry.oldText)\nСтало: \(entry.newText)\n\(date)"
+            rows.append(.detail(id: "edit-\(index)-\(entry.peerId)-\(entry.messageId)-\(Int(entry.date))", title: title, text: text, copy: entry.oldText))
+        }
+        return [
+            rows,
+            [
+                .text(id: "edits-hint", text: "Нажмите на правку, чтобы скопировать прежний текст."),
+                .action(id: "edits-clear", title: "Очистить историю", destructive: true, action: {
+                    KasperEditHistory.clear()
+                })
+            ]
+        ]
+    }
+    return kasperListController(context: context, title: "История изменений", navigation: navigation, groups: groups)
+}
