+// MARK: - VirusTotal
+
+func kasperVirusTotalController(context: AccountContext) -> ViewController {
+    let navigation = KasperNavigation()
+    let link = ValuePromise<String>("", ignoreRepeated: true)
+    var linkValue = ""
+    let busy = ValuePromise<String?>(nil, ignoreRepeated: true)
+    let checkDisposable = MetaDisposable()
+    let keyRefresh = ValuePromise<Int>(0, ignoreRepeated: false)
+    var keyTick = 0
+
+    let openUrl: (String) -> Void = { url in
+        context.sharedContext.applicationBindings.openUrl(url)
+    }
+    let finish: (String, Bool, String, Signal<KasperVirusTotalReport, KasperVirusTotalError>) -> Void = { title, isFile, webLink, signal in
+        busy.set(isFile ? "Проверяю файл…" : "Проверяю ссылку…")
+        checkDisposable.set((signal |> deliverOnMainQueue).start(next: { report in
+            busy.set(nil)
+            KasperVirusTotal.addToHistory(KasperVirusTotalCheck(title: title, isFile: isFile, link: webLink, report: report, date: Date().timeIntervalSince1970))
+            kasperAlert(context, navigation, title: title, text: report.verdict)
+        }, error: { error in
+            busy.set(nil)
+            kasperAlert(context, navigation, title: "Проверка не удалась", text: error.text)
+        }))
+    }
+
+    let checkLink: () -> Void = {
+        var url = linkValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !url.isEmpty else {
+            kasperAlert(context, navigation, title: nil, text: "Вставьте ссылку, которую нужно проверить.")
+            return
+        }
+        if !url.lowercased().hasPrefix("http://") && !url.lowercased().hasPrefix("https://") {
+            url = "https://" + url
+        }
+        finish(url, false, KasperVirusTotal.webLink(url: url), KasperVirusTotal.checkUrl(url, apiKey: KasperSettings.virusTotalKey))
+    }
+
+    let checkFile: () -> Void = {
+        kasperPickFile(context, navigation, types: ["public.item"], completion: { url in
+            guard let data = try? Data(contentsOf: url, options: .mappedIfSafe) else {
+                kasperAlert(context, navigation, title: nil, text: "Не удалось прочитать файл.")
+                return
+            }
+            let name = url.lastPathComponent
+            let hash = KasperVirusTotal.sha256(data)
+            let apiKey = KasperSettings.virusTotalKey
+            busy.set("Ищу файл в VirusTotal…")
+            checkDisposable.set((KasperVirusTotal.lookupFile(sha256: hash, apiKey: apiKey) |> deliverOnMainQueue).start(next: { report in
+                busy.set(nil)
+                KasperVirusTotal.addToHistory(KasperVirusTotalCheck(title: name, isFile: true, link: KasperVirusTotal.webLink(sha256: hash), report: report, date: Date().timeIntervalSince1970))
+                kasperAlert(context, navigation, title: name, text: report.verdict)
+            }, error: { error in
+                busy.set(nil)
