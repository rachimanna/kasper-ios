+/// Призрак: просим сервер считать нас офлайн. Telegram отмечает пользователя онлайн после
+/// отправки сообщения, поэтому сразу после отправки возвращаем статус обратно.
+func kasperPushOfflineStatus(network: Network) {
+    guard KasperSettings.ghostHideOnline else {
+        return
+    }
+    let sendOffline: () -> Void = {
+        let _ = (network.request(Api.functions.account.updateStatus(offline: .boolTrue))
+        |> `catch` { _ -> Signal<Api.Bool, NoError> in
+            return .single(.boolFalse)
+        }).start()
+    }
+    sendOffline()
+    // ответ сервера на отправку сообщения может прийти позже — повторяем через пару секунд
+    let _ = (Signal<Void, NoError>.single(Void())
+    |> delay(2.5, queue: Queue.concurrentDefaultQueue())).start(next: { _ in
+        sendOffline()
+    })
+}
+
+/// Сообщения, удалённые собеседником, остаются на телефоне с пометкой «🗑 Удалено».
+/// Возвращает глобальные id, которые нужно удалить обычным способом.
+func kasperKeepRemotelyDeletedMessages(transaction: Transaction, globalIds: [Int32]) -> [Int32] {
+    guard KasperSettings.keepDeletedMessages else {
+        return globalIds
+    }
+    var remaining: [Int32] = []
+    var caught = 0
+    for globalId in globalIds {
+        guard let messageId = transaction.messageIdsForGlobalIds([globalId]).first,
+              let message = transaction.getMessage(messageId),
+              message.flags.contains(.Incoming),
+              !KasperSettings.wasDeletedBySelf(messageId) else {
+            remaining.append(globalId)
+            continue
+        }
+        let namespace = messageId.peerId.namespace
+        let isPrivate = namespace == Namespaces.Peer.CloudUser
+        let isGroup = namespace == Namespaces.Peer.CloudGroup || namespace == Namespaces.Peer.CloudChannel
+        guard isPrivate || (isGroup && KasperSettings.keepDeletedInGroups) else {
+            remaining.append(globalId)
+            continue
+        }
+        if message.text.hasSuffix(KasperSettings.deletedMarker) {
+            // уже помечено: сервер может прислать удаление повторно
+            continue
+        }
+        let markedText: String
+        if message.text.isEmpty {
+            markedText = KasperSettings.deletedMarker
+        } else {
+            markedText = message.text + "\n\n" + KasperSettings.deletedMarker
+        }
+        transaction.updateMessage(messageId, update: { currentMessage in
+            var storeForwardInfo: StoreMessageForwardInfo?
+            if let forwardInfo = currentMessage.forwardInfo {
+                storeForwardInfo = StoreMessageForwardInfo(authorId: forwardInfo.author?.id, sourceId: forwardInfo.source?.id, sourceMessageId: forwardInfo.sourceMessageId, date: forwardInfo.date, authorSignature: forwardInfo.authorSignature, psaType: forwardInfo.psaType, flags: forwardInfo.flags)
+            }
+            return .update(StoreMessage(
+                id: currentMessage.id,
+                customStableId: nil,
+                globallyUniqueId: currentMessage.globallyUniqueId,
+                groupingKey: currentMessage.groupingKey,
+                threadId: currentMessage.threadId,
+                timestamp: currentMessage.timestamp,
+                flags: StoreMessageFlags(currentMessage.flags),
+                tags: currentMessage.tags,
+                globalTags: currentMessage.globalTags,
+                localTags: currentMessage.localTags,
+                forwardInfo: storeForwardInfo,
+                authorId: currentMessage.author?.id,
+                text: markedText,
+                attributes: currentMessage.attributes,
+                media: currentMessage.media
+            ))
+        })
+        caught += 1
+    }
+    if caught != 0 {
+        KasperSettings.deletedCaught += caught
+    }
+    return remaining
+}
