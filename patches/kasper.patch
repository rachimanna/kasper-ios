+        context.setFillColor(UIColor.white.cgColor)
+        context.fillPath()
+        context.addPath(lobe)
+        context.setStrokeColor(UIColor(rgb: 0x050506).cgColor)
+        context.setLineWidth(0.6)
+        context.setLineJoin(.round)
+        context.strokePath()
+    }
