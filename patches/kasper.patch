@@ -0,0 +1,46 @@
+import Foundation
+import UIKit
+import TelegramCore
+
+/// Ускорение анимаций интерфейса из раздела «Дополнительно».
+/// Меняет скорость Core Animation у окон Kasper; окна клавиатуры не трогаем,
+/// иначе она начинает дёргаться относительно поля ввода.
+final class KasperAnimationSpeed {
+    static let shared = KasperAnimationSpeed()
+
+    private var observers: [NSObjectProtocol] = []
+
+    func start() {
+        guard self.observers.isEmpty else {
+            return
+        }
+        let center = NotificationCenter.default
+        self.observers.append(center.addObserver(forName: UIWindow.didBecomeVisibleNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.apply()
+        }))
+        self.observers.append(center.addObserver(forName: KasperSettings.animationSpeedChangedNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.apply()
+        }))
+        DispatchQueue.main.async { [weak self] in
+            self?.apply()
+        }
+    }
+
+    private func apply() {
+        let speed = Float(KasperSettings.animationSpeed)
+        for scene in UIApplication.shared.connectedScenes {
+            guard let windowScene = scene as? UIWindowScene else {
+                continue
+            }
+            for window in windowScene.windows {
+                let className = NSStringFromClass(type(of: window))
+                if className.contains("Keyboard") || className.contains("TextEffects") {
+                    continue
+                }
+                if window.layer.speed != speed {
+                    window.layer.speed = speed
+                }
+            }
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Sources/Kasper/KasperElevenLabsRecording.swift b/submodules/TelegramUI/Sources/Kasper/KasperElevenLabsRecording.swift
new file mode 100644
index 0000000..bba3a3d
--- /dev/null
+++ b/submodules/TelegramUI/Sources/Kasper/KasperElevenLabsRecording.swift
@@ -0,0 +1,394 @@
+import Foundation
+import AudioToolbox
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import OpusBinding
+import AudioWaveform
+
+/// Реалистичные голоса Kasper: тот же список (женский, мужской, монстр…),
+/// но озвучивает его ElevenLabs, а не обработка на телефоне.
+///
+/// Запись идёт как обычно, чистым голосом. После остановки Kasper:
+/// 1. отправляет готовое голосовое (ogg/opus — оно уже сжато, поэтому уходит быстро);
+/// 2. получает ту же речь выбранным голосом в MP3 и раскодирует его в PCM 48 кГц;
+/// 3. для «эффектных» голосов (робот, пиксель, эхо, монстр) добавляет свой эффект сверху;
+/// 4. заново кодирует в opus и пересчитывает волну.
+///
+/// Ожидание ограничено `deadline`: если ElevenLabs не успел, отправляется запись
+/// с локальным эффектом. Настоящий голос не уходит ни при какой ошибке.
+enum KasperElevenLabsRecording {
+    private static let recordingSampleRate: Double = 48000.0
+    private static let frameSamples = 960 // 20 мс при 48 кГц — столько ждёт TGOggOpusWriter
+    /// Сколько ждём ElevenLabs, прежде чем отправить запись с локальным эффектом.
+    /// Короткое голосовое обрабатывается быстро, длинное — дольше, поэтому ждём соразмерно.
+    private static func deadline(for duration: Double) -> Double {
+        return min(20.0, max(8.0, duration * 1.2 + 4.0))
+    }
+
+    /// Своя последовательная очередь. Раньше тут была общая параллельная очередь, и
+    /// deliverOn на ней мог доставить «готово» раньше самого ответа: ответ терялся,
+    /// голосовое не отправлялось никогда, и помогал только перезапуск.
+    private static let workQueue = Queue(name: "org.kasper.elevenlabs")
+
+    private static let lock = NSLock()
+    private static var cacheKey: String?
+    private static var cacheResult: RecordedAudioData?
+    // takenRecordedData() подписываются несколько экранов сразу (отправка, предпрослушивание,
+    // обрезка). Без этого на одну запись уходило бы несколько запросов и несколько списаний.
+    private static var pending: [String: Promise<RecordedAudioData>] = [:]
+
+    static func process(_ data: RecordedAudioData) -> Signal<RecordedAudioData, NoError> {
+        let voice = KasperSettings.voice
+        let voiceId = KasperSettings.elevenLabsVoiceId(for: voice)
+        let apiKey = KasperSettings.elevenLabsApiKey
+        let key = "\(voiceId)|\(data.compressedData.count)|\(data.compressedData.hashValue)"
+
+        KasperElevenLabsRecording.lock.lock()
+        if KasperElevenLabsRecording.cacheKey == key, let cached = KasperElevenLabsRecording.cacheResult {
+            KasperElevenLabsRecording.lock.unlock()
+            return .single(KasperElevenLabsRecording.reuse(cached, for: data))
+        }
+        if let promise = KasperElevenLabsRecording.pending[key] {
+            KasperElevenLabsRecording.lock.unlock()
+            return promise.get()
+            |> take(1)
+            |> map { result in
+                return KasperElevenLabsRecording.reuse(result, for: data)
+            }
+        }
+        let promise = Promise<RecordedAudioData>()
+        KasperElevenLabsRecording.pending[key] = promise
+        KasperElevenLabsRecording.lock.unlock()
+
+        let queue = KasperElevenLabsRecording.workQueue
+
+        let deadline = KasperElevenLabsRecording.deadline(for: data.duration)
+        let converted = KasperElevenLabsRecording.convert(data, voice: voice, voiceId: voiceId, apiKey: apiKey, queue: queue)
+        let tooSlow = Signal<RecordedAudioData, NoError> { subscriber in
+            KasperSettings.elevenLabsLastError = "ElevenLabs не ответил за \(Int(deadline)) с — отправлено с обычным эффектом"
+            subscriber.putNext(KasperElevenLabsRecording.localEffect(data))
+            subscriber.putCompletion()
+            return EmptyDisposable
+        }
+        |> runOn(queue)
+
+        let limited = converted
+        |> timeout(deadline, queue: queue, alternate: tooSlow)
+
+        // Страховка: что бы ни случилось внутри, ответ будет ровно один. Если цепочка
+        // завершилась без результата, отправляем запись с обычным эффектом, а не висим.
+        let work = Signal<RecordedAudioData, NoError> { subscriber in
+            let delivered = Atomic<Bool>(value: false)
+            return limited.start(next: { result in
+                let _ = delivered.swap(true)
+                subscriber.putNext(result)
+            }, completed: {
+                if !delivered.swap(true) {
+                    KasperSettings.elevenLabsLastError = "Не удалось получить ответ ElevenLabs — отправлено с обычным эффектом"
+                    queue.async {
+                        subscriber.putNext(KasperElevenLabsRecording.localEffect(data))
+                        subscriber.putCompletion()
+                    }
+                } else {
+                    subscriber.putCompletion()
+                }
+            })
+        }
+        |> afterNext { result in
+            KasperElevenLabsRecording.lock.lock()
+            KasperElevenLabsRecording.cacheKey = key
+            KasperElevenLabsRecording.cacheResult = result
+            KasperElevenLabsRecording.pending.removeValue(forKey: key)
+            KasperElevenLabsRecording.lock.unlock()
+        }
+
+        promise.set(work)
+        return promise.get()
+        |> take(1)
+        |> map { result in
+            return KasperElevenLabsRecording.reuse(result, for: data)
+        }
+    }
+
+    /// Готовый результат под текущую запись: обрезка и данные паузы берутся у неё.
+    private static func reuse(_ result: RecordedAudioData, for data: RecordedAudioData) -> RecordedAudioData {
+        return RecordedAudioData(
+            compressedData: result.compressedData,
+            resumeData: data.resumeData,
+            duration: result.duration,
+            waveform: result.waveform,
+            trimRange: data.trimRange
+        )
+    }
+
+    private static func convert(_ data: RecordedAudioData, voice: KasperVoice, voiceId: String, apiKey: String, queue: Queue) -> Signal<RecordedAudioData, NoError> {
+        // Голосовое уже сжато в opus, поэтому отправляем его как есть: по мобильному
+        // интернету это в разы быстрее, чем гнать несжатый звук.
+        let opus = KasperElevenLabs.changeVoice(audio: data.compressedData, fileName: "voice.ogg", mimeType: "audio/ogg", voiceId: voiceId, apiKey: apiKey)
+
+        let request = opus
+        |> `catch` { error -> Signal<Data, KasperElevenLabsError> in
+            guard error.isFormatRejection else {
+                return .fail(error)
+            }
+            // ElevenLabs не принял ogg — пересылаем тем же, но в WAV.
+            return Signal<Data, KasperElevenLabsError> { subscriber in
+                guard let pcm = KasperElevenLabsRecording.decodeOpus(data.compressedData), !pcm.isEmpty else {
+                    subscriber.putError(.badResponse)
+                    return EmptyDisposable
+                }
+                subscriber.putNext(KasperElevenLabsRecording.makeWav(samples: KasperElevenLabsRecording.downsampleByThree(pcm), sampleRate: 16000))
+                subscriber.putCompletion()
+                return EmptyDisposable
+            }
+            |> runOn(queue)
+            |> mapToSignal { wav -> Signal<Data, KasperElevenLabsError> in
+                return KasperElevenLabs.changeVoice(audio: wav, fileName: "voice.wav", mimeType: "audio/wav", voiceId: voiceId, apiKey: apiKey)
+            }
+        }
+
+        return request
+        |> deliverOn(queue)
+        |> mapToSignal { mp3 -> Signal<RecordedAudioData, KasperElevenLabsError> in
+            guard var samples = KasperElevenLabsRecording.decodeCompressed(mp3, fileExtension: "mp3"), samples.count > KasperElevenLabsRecording.frameSamples else {
+                KasperSettings.elevenLabsLastError = "Не удалось раскодировать ответ ElevenLabs"
+                return .single(KasperElevenLabsRecording.localEffect(data))
+            }
+            let post = voice.elevenLabsPostEffect
+            if post != .none, let processor = KasperVoiceProcessor(voice: post, pitchOverride: voice.elevenLabsPostPitch) {
+                samples.withUnsafeMutableBufferPointer { buffer in
+                    if let base = buffer.baseAddress {
+                        processor.process(base, count: buffer.count)
+                    }
+                }
+            }
+            guard let encoded = KasperElevenLabsRecording.encode(samples: samples, source: data) else {
+                KasperSettings.elevenLabsLastError = "Не удалось собрать голосовое из ответа ElevenLabs"
+                return .single(KasperElevenLabsRecording.localEffect(data))
+            }
+            KasperSettings.elevenLabsLastError = ""
+            return .single(encoded)
+        }
+        |> `catch` { error -> Signal<RecordedAudioData, NoError> in
+            KasperSettings.elevenLabsLastError = error.text
+            return Signal<RecordedAudioData, NoError> { subscriber in
+                subscriber.putNext(KasperElevenLabsRecording.localEffect(data))
+                subscriber.putCompletion()
+                return EmptyDisposable
+            }
+            |> runOn(queue)
+        }
+    }
+
+    /// ElevenLabs не сработал: отправляем запись с обычным эффектом Kasper,
+    /// а не настоящим голосом.
+    private static func localEffect(_ source: RecordedAudioData) -> RecordedAudioData {
+        let voice = KasperSettings.voice
+        guard voice != .none, let processor = KasperVoiceProcessor(voice: voice), var samples = KasperElevenLabsRecording.decodeOpus(source.compressedData), !samples.isEmpty else {
+            return source
+        }
+        samples.withUnsafeMutableBufferPointer { buffer in
+            if let base = buffer.baseAddress {
+                processor.process(base, count: buffer.count)
+            }
+        }
+        return KasperElevenLabsRecording.encode(samples: samples, source: source) ?? source
+    }
+
+    // MARK: - Кодеки
+
+    /// Голосовое Telegram (ogg/opus) → PCM 48 кГц, моно.
+    private static func decodeOpus(_ data: Data) -> [Int16]? {
+        let path = NSTemporaryDirectory() + "kasper-el-\(UInt64.random(in: 0 ... UInt64.max)).ogg"
+        guard (try? data.write(to: URL(fileURLWithPath: path))) != nil else {
+            return nil
+        }
+        defer {
+            try? FileManager.default.removeItem(atPath: path)
+        }
+        guard let reader = OggOpusReader(path: path) else {
+            return nil
+        }
+        var result: [Int16] = []
+        result.reserveCapacity(data.count * 12)
+        let chunk = 5760
+        var buffer = [Int16](repeating: 0, count: chunk)
+        while true {
+            let read = buffer.withUnsafeMutableBytes { raw -> Int32 in
+                return reader.read(raw.baseAddress!, bufSize: Int32(chunk))
+            }
+            if read <= 0 {
+                break
+            }
+            result.append(contentsOf: buffer[0 ..< Int(read)])
+        }
+        return result
+    }
+
+    /// Ответ ElevenLabs (MP3) → PCM 48 кГц, моно. Раскодирует и пересчитывает частоту сама iOS.
+    private static func decodeCompressed(_ data: Data, fileExtension: String) -> [Int16]? {
+        let path = NSTemporaryDirectory() + "kasper-el-\(UInt64.random(in: 0 ... UInt64.max)).\(fileExtension)"
+        guard (try? data.write(to: URL(fileURLWithPath: path))) != nil else {
+            return nil
+        }
+        defer {
+            try? FileManager.default.removeItem(atPath: path)
+        }
+        var fileRef: ExtAudioFileRef?
+        guard ExtAudioFileOpenURL(URL(fileURLWithPath: path) as CFURL, &fileRef) == noErr, let file = fileRef else {
+            return nil
+        }
+        defer {
+            ExtAudioFileDispose(file)
+        }
+        var clientFormat = AudioStreamBasicDescription(
+            mSampleRate: KasperElevenLabsRecording.recordingSampleRate,
+            mFormatID: kAudioFormatLinearPCM,
+            mFormatFlags: kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked,
+            mBytesPerPacket: 2,
+            mFramesPerPacket: 1,
+            mBytesPerFrame: 2,
+            mChannelsPerFrame: 1,
+            mBitsPerChannel: 16,
+            mReserved: 0
+        )
+        guard ExtAudioFileSetProperty(file, kExtAudioFileProperty_ClientDataFormat, UInt32(MemoryLayout<AudioStreamBasicDescription>.size), &clientFormat) == noErr else {
+            return nil
+        }
+        var result: [Int16] = []
+        let chunkFrames = 8192
+        var chunk = [Int16](repeating: 0, count: chunkFrames)
+        while true {
+            var frames = UInt32(chunkFrames)
+            var failed = false
+            chunk.withUnsafeMutableBytes { raw in
+                var bufferList = AudioBufferList(
+                    mNumberBuffers: 1,
+                    mBuffers: AudioBuffer(mNumberChannels: 1, mDataByteSize: UInt32(chunkFrames * 2), mData: raw.baseAddress)
+                )
+                if ExtAudioFileRead(file, &frames, &bufferList) != noErr {
+                    failed = true
+                }
+            }
+            if failed {
+                return result.isEmpty ? nil : result
+            }
+            if frames == 0 {
+                break
+            }
+            result.append(contentsOf: chunk[0 ..< Int(frames)])
+        }
+        return result
+    }
+
+    private static func encode(samples: [Int16], source: RecordedAudioData) -> RecordedAudioData? {
+        let dataItem = TGDataItem()
+        let writer = TGOggOpusWriter()
+        guard writer.begin(with: dataItem) else {
+            return nil
+        }
+        var frame = [Int16](repeating: 0, count: KasperElevenLabsRecording.frameSamples)
+        var offset = 0
+        while offset < samples.count {
+            let count = min(KasperElevenLabsRecording.frameSamples, samples.count - offset)
+            for i in 0 ..< KasperElevenLabsRecording.frameSamples {
+                frame[i] = i < count ? samples[offset + i] : 0
+            }
+            let ok = frame.withUnsafeMutableBytes { raw -> Bool in
+                return writer.writeFrame(raw.baseAddress!.assumingMemoryBound(to: UInt8.self), frameByteCount: UInt(KasperElevenLabsRecording.frameSamples * 2))
+            }
+            if !ok {
+                return nil
+            }
+            offset += count
+        }
+        guard writer.writeFrame(nil, frameByteCount: 0) else {
+            return nil
+        }
+        return RecordedAudioData(
+            compressedData: dataItem.data(),
+            resumeData: source.resumeData,
+            duration: writer.encodedDuration(),
+            waveform: KasperElevenLabsRecording.waveform(samples),
+            trimRange: source.trimRange
+        )
+    }
+
+    /// Та же волна из 100 столбиков по 5 бит, что строит ManagedAudioRecorder.
+    private static func waveform(_ samples: [Int16]) -> Data {
+        var scaled = [Int16](repeating: 0, count: 100)
+        if !samples.isEmpty {
+            for i in 0 ..< samples.count {
+                var sample = samples[i]
+                if sample < 0 {
+                    sample = sample == Int16.min ? Int16.max : -sample
+                }
+                let index = min(99, i * 100 / samples.count)
+                if scaled[index] < sample {
+                    scaled[index] = sample
+                }
+            }
+        }
+        var sum: Int64 = 0
+        for value in scaled {
+            sum += Int64(value)
+        }
+        var calculatedPeak = UInt16(clamping: Int64(Double(sum) * 1.8 / 100.0))
+        if calculatedPeak < 2500 {
+            calculatedPeak = 2500
+        }
+        for i in 0 ..< 100 {
+            let sample = Int64(scaled[i])
+            let minPeak = min(sample, Int64(calculatedPeak))
+            scaled[i] = Int16(clamping: min(31, minPeak * 31 / Int64(calculatedPeak)))
+        }
+        let samplesData = scaled.withUnsafeBufferPointer { Data(buffer: $0) }
+        let bitstream = AudioWaveform(samples: samplesData, peak: 31).makeBitstream()
+        return AudioWaveform(bitstream: bitstream, bitsPerSample: 5).makeBitstream()
+    }
+
+    // MARK: - PCM
+
+    /// 48 кГц → 16 кГц: усредняем по три отсчёта, чтобы не было «звона».
+    private static func downsampleByThree(_ samples: [Int16]) -> [Int16] {
+        var result = [Int16](repeating: 0, count: samples.count / 3)
+        for i in 0 ..< result.count {
+            let a = Int32(samples[3 * i])
+            let b = Int32(samples[3 * i + 1])
+            let c = Int32(samples[3 * i + 2])
+            result[i] = Int16(clamping: (a + b + c) / 3)
+        }
+        return result
+    }
+
+    private static func makeWav(samples: [Int16], sampleRate: Int) -> Data {
+        var data = Data()
+        func append32(_ value: UInt32) {
+            var v = value.littleEndian
+            withUnsafeBytes(of: &v) { data.append(contentsOf: $0) }
+        }
+        func append16(_ value: UInt16) {
+            var v = value.littleEndian
+            withUnsafeBytes(of: &v) { data.append(contentsOf: $0) }
+        }
+        let byteCount = UInt32(samples.count * 2)
+        data.append(contentsOf: Array("RIFF".utf8))
+        append32(36 + byteCount)
+        data.append(contentsOf: Array("WAVE".utf8))
+        data.append(contentsOf: Array("fmt ".utf8))
+        append32(16)
+        append16(1) // PCM
+        append16(1) // моно
+        append32(UInt32(sampleRate))
+        append32(UInt32(sampleRate * 2))
+        append16(2)
+        append16(16)
+        data.append(contentsOf: Array("data".utf8))
+        append32(byteCount)
+        for sample in samples {
+            append16(UInt16(bitPattern: sample))
+        }
+        return data
+    }
+}
diff --git a/submodules/TelegramUI/Sources/Kasper/KasperScreenshotBadge.swift b/submodules/TelegramUI/Sources/Kasper/KasperScreenshotBadge.swift
new file mode 100644
index 0000000..52d65cf
--- /dev/null
+++ b/submodules/TelegramUI/Sources/Kasper/KasperScreenshotBadge.swift
@@ -0,0 +1,111 @@
+import Foundation
+import UIKit
+import TelegramCore
+
+/// Фирменная надпись Kasper на скриншотах.
+///
+/// iOS сообщает приложению о скриншоте уже ПОСЛЕ того, как снимок сделан,
+/// и изменить сохранённую системой картинку нельзя. Поэтому Kasper рисует
+/// свою копию экрана с фиолетовой надписью и свечением сверху и кладёт её
+/// в галерею рядом с обычным скриншотом.
+///
+/// Всё происходит на телефоне, никуда ничего не отправляется.
+public final class KasperScreenshotBadge {
+    public static let shared = KasperScreenshotBadge()
+
+    private var observer: NSObjectProtocol?
+    private var lastCapture: Double = 0.0
+
+    private init() {
+    }
+
+    public func start() {
+        guard self.observer == nil else {
+            return
+        }
+        self.observer = NotificationCenter.default.addObserver(
+            forName: UIApplication.userDidTakeScreenshotNotification,
+            object: nil,
+            queue: OperationQueue.main,
+            using: { [weak self] _ in
+                self?.capture()
+            }
+        )
+    }
+
+    private func capture() {
+        guard KasperSettings.screenshotBadge else {
+            return
+        }
+        // защита от повторов: iOS иногда присылает уведомление дважды
+        let now = CFAbsoluteTimeGetCurrent()
+        if now - self.lastCapture < 1.5 {
+            return
+        }
+        self.lastCapture = now
+
+        guard let window = KasperScreenshotBadge.frontmostWindow() else {
+            return
+        }
+        let bounds = window.bounds
+        guard bounds.width > 1.0 && bounds.height > 1.0 else {
+            return
+        }
+
+        let format = UIGraphicsImageRendererFormat()
+        let displayScale = window.traitCollection.displayScale
+        format.scale = displayScale > 0.0 ? displayScale : 2.0
+        format.opaque = true
+        let renderer = UIGraphicsImageRenderer(bounds: bounds, format: format)
+
+        let topInset = window.safeAreaInsets.top
+        let image = renderer.image { context in
+            UIColor.black.setFill()
+            context.fill(bounds)
+            window.drawHierarchy(in: bounds, afterScreenUpdates: false)
+            KasperScreenshotBadge.drawBadge(in: context.cgContext, width: bounds.width, top: topInset)
+        }
+
+        UIImageWriteToSavedPhotosAlbum(image, nil, nil, nil)
+    }
+
+    private static func frontmostWindow() -> UIWindow? {
+        var candidates: [UIWindow] = []
+        for scene in UIApplication.shared.connectedScenes {
+            guard let windowScene = scene as? UIWindowScene, windowScene.activationState == .foregroundActive else {
+                continue
+            }
+            candidates.append(contentsOf: windowScene.windows)
+        }
+        if candidates.isEmpty {
+            return nil
+        }
+        if let key = candidates.first(where: { $0.isKeyWindow }) {
+            return key
+        }
+        return candidates.filter({ !$0.isHidden }).max(by: { $0.windowLevel < $1.windowLevel })
+    }
+
+    private static func drawBadge(in context: CGContext, width: CGFloat, top: CGFloat) {
+        let text = "Kasper"
+        let purple = UIColor(red: 0.62, green: 0.36, blue: 0.98, alpha: 1.0)
+        let font = UIFont.systemFont(ofSize: 15.0, weight: .semibold)
+        let size = (text as NSString).size(withAttributes: [.font: font])
+        // надпись ставится в верхнюю безопасную зону, где обычно стоит статус-бар
+        let origin = CGPoint(x: (width - size.width) / 2.0, y: max(8.0, (top - size.height) / 2.0))
+
+        context.saveGState()
+        // мягкое свечение вокруг надписи
+        context.setShadow(offset: .zero, blur: 14.0, color: purple.withAlphaComponent(0.85).cgColor)
+        (text as NSString).draw(at: origin, withAttributes: [
+            .font: font,
+            .foregroundColor: purple
+        ])
+        context.setShadow(offset: .zero, blur: 5.0, color: UIColor.white.withAlphaComponent(0.5).cgColor)
+        (text as NSString).draw(at: origin, withAttributes: [
+            .font: font,
+            .foregroundColor: purple
+        ])
+        context.restoreGState()
+    }
+}
diff --git a/submodules/TelegramUI/Sources/Kasper/KasperVoiceEffect.swift b/submodules/TelegramUI/Sources/Kasper/KasperVoiceEffect.swift
new file mode 100644
index 0000000..fc5088c
--- /dev/null
+++ b/submodules/TelegramUI/Sources/Kasper/KasperVoiceEffect.swift
@@ -0,0 +1,180 @@
+import Foundation
+import TelegramCore
+
+/// Изменение голоса в голосовых сообщениях Kasper.
+///
+/// Обрабатывает поток записи (48 кГц, моно, Int16) прямо перед кодированием в opus,
+/// поэтому работает без задержек и не требует сторонних библиотек.
+/// Всё происходит на телефоне: наружу уходит уже изменённый голос.
+public final class KasperVoiceProcessor {
+    private let voice: KasperVoice
+
+    /// Частота записи голосовых в Telegram (ManagedAudioRecorder пишет 48 кГц).
+    /// Раньше константы ниже были посчитаны для 16 кГц, из-за чего окно сдвига высоты
+    /// было в 3 раза короче (13 мс) — отсюда «металлический» и неестественный звук.
+    static let sampleRate: Double = 48000.0
+
+    // Сдвиг высоты голоса: кольцевой буфер с двумя считывающими головками.
+    private static let bufferSize = 8192
+    // 40 мс — как в обработке звонков (KasperCallVoice.h)
+    private static let windowSize: Double = KasperVoiceProcessor.sampleRate / 25.0
+    private var buffer = [Float](repeating: 0.0, count: KasperVoiceProcessor.bufferSize)
+    private var writePosition: Int = 0
+    private var readPhase: Double = 0.0
+    private var ratio: Double
+    private let baseRatio: Double
+
+    // Робот: кольцевая модуляция.
+    private var modulatorPhase: Double = 0.0
+
+    // Пиксель: огрубление сигнала.
+    private var holdValue: Float = 0.0
+    private var holdCounter: Int = 0
+
+    // Монстр: рычание. Старик: дрожь в голосе.
+    private var growlPhase: Double = 0.0
+    private var vibratoPhase: Double = 0.0
+
+    // Эхо.
+    private var echoBuffer: [Float]
+    private var echoPosition: Int = 0
+
+    /// `pitchOverride` задаёт свой сдвиг высоты вместо стандартного для этого голоса.
+    /// Нужен, когда эффект накладывается поверх готового голоса ElevenLabs:
+    /// тембр уже нужный, и двигать высоту надо мягче.
+    public init?(voice: KasperVoice, pitchOverride: Double? = nil) {
+        guard voice != .none else {
+            return nil
+        }
+        self.voice = voice
+        let ratio = pitchOverride ?? voice.pitchRatio
+        self.ratio = ratio
+        self.baseRatio = ratio
+        self.echoBuffer = [Float](repeating: 0.0, count: Int(KasperVoiceProcessor.sampleRate * 0.28))
+    }
+
+    private func sample(at delay: Double) -> Float {
+        let position = Double(self.writePosition) - delay
+        var index = position
+        let size = Double(KasperVoiceProcessor.bufferSize)
+        while index < 0.0 {
+            index += size
+        }
+        while index >= size {
+            index -= size
+        }
+        let i0 = Int(index)
+        let i1 = (i0 + 1) % KasperVoiceProcessor.bufferSize
+        let fraction = Float(index - Double(i0))
+        return self.buffer[i0] * (1.0 - fraction) + self.buffer[i1] * fraction
+    }
+
+    /// Сдвиг высоты без изменения длительности: две головки чтения с плавным перекрытием.
+    private func pitchShifted(_ input: Float) -> Float {
+        self.buffer[self.writePosition] = input
+        self.writePosition = (self.writePosition + 1) % KasperVoiceProcessor.bufferSize
+        if self.ratio == 1.0 {
+            // высота не меняется — пропускаем звук как есть, без окрашивания
+            return input
+        }
+
+        let window = KasperVoiceProcessor.windowSize
+        self.readPhase -= self.ratio - 1.0
+        if self.readPhase >= window {
+            self.readPhase -= window
+        } else if self.readPhase < 0.0 {
+            self.readPhase += window
+        }
+
+        let phase1 = self.readPhase
+        let phase2 = phase1 < window / 2.0 ? phase1 + window / 2.0 : phase1 - window / 2.0
+        let gain1 = Float(sin(Double.pi * phase1 / window))
+        let gain2 = Float(sin(Double.pi * phase2 / window))
+        return self.sample(at: phase1) * gain1 + self.sample(at: phase2) * gain2
+    }
+
+    private func robot(_ input: Float) -> Float {
+        self.modulatorPhase += 2.0 * Double.pi * 95.0 / KasperVoiceProcessor.sampleRate
+        if self.modulatorPhase > 2.0 * Double.pi {
+            self.modulatorPhase -= 2.0 * Double.pi
+        }
+        let modulated = input * Float(0.45 + 0.55 * sin(self.modulatorPhase))
+        return modulated * 1.4
+    }
+
+    private func pixel(_ input: Float) -> Float {
+        // частота дискретизации ниже + грубые уровни громкости = звук старой приставки
+        if self.holdCounter == 0 {
+            let levels: Float = 14.0
+            self.holdValue = (input * levels).rounded() / levels
+            self.holdCounter = max(1, Int(KasperVoiceProcessor.sampleRate / 5300.0))
+        } else {
+            self.holdCounter -= 1
+        }
+        return self.holdValue
+    }
+
+    private func echo(_ input: Float) -> Float {
+        let delayed = self.echoBuffer[self.echoPosition]
+        let value = input + delayed * 0.45
+        self.echoBuffer[self.echoPosition] = value
+        self.echoPosition = (self.echoPosition + 1) % self.echoBuffer.count
+        return input * 0.75 + delayed * 0.55
+    }
+
+    private func monster(_ input: Float) -> Float {
+        // низкое рычание поверх уже сниженного голоса
+        self.growlPhase += 2.0 * Double.pi * 28.0 / KasperVoiceProcessor.sampleRate
+        if self.growlPhase > 2.0 * Double.pi {
+            self.growlPhase -= 2.0 * Double.pi
+        }
+        let growled = input * Float(0.78 + 0.22 * sin(self.growlPhase))
+        // мягкое ограничение добавляет хрип
+        return tanh(growled * 1.6) * 0.8
+    }
+
+    private func oldManRatio() -> Double {
+        // голос слегка «плавает», как у пожилого человека
+        self.vibratoPhase += 2.0 * Double.pi * 5.5 / KasperVoiceProcessor.sampleRate
+        if self.vibratoPhase > 2.0 * Double.pi {
+            self.vibratoPhase -= 2.0 * Double.pi
+        }
+        return self.baseRatio * (1.0 + 0.014 * sin(self.vibratoPhase))
+    }
+
+    /// Обрабатывает пачку сэмплов на месте.
+    public func process(_ samples: UnsafeMutablePointer<Int16>, count: Int) {
+        guard count > 0 else {
+            return
+        }
+        for i in 0 ..< count {
+            var value = Float(samples[i]) / 32768.0
+
+            switch self.voice {
+            case .none:
+                break
+            case .female, .male, .child:
+                value = self.pitchShifted(value)
+            case .robot:
+                value = self.robot(self.pitchShifted(value))
+            case .pixel:
+                value = self.pixel(self.pitchShifted(value))
+            case .echo:
+                value = self.echo(value)
+            case .monster:
+                value = self.monster(self.pitchShifted(value))
+            case .oldMan:
+                self.ratio = self.oldManRatio()
+                value = self.pitchShifted(value) * Float(0.9 + 0.1 * sin(self.vibratoPhase))
+            }
+
+            value *= self.voice.outputGain
+            if value > 1.0 {
+                value = 1.0
+            } else if value < -1.0 {
+                value = -1.0
+            }
+            samples[i] = Int16(value * 32767.0)
+        }
+    }
+}
