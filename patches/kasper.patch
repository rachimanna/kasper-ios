+func kasperSearchController(context: AccountContext) -> ViewController {
+    let navigation = KasperNavigation()
+    let query = ValuePromise<String>("", ignoreRepeated: true)
+
+    let groups = query.get()
+    |> map { text -> [KasperGroup] in
+        var groups: [KasperGroup] = [[
+            .input(id: "query", title: "🔍", placeholder: "Что найти?", value: text, set: { value in
+                query.set(value)
+            })
+        ]]
+        let needle = text.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        guard !needle.isEmpty else {
+            groups.append([.text(id: "hint", text: "Например: призрак, удалённые, голос, прокси, ID.")])
+            return groups
+        }
+        let found = kasperSearchTargets.filter { target in
+            return target.title.lowercased().contains(needle) || target.keywords.lowercased().contains(needle) || target.page.title.lowercased().contains(needle)
+        }
+        if found.isEmpty {
+            groups.append([.text(id: "nothing", text: "Ничего не найдено.")])
+        } else {
+            var rows: KasperGroup = []
+            for (index, target) in found.prefix(30).enumerated() {
+                let path = target.page.isReady ? target.page.title : "\(target.page.title) · скоро"
+                rows.append(.link(id: "result-\(index)-\(target.title)", title: target.title, subtitle: path, symbol: target.page.symbol, badge: nil, action: {
+                    if target.title == "Проверить обновления" {
+                        navigation.push(kasperAboutController(context: context))
+                    } else {
+                        kasperOpen(target.page, context: context, navigation: navigation)
+                    }
+                }))
+            }
+            groups.append(rows)
+        }
+        return groups
+    }
+    return kasperListController(context: context, title: "Поиск настроек", navigation: navigation, groups: groups)
+}
