+// Kasper: логотип вместо стандартного самолётика Telegram.
+- (void)kasperAddLogoToView:(UIView *)hostView size:(CGFloat)size
+{
+    [_kasperLogoView removeFromSuperview];
+    
+    UIView *container = [[UIView alloc] initWithFrame:CGRectMake(0.0, 0.0, size, size)];
+    container.backgroundColor = _backgroundColor;
+    container.userInteractionEnabled = false;
+    container.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    
+    CGFloat circleSize = floor(size * 0.72);
+    UIView *circle = [[UIView alloc] initWithFrame:CGRectMake(floor((size - circleSize) / 2.0), floor((size - circleSize) / 2.0), circleSize, circleSize)];
+    circle.layer.cornerRadius = circleSize / 2.0;
+    circle.layer.masksToBounds = true;
+    
+    CAGradientLayer *gradient = [CAGradientLayer layer];
+    gradient.frame = circle.bounds;
+    gradient.colors = @[
+        (id)[UIColor colorWithRed:0.15 green:0.15 blue:0.17 alpha:1.0].CGColor,
+        (id)[UIColor colorWithRed:0.02 green:0.02 blue:0.024 alpha:1.0].CGColor
+    ];
+    gradient.startPoint = CGPointMake(0.0, 0.0);
+    gradient.endPoint = CGPointMake(1.0, 1.0);
+    [circle.layer addSublayer:gradient];
+    
+    // Знак Kasper: три белых завитка, как на иконке приложения
+    CALayer *swirl = [CALayer layer];
+    swirl.frame = circle.bounds;
+    CGMutablePathRef lobe = CGPathCreateMutable();
+    CGPathMoveToPoint(lobe, NULL, 292, 330);
+    CGPathAddCurveToPoint(lobe, NULL, 285, 212, 378, 138, 492, 146);
+    CGPathAddCurveToPoint(lobe, NULL, 618, 156, 682, 262, 650, 368);
+    CGPathAddCurveToPoint(lobe, NULL, 624, 448, 574, 492, 558, 538);
+    CGPathAddCurveToPoint(lobe, NULL, 548, 570, 514, 584, 494, 562);
+    CGPathAddCurveToPoint(lobe, NULL, 478, 544, 484, 504, 500, 472);
+    CGPathAddCurveToPoint(lobe, NULL, 516, 440, 530, 410, 530, 372);
+    CGPathAddCurveToPoint(lobe, NULL, 532, 318, 492, 288, 446, 292);
