+            self.kasperPresenceDisposable.set(nil)
+            self.kasperSetOnline(false)
+            return
+        }
+        let isOnline: Signal<Bool, NoError> = context.engine.data.subscribe(TelegramEngine.EngineData.Item.Peer.Presence(id: peerId))
+        |> mapToSignal { presence -> Signal<Bool, NoError> in
+            guard let presence, case let .present(until) = presence.status else {
+                return .single(false)
+            }
+            let now = Int32(Date().timeIntervalSince1970)
+            if until <= now {
+                return .single(false)
+            }
+            // точка гаснет сама, когда закончится срок «в сети»
+            let remaining = Double(min(until - now, 86400))
+            let goesOffline: Signal<Bool, NoError> = Signal<Bool, NoError>.single(false)
+            |> delay(remaining, queue: Queue.mainQueue())
+            return Signal<Bool, NoError>.single(true)
+            |> then(goesOffline)
+        }
+        |> distinctUntilChanged
+        |> deliverOnMainQueue
+        self.kasperPresenceDisposable.set(isOnline.start(next: { [weak self] value in
+            self?.kasperSetOnline(value)
+        }))
+    }
+    
+    private func kasperSetOnline(_ isOnline: Bool) {
+        guard isOnline else {
+            self.kasperOnlineView?.isHidden = true
+            return
+        }
+        let onlineView: UIView
+        if let current = self.kasperOnlineView {
+            onlineView = current
+        } else {
+            onlineView = UIView()
+            onlineView.isUserInteractionEnabled = false
+            onlineView.backgroundColor = UIColor(rgb: 0x34c759)
+            onlineView.layer.borderWidth = 2.0
+            self.kasperOnlineView = onlineView
+            self.containerNode.view.addSubview(onlineView)
+        }
+        let size: CGFloat = 13.0
+        onlineView.frame = CGRect(x: self.containerNode.bounds.width - size - 2.0, y: self.containerNode.bounds.height - size - 2.0, width: size, height: size)
+        onlineView.layer.cornerRadius = size * 0.5
+        onlineView.layer.borderColor = self.kasperOnlineBorderColor.cgColor
+        onlineView.isHidden = false
+        self.containerNode.view.bringSubviewToFront(onlineView)
+    }
