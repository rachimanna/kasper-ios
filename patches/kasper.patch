diff --git a/submodules/TelegramCore/Sources/Kasper/KasperTextFormatting.swift b/submodules/TelegramCore/Sources/Kasper/KasperTextFormatting.swift
new file mode 100644
index 0000000..a1b2c3d
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Kasper/KasperTextFormatting.swift
@@ -0,0 +1,120 @@
+import Foundation
+import Postbox
+import TelegramApi
+
+/// Kasper: форматирование текста сообщений.
+/// Добавляет entities (bold, italic, mono и т.д.), чтобы получатели видели
+/// стиль текста, а не только автор. Работает как обёртка над стандартным
+/// Telegram text entity API: клиент отправляет сообщение с entities,
+/// и сервер сохраняет и доставляет их в первозданном виде.
+public enum KasperTextFormatting {
+    /// Оборачивает весь текст в жирный стиль.
+    public static func bold(_ text: String) -> (String, [MessageTextEntity]) {
+        let entity = MessageTextEntity(
+            range: 0 ..< text.utf16.count,
+            type: .Bold
+        )
+        return (text, [entity])
+    }
+
+    /// Оборачивает весь текст в курсив.
+    public static func italic(_ text: String) -> (String, [MessageTextEntity]) {
+        let entity = MessageTextEntity(
+            range: 0 ..< text.utf16.count,
+            type: .Italic
+        )
+        return (text, [entity])
+    }
+
+    /// Оборачивает весь текст в моноширинный шрифт.
+    public static func mono(_ text: String) -> (String, [MessageTextEntity]) {
+        let entity = MessageTextEntity(
+            range: 0 ..< text.utf16.count,
+            type: .Code
+        )
+        return (text, [entity])
+    }
+
+    /// Оборачивает весь текст в зачёркнутый стиль.
+    public static func strikethrough(_ text: String) -> (String, [MessageTextEntity]) {
+        let entity = MessageTextEntity(
+            range: 0 ..< text.utf16.count,
+            type: .Strikethrough
+        )
+        return (text, [entity])
+    }
+
+    /// Оборачивает весь текст в подчёркнутый стиль.
+    public static func underline(_ text: String) -> (String, [MessageTextEntity]) {
+        let entity = MessageTextEntity(
+            range: 0 ..< text.utf16.count,
+            type: .Underline
+        )
+        return (text, [entity])
+    }
+
+    /// Оборачивает текст в спойлер.
+    public static func spoiler(_ text: String) -> (String, [MessageTextEntity]) {
+        let entity = MessageTextEntity(
+            range: 0 ..< text.utf16.count,
+            type: .Spoiler
+        )
+        return (text, [entity])
+    }
+
+    /// Парсит Markdown-синтаксис из текста и возвращает entities.
+    /// Поддерживает: **bold**, *italic*, `code`, ~~strikethrough~~, __underline__, ||spoiler||
+    public static func parseMarkdown(_ text: String) -> (String, [MessageTextEntity]) {
+        var result = text
+        var entities: [MessageTextEntity] = []
+
+        let patterns: [(String, String, MessageTextEntityType)] = [
+            ("\\*\\*(.+?)\\*\\*", "**", .Bold),
+            ("\\*(.+?)\\*", "*", .Italic),
+            ("`(.+?)`", "`", .Code),
+            ("~~(.+?)~~", "~~", .Strikethrough),
+            ("__(.+?)__", "__", .Underline),
+            ("\\|\\|(.+?)\\|\\|", "||", .Spoiler)
+        ]
+
+        for (pattern, marker, entityType) in patterns {
+            guard let regex = try? NSRegularExpression(pattern: pattern, options: []) else {
+                continue
+            }
+            var offset = 0
+            let matches = regex.matches(in: result, options: [], range: NSRange(location: 0, length: result.utf16.count))
+            for match in matches {
+                guard match.numberOfRanges >= 2 else { continue }
+                let fullRange = match.range
+                let innerRange = match.range(at: 1)
+
+                let adjustedFull = NSRange(location: fullRange.location - offset, length: fullRange.length)
+                let markerLen = marker.utf16.count
+
+                guard let fullSwiftRange = Range(adjustedFull, in: result) else { continue }
+                let inner = String(result[fullSwiftRange]).dropFirst(markerLen).dropLast(markerLen)
+                result.replaceSubrange(fullSwiftRange, with: inner)
+
+                let entityStart = adjustedFull.location
+                let entityLength = innerRange.length
+                entities.append(MessageTextEntity(
+                    range: entityStart ..< (entityStart + entityLength),
+                    type: entityType
+                ))
+
+                offset += markerLen * 2
+            }
+        }
+
+        return (result, entities)
+    }
+
+    /// Применяет текущий стиль Kasper Font к исходящему сообщению.
+    /// Если шрифт Bold — всё сообщение уходит bold entity.
+    /// Если Italic — italic entity. Иначе — без изменений.
+    public static func applyCurrentStyle(_ text: String) -> (String, [MessageTextEntity]) {
+        let defaults = UserDefaults.standard
+        let fontName = defaults.string(forKey: "kasper.font.name") ?? ""
+        let fontWeight = defaults.string(forKey: "kasper.font.weight") ?? ""
+        if fontWeight.lowercased().contains("bold") || fontName.lowercased().contains("bold") {
+            return bold(text)
+        }
+        if fontWeight.lowercased().contains("italic") || fontName.lowercased().contains("italic") {
+            return italic(text)
+        }
+        return (text, [])
+    }
+}
