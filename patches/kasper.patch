+import Foundation
+import Postbox
+
+/// Стиль, которым Kasper оформляет исходящие текстовые сообщения.
+public enum KasperTextStyle: String, CaseIterable {
+    case plain = ""
+    case bold
+    case italic
+    case mono
+    case strikethrough
+    case underline
+    case spoiler
+
+    public var title: String {
+        switch self {
+        case .plain: return "Обычный"
+        case .bold: return "Жирный"
+        case .italic: return "Курсив"
+        case .mono: return "Моноширинный"
+        case .strikethrough: return "Зачёркнутый"
+        case .underline: return "Подчёркнутый"
+        case .spoiler: return "Спойлер"
+        }
+    }
+
+    var entityType: MessageTextEntityType? {
+        switch self {
+        case .plain: return nil
+        case .bold: return .Bold
+        case .italic: return .Italic
+        case .mono: return .Code
+        case .strikethrough: return .Strikethrough
+        case .underline: return .Underline
+        case .spoiler: return .Spoiler
+        }
+    }
+
+    /// Выбранный в настройках стиль исходящих сообщений.
+    public static var current: KasperTextStyle {
+        get { return KasperTextStyle(rawValue: KasperSettings.outgoingTextStyle) ?? .plain }
+        set { KasperSettings.outgoingTextStyle = newValue.rawValue }
+    }
+}
+
+/// Kasper: форматирование исходящих сообщений.
+/// Стиль передаётся обычными entities Telegram (как при ручном выделении текста),
+/// поэтому получатели видят его в любом клиенте.
+public enum KasperTextFormatting {
+    /// Добавляет к сообщению длиной `length` (в UTF-16) entity выбранного стиля на весь текст.
+    /// Разметка, которую пользователь сделал сам, сохраняется.
+    public static func applyOutgoingStyle(length: Int, entities: [MessageTextEntity]) -> [MessageTextEntity] {
+        return self.apply(KasperTextStyle.current, length: length, entities: entities)
+    }
+
+    public static func apply(_ style: KasperTextStyle, length: Int, entities: [MessageTextEntity]) -> [MessageTextEntity] {
+        guard length > 0, let type = style.entityType else {
+            return entities
+        }
+        if style == .mono && !entities.isEmpty {
+            // Моноширинный текст не может содержать ссылки, упоминания и эмодзи —
+            // не ломаем их и оставляем сообщение как есть.
+            return entities
+        }
+        for entity in entities {
+            if entity.type == type && entity.range.lowerBound <= 0 && entity.range.upperBound >= length {
+                return entities
+            }
+        }
+        var result = entities
+        result.append(MessageTextEntity(range: 0 ..< length, type: type))
+        return result
+    }
+}
