+import Foundation
+import CryptoKit
+import SwiftSignalKit
+
+/// Результат проверки VirusTotal: сколько антивирусов что сказали.
+public struct KasperVirusTotalReport: Codable, Equatable {
+    public let malicious: Int
+    public let suspicious: Int
+    public let harmless: Int
+    public let undetected: Int
+    /// Анализ ещё идёт — числа пока неполные.
+    public let pending: Bool
+
+    public var total: Int {
+        return self.malicious + self.suspicious + self.harmless + self.undetected
+    }
+
+    public var isDangerous: Bool {
+        return self.malicious > 0 || self.suspicious > 0
+    }
+
+    public var verdict: String {
+        if self.pending && self.total == 0 {
+            return "⏳ Проверка ещё идёт — загляните через минуту"
+        }
+        if self.malicious > 0 {
+            return "⛔️ Опасно: \(self.malicious) из \(self.total) антивирусов"
+        }
+        if self.suspicious > 0 {
+            return "⚠️ Подозрительно: \(self.suspicious) из \(self.total) антивирусов"
+        }
+        return "✅ Чисто: 0 из \(self.total) антивирусов"
+    }
+}
+
+public enum KasperVirusTotalError: Error, Equatable {
+    case noKey
+    case notFound
+    case tooLarge
+    case network(String)
+    case http(Int, String)
+    case badResponse
+
+    public var text: String {
+        switch self {
+        case .noKey:
+            return "Не указан ключ VirusTotal"
+        case .notFound:
+            return "VirusTotal ещё не видел этот объект"
+        case .tooLarge:
+            return "Файл больше 32 МБ — такой через бесплатный ключ не проверить"
+        case let .network(message):
+            return "Нет связи с VirusTotal: \(message)"
+        case let .http(code, message):
+            switch code {
+            case 401:
+                return "Ключ VirusTotal не подходит"
+            case 429:
+                return "Лимит бесплатного ключа: не больше 4 проверок в минуту"
+            default:
+                return message.isEmpty ? "Ошибка VirusTotal (\(code))" : "Ошибка VirusTotal (\(code)): \(message)"
+            }
+        case .badResponse:
+            return "VirusTotal вернул непонятный ответ"
+        }
+    }
+}
+
+/// Запись в истории проверок.
+public struct KasperVirusTotalCheck: Codable, Equatable {
+    public let title: String
+    public let isFile: Bool
+    public let link: String
+    public let report: KasperVirusTotalReport
+    public let date: Double
+
+    public init(title: String, isFile: Bool, link: String, report: KasperVirusTotalReport, date: Double) {
+        self.title = title
+        self.isFile = isFile
+        self.link = link
+        self.report = report
+        self.date = date
+    }
+}
+
+/// Клиент VirusTotal API v3. Запросы идут с телефона с ключом пользователя.
+public enum KasperVirusTotal {
+    private static let base = "https://www.virustotal.com/api/v3"
+    public static let maxUploadSize = 32 * 1024 * 1024
+
+    private static let session: URLSession = {
+        let configuration = URLSessionConfiguration.default
+        configuration.timeoutIntervalForRequest = 30.0
+        configuration.timeoutIntervalForResource = 120.0
+        return URLSession(configuration: configuration)
+    }()
+
+    // MARK: Запросы
+
+    private static func request(_ request: URLRequest) -> Signal<[String: Any], KasperVirusTotalError> {
+        return Signal { subscriber in
+            let task = session.dataTask(with: request, completionHandler: { data, response, error in
+                if let error = error {
+                    if (error as NSError).code != NSURLErrorCancelled {
+                        subscriber.putError(.network(error.localizedDescription))
+                    }
+                    return
+                }
+                guard let response = response as? HTTPURLResponse else {
+                    subscriber.putError(.badResponse)
+                    return
+                }
+                let json = data.flatMap { try? JSONSerialization.jsonObject(with: $0) as? [String: Any] }
+                if response.statusCode == 404 {
+                    subscriber.putError(.notFound)
+                    return
+                }
+                guard (200 ..< 300).contains(response.statusCode) else {
+                    let message = ((json?["error"] as? [String: Any])?["message"] as? String) ?? ""
+                    subscriber.putError(.http(response.statusCode, message))
+                    return
+                }
+                guard let json = json else {
+                    subscriber.putError(.badResponse)
+                    return
+                }
+                subscriber.putNext(json)
+                subscriber.putCompletion()
+            })
+            task.resume()
+            return ActionDisposable {
+                task.cancel()
+            }
+        }
+    }
+
+    private static func makeRequest(_ path: String, apiKey: String, method: String = "GET") -> URLRequest {
+        var request = URLRequest(url: URL(string: base + path)!)
+        request.httpMethod = method
+        request.setValue(apiKey, forHTTPHeaderField: "x-apikey")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        return request
+    }
+
+    private static func report(fromStats stats: [String: Any]?, pending: Bool) -> KasperVirusTotalReport {
+        return KasperVirusTotalReport(
+            malicious: (stats?["malicious"] as? Int) ?? 0,
+            suspicious: (stats?["suspicious"] as? Int) ?? 0,
+            harmless: (stats?["harmless"] as? Int) ?? 0,
+            undetected: (stats?["undetected"] as? Int) ?? 0,
+            pending: pending
+        )
+    }
+
+    private static func objectReport(_ json: [String: Any]) -> KasperVirusTotalReport {
+        let attributes = (json["data"] as? [String: Any])?["attributes"] as? [String: Any]
+        return report(fromStats: attributes?["last_analysis_stats"] as? [String: Any], pending: false)
+    }
+
+    /// Результат анализа по его id. Бесплатный ключ даёт 4 запроса в минуту,
+    /// поэтому ждём по 20 секунд и сдаёмся после трёх попыток — с частичным результатом.
+    private static func pollAnalysis(id: String, apiKey: String, attempt: Int = 0) -> Signal<KasperVirusTotalReport, KasperVirusTotalError> {
+        return request(makeRequest("/analyses/\(id)", apiKey: apiKey))
+        |> mapToSignal { json -> Signal<KasperVirusTotalReport, KasperVirusTotalError> in
+            let attributes = (json["data"] as? [String: Any])?["attributes"] as? [String: Any]
+            let completed = (attributes?["status"] as? String) == "completed"
+            let current = report(fromStats: attributes?["stats"] as? [String: Any], pending: !completed)
+            if completed || attempt >= 2 {
+                return .single(current)
+            }
+            return pollAnalysis(id: id, apiKey: apiKey, attempt: attempt + 1)
+            |> delay(20.0, queue: Queue.concurrentDefaultQueue())
+        }
+    }
+
+    // MARK: Ссылки
+
+    /// Идентификатор ссылки в VirusTotal: base64url без «=» в конце.
+    private static func urlIdentifier(_ url: String) -> String {
+        return Data(url.utf8).base64EncodedString()
+            .replacingOccurrences(of: "+", with: "-")
+            .replacingOccurrences(of: "/", with: "_")
+            .replacingOccurrences(of: "=", with: "")
+    }
+
+    /// Уже известный VirusTotal отчёт о ссылке. notFound — её ещё никто не проверял.
+    public static func lookupUrl(_ url: String, apiKey: String) -> Signal<KasperVirusTotalReport, KasperVirusTotalError> {
+        guard !apiKey.isEmpty else {
+            return .fail(.noKey)
+        }
+        return request(makeRequest("/urls/\(urlIdentifier(url))", apiKey: apiKey))
+        |> map { json in
+            return objectReport(json)
+        }
+    }
+
+    /// Полная проверка ссылки: берём готовый отчёт, а если его нет — отправляем на анализ.
+    public static func checkUrl(_ url: String, apiKey: String) -> Signal<KasperVirusTotalReport, KasperVirusTotalError> {
+        return lookupUrl(url, apiKey: apiKey)
+        |> `catch` { error -> Signal<KasperVirusTotalReport, KasperVirusTotalError> in
+            guard case .notFound = error else {
+                return .fail(error)
+            }
+            var submit = makeRequest("/urls", apiKey: apiKey, method: "POST")
+            submit.setValue("application/x-www-form-urlencoded", forHTTPHeaderField: "Content-Type")
+            let encoded = url.addingPercentEncoding(withAllowedCharacters: .alphanumerics) ?? url
+            submit.httpBody = "url=\(encoded)".data(using: .utf8)
+            return request(submit)
+            |> mapToSignal { json -> Signal<KasperVirusTotalReport, KasperVirusTotalError> in
+                guard let id = (json["data"] as? [String: Any])?["id"] as? String else {
+                    return .fail(.badResponse)
+                }
+                return pollAnalysis(id: id, apiKey: apiKey)
+                |> delay(15.0, queue: Queue.concurrentDefaultQueue())
+            }
+        }
+    }
+
+    public static func webLink(url: String) -> String {
+        let query = url.addingPercentEncoding(withAllowedCharacters: .alphanumerics) ?? url
+        return "https://www.virustotal.com/gui/search/\(query)"
+    }
+
+    // MARK: Файлы
+
+    public static func sha256(_ data: Data) -> String {
+        return SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+
+    public static func webLink(sha256: String) -> String {
+        return "https://www.virustotal.com/gui/file/\(sha256)"
+    }
+
+    /// Отчёт о файле по его хэшу — сам файл никуда не уходит.
+    public static func lookupFile(sha256: String, apiKey: String) -> Signal<KasperVirusTotalReport, KasperVirusTotalError> {
+        guard !apiKey.isEmpty else {
+            return .fail(.noKey)
+        }
+        return request(makeRequest("/files/\(sha256)", apiKey: apiKey))
+        |> map { json in
+            return objectReport(json)
+        }
+    }
+
+    /// Загружает файл на анализ. Файл становится доступен сообществу VirusTotal,
+    /// поэтому вызывать только после явного согласия пользователя.
+    public static func uploadFile(data: Data, name: String, apiKey: String) -> Signal<KasperVirusTotalReport, KasperVirusTotalError> {
+        guard !apiKey.isEmpty else {
+            return .fail(.noKey)
+        }
+        guard data.count <= maxUploadSize else {
+            return .fail(.tooLarge)
+        }
+        var upload = makeRequest("/files", apiKey: apiKey, method: "POST")
+        let boundary = "KasperVT\(UInt64.random(in: 0 ... UInt64.max))"
+        upload.setValue("multipart/form-data; boundary=\(boundary)", forHTTPHeaderField: "Content-Type")
+        var body = Data()
+        let safeName = name.replacingOccurrences(of: "\"", with: "")
+        body.append("--\(boundary)\r\nContent-Disposition: form-data; name=\"file\"; filename=\"\(safeName)\"\r\nContent-Type: application/octet-stream\r\n\r\n".data(using: .utf8)!)
+        body.append(data)
+        body.append("\r\n--\(boundary)--\r\n".data(using: .utf8)!)
+        upload.httpBody = body
+        return request(upload)
+        |> mapToSignal { json -> Signal<KasperVirusTotalReport, KasperVirusTotalError> in
+            guard let id = (json["data"] as? [String: Any])?["id"] as? String else {
+                return .fail(.badResponse)
+            }
+            return pollAnalysis(id: id, apiKey: apiKey)
+            |> delay(20.0, queue: Queue.concurrentDefaultQueue())
+        }
+    }
+
+    // MARK: История
+
+    public static let historyChangedNotification = Notification.Name("kasper.virustotal.history")
+    private static let historyKey = "kasper.vt.history"
+    private static let historyLock = NSLock()
+
+    public static func history() -> [KasperVirusTotalCheck] {
+        historyLock.lock()
+        defer {
+            historyLock.unlock()
+        }
+        guard let data = UserDefaults.standard.data(forKey: historyKey), let items = try? JSONDecoder().decode([KasperVirusTotalCheck].self, from: data) else {
+            return []
+        }
+        return items
+    }
+
+    public static func addToHistory(_ check: KasperVirusTotalCheck) {
+        historyLock.lock()
+        var items: [KasperVirusTotalCheck] = []
+        if let data = UserDefaults.standard.data(forKey: historyKey), let decoded = try? JSONDecoder().decode([KasperVirusTotalCheck].self, from: data) {
+            items = decoded
+        }
+        items.insert(check, at: 0)
+        if items.count > 50 {
+            items.removeLast(items.count - 50)
+        }
+        if let data = try? JSONEncoder().encode(items) {
+            UserDefaults.standard.set(data, forKey: historyKey)
+        }
+        historyLock.unlock()
+        DispatchQueue.main.async {
+            NotificationCenter.default.post(name: historyChangedNotification, object: nil)
+        }
+    }
+
+    public static func clearHistory() {
+        historyLock.lock()
+        UserDefaults.standard.removeObject(forKey: historyKey)
+        historyLock.unlock()
+        NotificationCenter.default.post(name: historyChangedNotification, object: nil)
+    }
+
+    // MARK: Автопроверка ссылок из чатов
+
+    private static let approvedLock = NSLock()
+    private static var approved: Set<String> = []
+
+    /// Нужно ли проверить ссылку перед открытием. Ссылки Telegram не проверяем.
+    public static func shouldAutoCheck(_ url: String) -> Bool {
+        guard KasperSettings.virusTotalAutoCheck, !KasperSettings.virusTotalKey.isEmpty else {
+            return false
+        }
+        let lower = url.lowercased()
+        guard lower.hasPrefix("http://") || lower.hasPrefix("https://") else {
+            return false
+        }
+        if let host = URL(string: url)?.host?.lowercased() {
+            let trusted = ["t.me", "telegram.me", "telegram.org", "telegra.ph", "telesco.pe"]
+            if trusted.contains(where: { host == $0 || host.hasSuffix("." + $0) }) {
+                return false
+            }
+        }
+        approvedLock.lock()
+        let isApproved = approved.remove(url) != nil
+        approvedLock.unlock()
+        return !isApproved
+    }
+
+    /// Разрешить следующее открытие этой ссылки без проверки (после ответа пользователя).
+    public static func approveOnce(_ url: String) {
+        approvedLock.lock()
+        approved.insert(url)
+        approvedLock.unlock()
+    }
+}
