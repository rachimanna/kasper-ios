+/// Открывает раздел: свой экран Kasper или готовый экран Telegram, где функция уже есть.
+func kasperOpen(_ page: KasperPage, context: AccountContext, navigation: KasperNavigation) {
+    guard page.isReady else {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        navigation.present(textAlertController(context: context, title: page.title, text: "Раздел в разработке и появится в одном из следующих обновлений Kasper.", actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]))
+        return
+    }
+    switch page {
+    case .search:
+        navigation.push(kasperSearchController(context: context))
+    case .notifications:
+        navigation.push(notificationsAndSoundsController(context: context, exceptionsList: nil))
+    case .translate:
+        navigation.push(translationSettingsController(context: context))
+    case .sessions:
+        navigation.push(recentSessionsController(context: context, activeSessionsContext: context.engine.privacy.activeSessions(), webSessionsContext: context.engine.privacy.webSessions(), websitesOnly: false))
+    case .voice:
+        navigation.push(kasperAllSettingsController(context: context, voiceOnly: true))
+    case .all:
+        navigation.push(kasperAllSettingsController(context: context, voiceOnly: false))
+    case .info:
+        navigation.push(kasperInfoController(context: context))
+    case .radio:
+        navigation.push(kasperRadioController(context: context))
+    case .virustotal:
+        navigation.push(kasperVirusTotalController(context: context))
+    case .plugins:
+        navigation.push(kasperPluginsController(context: context))
+    case .fonts:
+        navigation.push(kasperFontsController(context: context))
+    default:
+        navigation.push(kasperPageController(context: context, page: page))
+    }
+}
