+/// Раздел Kasper в настройках Telegram.
+public func kasperSettingsController(context: AccountContext) -> ViewController {
+    let navigation = KasperNavigation()
+
+    let groups = combineLatest(kasperNotifications(KasperSettings.localStarsChangedNotification), kasperNotifications(KasperRadio.changedNotification), kasperNotifications(KasperIconStyle.changedNotification))
+    |> map { _, _, _ -> [KasperGroup] in
+        var sections: KasperGroup = []
+        for page in KasperPage.allCases {
+            sections.append(.link(id: "page-\(page.rawValue)", title: page.title, subtitle: page.subtitle, symbol: page.symbol, badge: nil, action: {
+                kasperOpen(page, context: context, navigation: navigation)
+            }))
+        }
+        return [
+            [.header(title: "Kasper", version: kasperHeaderSubtitle())],
+            [.link(id: "about", title: "О Kasper", subtitle: "Версия, исходный код, разработчик", symbol: "person.fill", badge: nil, action: {
+                navigation.push(kasperAboutController(context: context))
+            })],
+            sections
+        ]
+    }
+    return kasperListController(context: context, title: "", navigation: navigation, groups: groups)
+}
