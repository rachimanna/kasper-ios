+// MARK: - Строки экранов
+
+/// Одна строка на экране Kasper. Экраны собираются из этих строк, поэтому все
+/// разделы выглядят одинаково, а поиск знает, где какая настройка лежит.
+enum KasperRow {
+    case header(title: String, version: String)
+    case sectionTitle(id: String, text: String)
+    case link(id: String, title: String, subtitle: String?, symbol: String?, badge: String?, action: () -> Void)
+    case toggle(id: String, title: String, value: Bool, enabled: Bool, set: (Bool) -> Void)
+    case info(id: String, title: String, value: String, copy: String?)
+    case input(id: String, title: String, placeholder: String, value: String, set: (String) -> Void)
+    case text(id: String, text: String)
+    case choice(id: String, title: String, selected: Bool, action: () -> Void)
+    case secret(id: String, title: String, placeholder: String, value: String, set: (String) -> Void)
+    case detail(id: String, title: String, text: String, copy: String?)
+    case action(id: String, title: String, destructive: Bool, action: () -> Void)
+
+    var id: String {
+        switch self {
+        case .header:
+            return "header"
+        case let .sectionTitle(id, _), let .link(id, _, _, _, _, _), let .toggle(id, _, _, _, _), let .info(id, _, _, _), let .input(id, _, _, _, _), let .text(id, _), let .choice(id, _, _, _), let .detail(id, _, _, _), let .action(id, _, _, _), let .secret(id, _, _, _, _):
+            return id
+        }
+    }
+
+    /// Всё, что видно на экране: по нему список понимает, изменилась ли строка.
+    var signature: String {
+        switch self {
+        case let .header(title, version):
+            return "h|\(title)|\(version)"
+        case let .sectionTitle(_, text):
+            return "s|\(text)"
+        case let .link(_, title, subtitle, symbol, badge, _):
+            return "l|\(title)|\(subtitle ?? "")|\(symbol ?? "")|\(badge ?? "")|\(KasperSettings.iconStyle)"
+        case let .toggle(_, title, value, enabled, _):
+            return "t|\(title)|\(value)|\(enabled)"
+        case let .info(_, title, value, copy):
+            return "i|\(title)|\(value)|\(copy != nil)"
+        case let .input(_, title, placeholder, value, _):
+            return "n|\(title)|\(placeholder)|\(value)"
+        case let .text(_, text):
+            return "x|\(text)"
+        case let .choice(_, title, selected, _):
+            return "c|\(title)|\(selected)"
+        case let .secret(_, title, placeholder, value, _):
+            return "k|\(title)|\(placeholder)|\(value)"
+        case let .detail(_, title, text, copy):
+            return "d|\(title)|\(text)|\(copy != nil)"
+        case let .action(_, title, destructive, _):
+            return "a|\(title)|\(destructive)"
+        }
+    }
+}
+
+typealias KasperGroup = [KasperRow]
+
+private struct KasperEntry: ItemListNodeEntry {
+    let order: Int32
+    let section: ItemListSectionId
+    let row: KasperRow
+
+    var stableId: String {
+        return self.row.id
+    }
+
+    static func ==(lhs: KasperEntry, rhs: KasperEntry) -> Bool {
+        return lhs.order == rhs.order && lhs.section == rhs.section && lhs.row.signature == rhs.row.signature
+    }
+
+    static func <(lhs: KasperEntry, rhs: KasperEntry) -> Bool {
+        return lhs.order < rhs.order
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let iconColor = presentationData.theme.list.itemPrimaryTextColor
+        switch self.row {
+        case let .header(title, version):
+            return KasperHeaderItem(presentationData: presentationData, title: title, version: version, sectionId: self.section)
+        case let .sectionTitle(_, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .link(_, title, subtitle, symbol, badge, action):
+            let icon = symbol.flatMap { KasperIconCache.icon($0, color: iconColor) }
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: icon, title: title, titleBadge: badge, label: subtitle ?? "", labelStyle: subtitle == nil ? .text : .multilineDetailText, sectionId: self.section, style: .blocks, disclosureStyle: .arrow, action: {
+                action()
+            })
+        case let .toggle(_, title, value, enabled, set):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, enabled: enabled, maximumNumberOfLines: 2, sectionId: self.section, style: .blocks, updated: { value in
+                set(value)
+            })
+        case let .info(_, title, value, copy):
+            var action: (() -> Void)?
+            if let copy = copy {
+                action = {
+                    UIPasteboard.general.string = copy
+                }
+            }
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: value, sectionId: self.section, style: .blocks, disclosureStyle: .none, action: action)
+        case let .input(_, title, placeholder, value, set):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: title, textColor: presentationData.theme.list.itemPrimaryTextColor), text: value, placeholder: placeholder, type: .regular(capitalization: false, autocorrection: false), spacing: 12.0, clearType: .always, sectionId: self.section, textUpdated: { value in
+                set(value)
+            }, action: {
+            })
+        case let .text(_, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .secret(_, title, placeholder, value, set):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: title, textColor: presentationData.theme.list.itemPrimaryTextColor), text: value, placeholder: placeholder, type: .password, spacing: 12.0, clearType: .always, sectionId: self.section, textUpdated: { value in
+                set(value)
+            }, processPaste: { text in
+                return text.trimmingCharacters(in: .whitespacesAndNewlines)
+            }, action: {
+            })
+        case let .choice(_, title, selected, action):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: selected, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                action()
+            })
+        case let .detail(_, title, text, copy):
+            var action: (() -> Void)?
+            if let copy = copy {
+                action = {
+                    UIPasteboard.general.string = copy
+                }
+            }
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: text, labelStyle: .multilineDetailText, sectionId: self.section, style: .blocks, disclosureStyle: .none, action: action)
+        case let .action(_, title, destructive, action):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: destructive ? .destructive : .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                action()
+            })
+        }
+    }
+}
+
+/// Сигнал, который срабатывает сразу и потом при каждом таком уведомлении —
+/// чтобы экран обновлялся, когда настройка меняется в другом месте.
+func kasperNotifications(_ name: Notification.Name) -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main, using: { _ in
+            subscriber.putNext(Void())
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+/// Число с пробелами между разрядами: 1 250 000.
+func kasperFormatNumber(_ value: Int) -> String {
+    let formatter = NumberFormatter()
+    formatter.numberStyle = .decimal
+    formatter.groupingSeparator = " "
+    formatter.usesGroupingSeparator = true
+    return formatter.string(from: NSNumber(value: value)) ?? "\(value)"
+}
+
+/// Строка версии в шапке; если включены локальные звёзды — рядом их баланс.
+private func kasperHeaderSubtitle() -> String {
+    if KasperSettings.showLocalStars && KasperSettings.localStars > 0 {
+        let balance = KasperSettings.localStars
+        let formatted = kasperFormatNumber(balance)
+        let tier = balance >= 10000 ? "🌟" : "⭐"
+        return "\(KasperAbout.versionString)  ·  \(tier) \(formatted) Stars"
+    }
+    return KasperAbout.versionString
+}
+
+/// Иконки рисуются один раз на цвет темы, а не при каждом обновлении списка.
+private enum KasperIconCache {
+    // Строки списка собираются не только на главном потоке, поэтому кэш под замком.
+    private static let lock = NSLock()
+    private static var cache: [String: UIImage] = [:]
+
+    static func icon(_ symbol: String, color: UIColor) -> UIImage? {
+        let colored = KasperSettings.iconStyle == "color"
+        let key = "\(symbol)|\(color.hashValue)|\(colored)"
+        lock.lock()
+        let cached = cache[key]
+        lock.unlock()
+        if let cached = cached {
+            return cached
+        }
+        let image = colored ? kasperColoredSectionIcon(symbol) : kasperSectionIcon(symbol, color: color)
+        if let image = image {
+            lock.lock()
+            cache[key] = image
+            lock.unlock()
+        }
+        return image
+    }
+}
+
+/// Держит слабую ссылку на экран, чтобы строки могли открывать другие экраны.
+final class KasperNavigation {
+    weak var controller: ViewController?
+
+    func push(_ controller: ViewController) {
+        (self.controller?.navigationController as? NavigationController)?.pushViewController(controller)
+    }
+
+    func present(_ controller: ViewController) {
+        self.controller?.present(controller, in: .window(.root))
+    }
+}
+
+/// Экран Kasper из групп строк. Каждая группа — отдельная скруглённая карточка.
+func kasperListController(context: AccountContext, title: String, navigation: KasperNavigation, groups: Signal<[KasperGroup], NoError>) -> ViewController {
+    let signal = combineLatest(queue: .mainQueue(), context.sharedContext.presentationData, groups)
+    |> map { presentationData, groups -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let listPresentationData = ItemListPresentationData(presentationData)
+        let controllerState = ItemListControllerState(presentationData: listPresentationData, title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        var entries: [KasperEntry] = []
+        var order: Int32 = 0
+        for (index, group) in groups.enumerated() {
+            for row in group {
+                entries.append(KasperEntry(order: order, section: Int32(index), row: row))
+                order += 1
+            }
+        }
+        let listState = ItemListNodeState(presentationData: listPresentationData, entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, KasperNoArguments()))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    navigation.controller = controller
+    return controller
+}
