@@ -0,0 +1,139 @@
+import Foundation
+import UIKit
+
+/// Знак Kasper (три завитка, как на иконке приложения), нарисованный кодом —
+/// чтобы не тащить в сборку отдельную картинку и красить его в цвет темы.
+func kasperLogoImage(size: CGFloat, color: UIColor) -> UIImage {
+    let renderer = UIGraphicsImageRenderer(size: CGSize(width: size, height: size))
+    return renderer.image { _ in
+        // Завитки занимают область примерно 208...811 из 1024 — вписываем её в квадрат.
+        let origin: CGFloat = 199.0
+        let span: CGFloat = 620.0
+        let scale = size / span
+        func pt(_ x: CGFloat, _ y: CGFloat) -> CGPoint {
+            return CGPoint(x: (x - origin) * scale, y: (y - origin) * scale)
+        }
+        color.setFill()
+        do {
