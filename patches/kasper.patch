+// MARK: - Контроллер
+
+/// Полный список настроек Kasper на одном экране («Все настройки»).
+/// С `voiceOnly` показывает только смену голоса — это экран раздела «Смена голоса».
+func kasperAllSettingsController(context: AccountContext, voiceOnly: Bool) -> ViewController {
+    var initialState = KasperSettingsState.current()
+    if voiceOnly {
+        // в отдельном разделе голос всегда раскрыт, это не меняет сохранённое состояние
+        initialState.expanded.insert(KasperSection.voice.rawValue)
+    }
+    let statePromise = ValuePromise(initialState, ignoreRepeated: true)
+    let stateValue = Atomic(value: initialState)
+    let updateState: ((KasperSettingsState) -> KasperSettingsState) -> Void = { f in
+        statePromise.set(stateValue.modify { f($0) })
+    }
+
+    let voicesDisposable = MetaDisposable()
+    let keyDebounceDisposable = MetaDisposable()
+    /// Спрашивает у ElevenLabs библиотеку голосов и подбирает каждому голосу Kasper свой.
+    let matchElevenLabsVoices: () -> Void = {
+        let key = KasperSettings.elevenLabsApiKey
+        guard !key.isEmpty else {
+            voicesDisposable.set(nil)
+            updateState { state in
+                var state = state
+                state.elevenLabsStatus = .idle
+                return state
+            }
+            return
+        }
+        updateState { state in
+            var state = state
+            state.elevenLabsStatus = .loading
+            return state
+        }
+        voicesDisposable.set((KasperElevenLabs.voices(apiKey: key)
+        |> deliverOnMainQueue).start(next: { library in
+            guard !library.isEmpty else {
+                updateState { state in
+                    var state = state
+                    state.elevenLabsStatus = .error("На аккаунте ElevenLabs нет доступных голосов")
+                    return state
+                }
+                return
+            }
+            var ids: [String: String] = [:]
+            var names: [String: String] = [:]
+            for voice in KasperVoice.allCases where voice != .none {
+                if let match = KasperElevenLabs.match(voice: voice, in: library) {
+                    ids[voice.rawValue] = match.id
+                    names[voice.rawValue] = match.name
+                }
+            }
+            KasperSettings.elevenLabsVoiceMap = ids
+            KasperSettings.elevenLabsNameMap = names
+            KasperSettings.elevenLabsLastError = ""
+            updateState { state in
+                var state = state
+                state.elevenLabsNames = names
+                state.elevenLabsLastError = ""
+                state.elevenLabsStatus = .idle
+                return state
+            }
+        }, error: { error in
+            updateState { state in
+                var state = state
+                state.elevenLabsStatus = .error(error.text)
+                return state
+            }
+        }))
+    }
+
+    let arguments = KasperSettingsControllerArguments(
+        toggleSection: { section in
+            if voiceOnly && section == .voice {
+                return
+            }
+            updateState { state in
+                var state = state
+                if state.expanded.contains(section.rawValue) {
+                    state.expanded.remove(section.rawValue)
+                } else {
+                    state.expanded.insert(section.rawValue)
+                }
+                KasperSettings.expandedSections = state.expanded
+                return state
+            }
+        },
+        updateGhost: { value in
+            KasperSettings.ghostEnabled = value
+            updateState { state in
+                var state = state
+                state.hideOnline = value
+                state.hideReadReceipts = value
+                state.hideTyping = value
+                state.hideListened = value
+                return state
+            }
+        },
+        updateGhostOption: { option, value in
+            switch option {
+            case .online:
+                KasperSettings.ghostHideOnline = value
+            case .read:
+                KasperSettings.ghostHideReadReceipts = value
+            case .typing:
+                KasperSettings.ghostHideTyping = value
+            case .listened:
+                KasperSettings.ghostHideListened = value
+            }
+            updateState { state in
+                var state = state
+                switch option {
+                case .online:
+                    state.hideOnline = value
+                case .read:
+                    state.hideReadReceipts = value
+                case .typing:
+                    state.hideTyping = value
+                case .listened:
+                    state.hideListened = value
+                }
+                return state
+            }
+        },
+        updateKeepDeleted: { value in
+            KasperSettings.keepDeletedMessages = value
+            updateState { state in
+                var state = state
+                state.keepDeleted = value
+                return state
+            }
+        },
+        updateKeepDeletedInGroups: { value in
+            KasperSettings.keepDeletedInGroups = value
+            updateState { state in
+                var state = state
+                state.keepDeletedInGroups = value
+                return state
+            }
+        },
+        updateVoice: { value in
+            KasperSettings.voice = value
+            updateState { state in
+                var state = state
+                state.voice = value
+                return state
+            }
+            if value != .none && KasperSettings.realisticVoice && !KasperSettings.elevenLabsApiKey.isEmpty && KasperSettings.elevenLabsVoiceId(for: value).isEmpty {
+                matchElevenLabsVoices()
+            }
+        },
+        updateVoiceInCalls: { value in
+            KasperSettings.voiceInCalls = value
+            updateState { state in
+                var state = state
+                state.voiceInCalls = value
+                return state
+            }
+        },
+        updateRealisticVoice: { value in
+            KasperSettings.realisticVoice = value
+            KasperSettings.elevenLabsLastError = ""
+            updateState { state in
+                var state = state
+                state.realisticVoice = value
+                state.elevenLabsLastError = ""
+                return state
+            }
+            if value && KasperSettings.elevenLabsVoiceMap.isEmpty {
+                matchElevenLabsVoices()
+            }
+        },
+        updateElevenLabsApiKey: { value in
+            KasperSettings.elevenLabsApiKey = value
+            KasperSettings.elevenLabsLastError = ""
+            updateState { state in
+                var state = state
+                state.elevenLabsApiKey = value
+                state.elevenLabsLastError = ""
+                return state
+            }
+            // ждём, пока ключ вставят или допечатают, и только потом спрашиваем ElevenLabs
+            keyDebounceDisposable.set((Signal<Void, NoError>.single(Void())
+            |> delay(0.8, queue: Queue.mainQueue())).start(next: { _ in
+                matchElevenLabsVoices()
+            }))
+        },
+        reloadElevenLabsVoices: {
+            matchElevenLabsVoices()
+        },
+        updateNickname: { value in
+            let cleaned = value.trimmingCharacters(in: .whitespacesAndNewlines)
+            KasperSettings.localNickname = cleaned
+            updateState { state in
+                var state = state
+                state.nickname = value
+                return state
+            }
+        },
+        updateInterface: { option, value in
+            switch option {
+            case .profileTab:
+                KasperSettings.profileTab = value
+            case .legacyGlass:
+                KasperSettings.legacyGlass = value
+            case .watermarkVideoNotes:
+                KasperSettings.watermarkVideoNotes = value
+            case .screenshotBadge:
+                KasperSettings.screenshotBadge = value
+            }
+            updateState { state in
+                var state = state
+                switch option {
+                case .profileTab:
+                    state.profileTab = value
+                case .legacyGlass:
+                    state.legacyGlass = value
+                case .watermarkVideoNotes:
+                    state.watermarkVideoNotes = value
+                case .screenshotBadge:
+                    state.screenshotBadge = value
+                }
+                return state
+            }
+        },
+        updateAllInterface: { value in
+            KasperSettings.profileTab = value
+            KasperSettings.legacyGlass = value
+            KasperSettings.watermarkVideoNotes = value
+            KasperSettings.screenshotBadge = value
+            updateState { state in
+                var state = state
+                state.profileTab = value
+                state.legacyGlass = value
+                state.watermarkVideoNotes = value
+                state.screenshotBadge = value
+                return state
+            }
+        }
+    )
+
+    let signal = combineLatest(queue: .mainQueue(), context.sharedContext.presentationData, statePromise.get())
+    |> map { presentationData, state -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(voiceOnly ? "Смена голоса" : "Все настройки"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: kasperSettingsEntries(state: state, voiceOnly: voiceOnly), style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    if initialState.realisticVoice && !initialState.elevenLabsApiKey.isEmpty && KasperSettings.elevenLabsVoiceMap.isEmpty {
+        matchElevenLabsVoices()
+    }
+    return controller
+}
