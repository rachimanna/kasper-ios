+            node.contentSize = layout.contentSize
+            node.insets = layout.insets
+            Queue.mainQueue().async {
+                completion(node, {
+                    return (nil, { _ in apply() })
+                })
+            }
+        }
+    }
+
+    func updateNode(async: @escaping (@escaping () -> Void) -> Void, node: @escaping () -> ListViewItemNode, params: ListViewItemLayoutParams, previousItem: ListViewItem?, nextItem: ListViewItem?, animation: ListViewItemUpdateAnimation, completion: @escaping (ListViewItemNodeLayout, @escaping (ListViewItemApply) -> Void) -> Void) {
+        Queue.mainQueue().async {
+            guard let nodeValue = node() as? KasperHeaderItemNode else {
+                return
+            }
+            let makeLayout = nodeValue.asyncLayout()
+            async {
+                let (layout, apply) = makeLayout(self, params)
+                Queue.mainQueue().async {
+                    completion(layout, { _ in
+                        apply()
+                    })
+                }
+            }
+        }
+    }
+}
+
+final class KasperHeaderItemNode: ListViewItemNode {
+    private let logoNode: ASImageNode
+    private let titleNode: TextNode
+    private let versionNode: TextNode
+    private var currentTheme: PresentationTheme?
+
+    init() {
+        self.logoNode = ASImageNode()
+        self.logoNode.displaysAsynchronously = false
+        self.logoNode.isLayerBacked = true
+        self.titleNode = TextNode()
+        self.titleNode.isUserInteractionEnabled = false
+        self.versionNode = TextNode()
+        self.versionNode.isUserInteractionEnabled = false
+
+        super.init(layerBacked: false)
+
+        self.addSubnode(self.logoNode)
+        self.addSubnode(self.titleNode)
+        self.addSubnode(self.versionNode)
+    }
+
+    func asyncLayout() -> (_ item: KasperHeaderItem, _ params: ListViewItemLayoutParams) -> (ListViewItemNodeLayout, () -> Void) {
+        let makeTitleLayout = TextNode.asyncLayout(self.titleNode)
+        let makeVersionLayout = TextNode.asyncLayout(self.versionNode)
+        let currentTheme = self.currentTheme
+
+        return { [weak self] item, params in
+            let theme = item.presentationData.theme
+            let logoSize: CGFloat = 104.0
+            let width = params.width - params.leftInset - params.rightInset
+
+            let (titleLayout, titleApply) = makeTitleLayout(TextNodeLayoutArguments(attributedString: NSAttributedString(string: item.title, font: Font.bold(34.0), textColor: theme.list.itemPrimaryTextColor), backgroundColor: nil, maximumNumberOfLines: 1, truncationType: .end, constrainedSize: CGSize(width: width - 32.0, height: 60.0), alignment: .center, cutout: nil, insets: UIEdgeInsets()))
+            let (versionLayout, versionApply) = makeVersionLayout(TextNodeLayoutArguments(attributedString: NSAttributedString(string: item.version, font: Font.semibold(20.0), textColor: theme.list.itemSecondaryTextColor), backgroundColor: nil, maximumNumberOfLines: 1, truncationType: .end, constrainedSize: CGSize(width: width - 32.0, height: 40.0), alignment: .center, cutout: nil, insets: UIEdgeInsets()))
+
+            let topInset: CGFloat = 24.0
+            let height = topInset + logoSize + 22.0 + titleLayout.size.height + 4.0 + versionLayout.size.height + 18.0
+            let layout = ListViewItemNodeLayout(contentSize: CGSize(width: params.width, height: height), insets: UIEdgeInsets())
+
+            return (layout, {
+                guard let strongSelf = self else {
+                    return
+                }
+                if currentTheme !== theme {
+                    strongSelf.currentTheme = theme
+                    strongSelf.logoNode.image = kasperLogoImage(size: logoSize, color: theme.list.itemPrimaryTextColor)
+                }
+                let _ = titleApply()
+                let _ = versionApply()
+
+                strongSelf.logoNode.frame = CGRect(x: floor((params.width - logoSize) / 2.0), y: topInset, width: logoSize, height: logoSize)
+                let titleY = topInset + logoSize + 22.0
+                strongSelf.titleNode.frame = CGRect(x: floor((params.width - titleLayout.size.width) / 2.0), y: titleY, width: titleLayout.size.width, height: titleLayout.size.height)
+                strongSelf.versionNode.frame = CGRect(x: floor((params.width - versionLayout.size.width) / 2.0), y: titleY + titleLayout.size.height + 4.0, width: versionLayout.size.width, height: versionLayout.size.height)
+            })
+        }
+    }
+}
