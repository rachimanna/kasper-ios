+        static let legacyGlass = "kasper.ui.legacyGlass"
+        static let watermarkVideoNotes = "kasper.ui.watermarkVideoNotes"
+        static let screenshotBadge = "kasper.ui.screenshotBadge"
+        static let expandedSections = "kasper.ui.expandedSections"
+    }
+
+    /// Пометка, которая дописывается к сохранённому удалённому сообщению.
+    public static let deletedMarker = "🗑 Удалено"
+
+    private static func flag(_ key: String, default defaultValue: Bool) -> Bool {
+        if defaults.object(forKey: key) == nil {
+            return defaultValue
+        }
+        return defaults.bool(forKey: key)
+    }
+
+    // MARK: - Призрак
+
+    /// Не сообщать серверу, что вы «в сети».
+    public static var ghostHideOnline: Bool {
+        get { return flag(Key.ghostHideOnline, default: false) }
+        set { defaults.set(newValue, forKey: Key.ghostHideOnline) }
+    }
+
+    /// Не отправлять отметки о прочтении: сообщения читаются только у вас.
+    public static var ghostHideReadReceipts: Bool {
+        get { return flag(Key.ghostHideReadReceipts, default: false) }
+        set { defaults.set(newValue, forKey: Key.ghostHideReadReceipts) }
+    }
+
+    /// Не отправлять статус «печатает…» и «записывает голосовое…».
+    public static var ghostHideTyping: Bool {
+        get { return flag(Key.ghostHideTyping, default: false) }
+        set { defaults.set(newValue, forKey: Key.ghostHideTyping) }
+    }
+
+    /// Не отправлять отметку «прослушано/просмотрено» для голосовых, кружков и медиа «один раз».
+    public static var ghostHideListened: Bool {
+        get { return flag(Key.ghostHideListened, default: false) }
+        set { defaults.set(newValue, forKey: Key.ghostHideListened) }
+    }
+
+    /// Все режимы призрака включены.
+    public static var ghostEnabled: Bool {
+        get { return ghostHideOnline && ghostHideReadReceipts && ghostHideTyping && ghostHideListened }
+        set {
+            ghostHideOnline = newValue
+            ghostHideReadReceipts = newValue
+            ghostHideTyping = newValue
+            ghostHideListened = newValue
+        }
+    }
+
+    // MARK: - Удалённые сообщения
+
+    /// Сохранять сообщения, удалённые собеседником: текст и файлы остаются на телефоне с пометкой.
+    public static var keepDeletedMessages: Bool {
+        get { return flag(Key.keepDeleted, default: true) }
+        set { defaults.set(newValue, forKey: Key.keepDeleted) }
+    }
+
+    /// Сохранять удалённые сообщения не только в личных чатах, но и в группах.
+    public static var keepDeletedInGroups: Bool {
+        get { return flag(Key.keepDeletedInGroups, default: false) }
+        set { defaults.set(newValue, forKey: Key.keepDeletedInGroups) }
+    }
+
+    /// Счётчик пойманных удалённых сообщений (показывается в настройках).
+    public static var deletedCaught: Int {
+        get { return defaults.integer(forKey: Key.deletedCaught) }
+        set { defaults.set(max(0, newValue), forKey: Key.deletedCaught) }
+    }
+
+    // MARK: - Голос
+
+    /// Выбранный эффект для голосовых сообщений.
+    public static var voice: KasperVoice {
+        get { return KasperVoice(rawValue: defaults.string(forKey: Key.voice) ?? "") ?? .none }
+        set { defaults.set(newValue.rawValue, forKey: Key.voice) }
+    }
+
+    /// Менять голос и в звонках (обрабатывается звук с микрофона во время разговора).
+    public static var voiceInCalls: Bool {
+        get { return flag(Key.voiceInCalls, default: false) }
+        set { defaults.set(newValue, forKey: Key.voiceInCalls) }
+    }
+
+    // MARK: - Интерфейс
+
+    /// Сообщение для главного экрана: набор вкладок внизу изменился.
+    public static let tabsChangedNotification = Notification.Name("kasper.tabs.changed")
+
+    /// Отдельная вкладка «Профиль» в нижней панели.
+    public static var profileTab: Bool {
+        get { return flag(Key.profileTab, default: false) }
+        set {
+            defaults.set(newValue, forKey: Key.profileTab)
+            NotificationCenter.default.post(name: tabsChangedNotification, object: nil)
+        }
+    }
+
+    /// Стекло Telegram для старых iOS вместо Liquid Glass (имеет смысл на iOS 26 и новее).
+    /// Применяется после перезапуска приложения.
+    public static var legacyGlass: Bool {
+        get { return flag(Key.legacyGlass, default: false) }
+        set { defaults.set(newValue, forKey: Key.legacyGlass) }
+    }
+
+    /// Надпись «Kasper» на кружках, которые сохраняются в галерею.
+    public static var watermarkVideoNotes: Bool {
+        get { return flag(Key.watermarkVideoNotes, default: true) }
+        set { defaults.set(newValue, forKey: Key.watermarkVideoNotes) }
+    }
+
+    /// Сохранять в галерею копию скриншота с фиолетовой надписью «Kasper».
+    public static var screenshotBadge: Bool {
+        get { return flag(Key.screenshotBadge, default: true) }
+        set { defaults.set(newValue, forKey: Key.screenshotBadge) }
+    }
+
+    /// Какие разделы настроек Kasper сейчас раскрыты.
+    public static var expandedSections: Set<String> {
+        get { return Set(defaults.stringArray(forKey: Key.expandedSections) ?? []) }
+        set { defaults.set(Array(newValue), forKey: Key.expandedSections) }
+    }
