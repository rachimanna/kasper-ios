+// Kasper: логотип вместо стандартного самолётика Telegram.
+- (void)kasperAddLogoToView:(UIView *)hostView size:(CGFloat)size
+{
+    [_kasperLogoView removeFromSuperview];
+    
+    UIView *container = [[UIView alloc] initWithFrame:CGRectMake(0.0, 0.0, size, size)];
+    container.backgroundColor = _backgroundColor;
+    container.userInteractionEnabled = false;
+    container.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    
+    CGFloat circleSize = floor(size * 0.72);
+    UIView *circle = [[UIView alloc] initWithFrame:CGRectMake(floor((size - circleSize) / 2.0), floor((size - circleSize) / 2.0), circleSize, circleSize)];
+    circle.layer.cornerRadius = circleSize / 2.0;
+    circle.layer.masksToBounds = true;
+    
+    CAGradientLayer *gradient = [CAGradientLayer layer];
+    gradient.frame = circle.bounds;
+    gradient.colors = @[
+        (id)[UIColor colorWithRed:0.61 green:0.36 blue:1.0 alpha:1.0].CGColor,
+        (id)[UIColor colorWithRed:0.36 green:0.13 blue:0.71 alpha:1.0].CGColor
+    ];
+    gradient.startPoint = CGPointMake(0.0, 0.0);
+    gradient.endPoint = CGPointMake(1.0, 1.0);
+    [circle.layer addSublayer:gradient];
+    
+    UILabel *letter = [[UILabel alloc] initWithFrame:circle.bounds];
+    letter.text = @"K";
+    letter.textAlignment = NSTextAlignmentCenter;
+    letter.textColor = [UIColor whiteColor];
+    letter.font = [UIFont systemFontOfSize:floor(circleSize * 0.56) weight:UIFontWeightHeavy];
+    [circle addSubview:letter];
+    
+    [container addSubview:circle];
+    [hostView addSubview:container];
+    _kasperLogoView = container;
+    
+    // Плавное «дыхание» логотипа
+    CABasicAnimation *pulse = [CABasicAnimation animationWithKeyPath:@"transform.scale"];
+    pulse.fromValue = @(1.0);
+    pulse.toValue = @(1.06);
+    pulse.duration = 1.6;
+    pulse.autoreverses = true;
+    pulse.repeatCount = HUGE_VALF;
+    pulse.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
+    [circle.layer addAnimation:pulse forKey:@"kasperPulse"];
+}
