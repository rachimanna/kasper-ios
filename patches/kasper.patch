+    private(set) var voiceRate: AudioPlaybackRate = .x1
+    private(set) var order: MusicPlaybackSettingsOrder = .regular
+    private(set) var looping: MusicPlaybackSettingsLooping = MusicPlaybackSettingsLooping.none
+    private let disposable = MetaDisposable()
+
+    func refresh(context: AccountContext, completion: @escaping () -> Void) {
+        self.disposable.set((context.sharedContext.accountManager.sharedData(keys: [ApplicationSpecificSharedDataKeys.musicPlaybackSettings])
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { [weak self] sharedData in
+            let settings = sharedData.entries[ApplicationSpecificSharedDataKeys.musicPlaybackSettings]?.get(MusicPlaybackSettings.self) ?? MusicPlaybackSettings.defaultSettings
+            self?.voiceRate = settings.voicePlaybackRate
+            self?.order = settings.order
+            self?.looping = settings.looping
+            completion()
+        }))
+    }
