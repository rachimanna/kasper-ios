+public enum KasperSettings {
+    private static var defaults: UserDefaults {
+        return UserDefaults.standard
+    }
+
+    private enum Key {
+        static let ghostHideOnline = "kasper.ghost.hideOnline"
+        static let ghostHideReadReceipts = "kasper.ghost.hideReadReceipts"
+        static let ghostHideTyping = "kasper.ghost.hideTyping"
+        static let ghostHideListened = "kasper.ghost.hideListened"
+        static let keepDeleted = "kasper.deleted.keep"
+        static let keepDeletedInGroups = "kasper.deleted.groups"
