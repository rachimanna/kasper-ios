--- /dev/null
+++ b/submodules/SettingsUI/Sources/Kasper/KasperSettingsController.swift
@@ -0,0 +1,490 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+
+// MARK: - Состояние
+
+private enum KasperSection: String {
+    case ghost
+    case interface
+    case voice
+    case deleted
+}
+
+private struct KasperSettingsState: Equatable {
+    var hideOnline: Bool
+    var hideReadReceipts: Bool
+    var hideTyping: Bool
+    var hideListened: Bool
+    var keepDeleted: Bool
+    var keepDeletedInGroups: Bool
+    var deletedCaught: Int
+    var voice: KasperVoice
+    var voiceInCalls: Bool
+    var nickname: String
+    var profileTab: Bool
+    var legacyGlass: Bool
+    var watermarkVideoNotes: Bool
+    var screenshotBadge: Bool
+    var expanded: Set<String>
+
+    var ghostEnabled: Bool {
+        return self.hideOnline && self.hideReadReceipts && self.hideTyping && self.hideListened
+    }
+
+    var interfaceEnabled: Bool {
+        return self.profileTab || self.legacyGlass || self.watermarkVideoNotes || self.screenshotBadge
+    }
+
+    func isExpanded(_ section: KasperSection) -> Bool {
+        return self.expanded.contains(section.rawValue)
+    }
+
+    static func current() -> KasperSettingsState {
+        return KasperSettingsState(
+            hideOnline: KasperSettings.ghostHideOnline,
+            hideReadReceipts: KasperSettings.ghostHideReadReceipts,
+            hideTyping: KasperSettings.ghostHideTyping,
+            hideListened: KasperSettings.ghostHideListened,
+            keepDeleted: KasperSettings.keepDeletedMessages,
+            keepDeletedInGroups: KasperSettings.keepDeletedInGroups,
+            deletedCaught: KasperSettings.deletedCaught,
+            voice: KasperSettings.voice,
+            voiceInCalls: KasperSettings.voiceInCalls,
+            nickname: KasperSettings.localNickname,
+            profileTab: KasperSettings.profileTab,
+            legacyGlass: KasperSettings.legacyGlass,
+            watermarkVideoNotes: KasperSettings.watermarkVideoNotes,
+            screenshotBadge: KasperSettings.screenshotBadge,
+            expanded: KasperSettings.expandedSections
+        )
+    }
+}
+
+private enum KasperGhostOption: String {
+    case online
+    case read
+    case typing
+    case listened
+}
