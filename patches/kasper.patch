new file mode 100644
index 0000000..f82430b
--- /dev/null
+++ b/submodules/SettingsUI/Sources/Kasper/KasperRadio.swift
@@ -0,0 +1,259 @@
+import Foundation
+import UIKit
+import AVFoundation
+import SwiftSignalKit
+
+/// Интернет-радиостанция из каталога radio-browser.info.
+struct KasperRadioStation: Codable, Equatable {
+    let id: String
+    let name: String
+    let url: String
+    let country: String
+    let tags: String
+}
+
+/// Радио Kasper: каталог станций, избранное, история и воспроизведение через AVPlayer.
+final class KasperRadio {
+    static let shared = KasperRadio()
+    static let changedNotification = Notification.Name("kasper.radio.changed")
+
+    private var player: AVPlayer?
+    private var statusObservation: NSKeyValueObservation?
+    private var backgroundObserver: NSObjectProtocol?
+
+    private(set) var current: KasperRadioStation?
+    private(set) var isPlaying: Bool = false
+    private(set) var isLoading: Bool = false
+    private(set) var lastError: String?
+
+    private let defaults = UserDefaults.standard
+
+    // MARK: Настройки
+
+    var volume: Float {
+        get {
+            if self.defaults.object(forKey: "kasper.radio.volume") == nil {
+                return 1.0
+            }
+            return self.defaults.float(forKey: "kasper.radio.volume")
+        }
+        set {
+            self.defaults.set(max(0.0, min(1.0, newValue)), forKey: "kasper.radio.volume")
+            self.player?.volume = newValue
+            self.notify()
+        }
+    }
+
+    /// Продолжать играть, когда Kasper свёрнут.
+    var playInBackground: Bool {
+        get {
+            if self.defaults.object(forKey: "kasper.radio.background") == nil {
+                return true
+            }
+            return self.defaults.bool(forKey: "kasper.radio.background")
+        }
+        set {
+            self.defaults.set(newValue, forKey: "kasper.radio.background")
+            self.notify()
+        }
+    }
+
+    private func loadList(_ key: String) -> [KasperRadioStation] {
+        guard let data = self.defaults.data(forKey: key), let list = try? JSONDecoder().decode([KasperRadioStation].self, from: data) else {
+            return []
+        }
+        return list
+    }
+
+    private func saveList(_ list: [KasperRadioStation], key: String) {
+        if let data = try? JSONEncoder().encode(list) {
+            self.defaults.set(data, forKey: key)
+        }
+    }
+
+    var favorites: [KasperRadioStation] {
+        return self.loadList("kasper.radio.favorites")
+    }
+
+    var history: [KasperRadioStation] {
+        return self.loadList("kasper.radio.history")
+    }
+
+    func isFavorite(_ station: KasperRadioStation) -> Bool {
+        return self.favorites.contains(where: { $0.id == station.id })
+    }
+
+    func toggleFavorite(_ station: KasperRadioStation) {
+        var list = self.favorites
+        if let index = list.firstIndex(where: { $0.id == station.id }) {
+            list.remove(at: index)
+        } else {
+            list.insert(station, at: 0)
+        }
+        self.saveList(list, key: "kasper.radio.favorites")
+        self.notify()
+    }
+
+    func clearHistory() {
+        self.saveList([], key: "kasper.radio.history")
+        self.notify()
+    }
+
+    private func addToHistory(_ station: KasperRadioStation) {
+        var list = self.history.filter { $0.id != station.id }
+        list.insert(station, at: 0)
+        if list.count > 30 {
+            list.removeLast(list.count - 30)
+        }
+        self.saveList(list, key: "kasper.radio.history")
+    }
+
+    // MARK: Воспроизведение
+
+    func play(_ station: KasperRadioStation) {
+        guard let url = URL(string: station.url) else {
+            self.lastError = "У станции неверный адрес потока"
+            self.notify()
+            return
+        }
+        try? AVAudioSession.sharedInstance().setCategory(.playback, mode: .default, options: [])
+        try? AVAudioSession.sharedInstance().setActive(true)
+
+        self.statusObservation?.invalidate()
+        let item = AVPlayerItem(url: url)
+        let player = AVPlayer(playerItem: item)
+        player.volume = self.volume
+        player.automaticallyWaitsToMinimizeStalling = true
+        self.player?.pause()
+        self.player = player
+        self.current = station
+        self.isLoading = true
+        self.isPlaying = true
+        self.lastError = nil
+        self.statusObservation = item.observe(\.status, options: [.new], changeHandler: { [weak self] item, _ in
+            DispatchQueue.main.async {
+                guard let self = self else {
+                    return
+                }
+                switch item.status {
+                case .readyToPlay:
+                    self.isLoading = false
+                case .failed:
+                    self.isLoading = false
+                    self.isPlaying = false
+                    self.lastError = "Станция не отвечает — попробуйте другую"
+                default:
+                    break
+                }
+                self.notify()
+            }
+        })
+        player.play()
+        self.addToHistory(station)
+        self.startBackgroundObserver()
+        self.notify()
+    }
+
+    func togglePause() {
+        guard let player = self.player else {
+            return
+        }
+        if self.isPlaying {
+            player.pause()
+            self.isPlaying = false
+        } else {
+            player.play()
+            self.isPlaying = true
+        }
+        self.notify()
+    }
+
+    func stop() {
+        self.statusObservation?.invalidate()
+        self.statusObservation = nil
+        self.player?.pause()
+        self.player = nil
+        self.current = nil
+        self.isPlaying = false
+        self.isLoading = false
+        self.notify()
+    }
+
+    private func startBackgroundObserver() {
+        guard self.backgroundObserver == nil else {
+            return
+        }
+        self.backgroundObserver = NotificationCenter.default.addObserver(forName: UIApplication.didEnterBackgroundNotification, object: nil, queue: .main, using: { [weak self] _ in
+            guard let self = self, !self.playInBackground, self.isPlaying else {
+                return
+            }
+            self.togglePause()
+        })
+    }
+
+    private func notify() {
+        NotificationCenter.default.post(name: KasperRadio.changedNotification, object: nil)
+    }
+
+    /// Строка для главного экрана Kasper.
+    var statusText: String {
+        if let current = self.current {
+            return self.isPlaying ? "Сейчас играет: \(current.name)" : "На паузе: \(current.name)"
+        }
+        return "Сейчас никто не слушает"
+    }
+
+    // MARK: Каталог
+
+    /// Станции из открытого каталога radio-browser.info: популярные в стране или найденные по названию.
+    /// Берём только потоки по https — остальные iOS не откроет.
+    static func stations(query: String, countryCode: String?) -> Signal<[KasperRadioStation], NoError> {
+        return Signal { subscriber in
+            var components = URLComponents(string: "https://de1.api.radio-browser.info/json/stations/search")!
+            var items = [
+                URLQueryItem(name: "order", value: "clickcount"),
+                URLQueryItem(name: "reverse", value: "true"),
+                URLQueryItem(name: "hidebroken", value: "true"),
+                URLQueryItem(name: "limit", value: "60")
+            ]
+            let trimmed = query.trimmingCharacters(in: .whitespacesAndNewlines)
+            if !trimmed.isEmpty {
+                items.append(URLQueryItem(name: "name", value: trimmed))
+            }
+            if let countryCode = countryCode {
+                items.append(URLQueryItem(name: "countrycode", value: countryCode))
+            }
+            components.queryItems = items
+            var request = URLRequest(url: components.url!, timeoutInterval: 15.0)
+            request.setValue("Kasper/1.0", forHTTPHeaderField: "User-Agent")
+            let task = URLSession.shared.dataTask(with: request, completionHandler: { data, _, _ in
+                var result: [KasperRadioStation] = []
+                if let data = data, let list = try? JSONSerialization.jsonObject(with: data) as? [[String: Any]] {
+                    for item in list {
+                        guard let id = item["stationuuid"] as? String, let name = item["name"] as? String else {
+                            continue
+                        }
+                        let stream = (item["url_resolved"] as? String) ?? (item["url"] as? String) ?? ""
+                        guard stream.lowercased().hasPrefix("https://") else {
+                            continue
+                        }
+                        let cleanName = name.trimmingCharacters(in: .whitespacesAndNewlines)
+                        if cleanName.isEmpty || result.contains(where: { $0.name == cleanName }) {
+                            continue
+                        }
+                        result.append(KasperRadioStation(id: id, name: cleanName, url: stream, country: (item["country"] as? String) ?? "", tags: (item["tags"] as? String) ?? ""))
+                        if result.count >= 40 {
+                            break
+                        }
+                    }
+                }
+                subscriber.putNext(result)
+                subscriber.putCompletion()
+            })
+            task.resume()
+            return ActionDisposable {
+                task.cancel()
+            }
+        }
+    }
+}
