+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+import ContextUI
+import UndoUI
+import PromptUI
+import PresentationDataUtils
+import ChatControllerInteraction
+import ChatPresentationInterfaceState
+
+private func kasperMenuIcon(_ symbol: String) -> (PresentationTheme) -> UIImage? {
+    return { theme in
+        let configuration = UIImage.SymbolConfiguration(pointSize: 17.0, weight: .regular)
+        return generateTintedImage(image: UIImage(systemName: symbol, withConfiguration: configuration), color: theme.actionSheet.primaryTextColor)
+    }
+}
+
+/// Kasper: пункт «Kasper» в меню сообщения. Внутри — функции Kasper для этого
+/// сообщения и чата: избранное, информация, правка у себя, прочтение, призрак, экспорт.
+func kasperMessageContextItems(context: AccountContext, message: Message, controllerInteraction: ChatControllerInteraction, interfaceInteraction: ChatPanelInterfaceInteraction) -> [ContextMenuItem] {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let peerId = message.id.peerId
+    let isCloud = message.id.namespace == Namespaces.Message.Cloud
+    let isSecret = peerId.namespace == Namespaces.Peer.SecretChat
+
+    let root = ContextMenuActionItem(text: "Kasper", icon: kasperMenuIcon("sparkles"), action: { c, _ in
+        var items: [ContextMenuItem] = []
+        items.append(.action(ContextMenuActionItem(text: presentationData.strings.Common_Back, textColor: .primary, icon: { theme in
+            return generateTintedImage(image: UIImage(bundleImageName: "Chat/Context Menu/Back"), color: theme.actionSheet.primaryTextColor)
+        }, iconSource: nil, iconPosition: .left, action: { c, _ in
+            c?.popItems()
+        })))
+        items.append(.separator)
+
+        // В избранное: пересылка в «Избранное» в одно нажатие
+        if isCloud && !isSecret && peerId != context.account.peerId {
+            items.append(.action(ContextMenuActionItem(text: "В избранное", icon: kasperMenuIcon("bookmark"), action: { _, f in
+                f(.dismissWithoutContent)
+                let _ = enqueueMessages(account: context.account, peerId: context.account.peerId, messages: [
+                    .forward(source: message.id, threadId: nil, grouping: .auto, attributes: [], correlationId: nil)
+                ]).startStandalone()
+                controllerInteraction.displayUndo(.forward(savedMessages: true, text: "Сообщение сохранено в «Избранное»"))
+            })))
+        }
+
+        // Информация о сообщении: ID, точное время, правка, пересылка
+        items.append(.action(ContextMenuActionItem(text: "Информация о сообщении", icon: kasperMenuIcon("info.circle"), action: { _, f in
+            f(.dismissWithoutContent)
+            let text = kasperMessageInfoText(message)
+            interfaceInteraction.presentController(textAlertController(context: context, title: "Сообщение", text: text, actions: [
+                TextAlertAction(type: .genericAction, title: "Копировать", action: {
+                    UIPasteboard.general.string = text
+                    controllerInteraction.displayUndo(.copy(text: "Скопировано"))
+                }),
+                TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+            ]), nil)
+        })))
+
+        // Изменить у себя: новый текст виден только на этом телефоне
+        if !message.text.isEmpty {
+            items.append(.action(ContextMenuActionItem(text: "Изменить у себя", icon: kasperMenuIcon("pencil.and.outline"), action: { _, f in
+                f(.dismissWithoutContent)
+                let controller = promptController(context: context, text: "Новый текст увидите только вы. Собеседник ничего не заметит, а если сообщение изменят, текст вернётся.", value: message.text, characterLimit: 4096, apply: { value in
+                    guard let value = value, !value.isEmpty, value != message.text else {
+                        return
+                    }
+                    let _ = KasperActions.editLocally(account: context.account, messageId: message.id, text: value).startStandalone()
+                })
+                interfaceInteraction.presentController(controller, nil)
+            })))
+        }
+
+        // Прочитать сейчас: отметка о прочтении уходит даже в режиме призрака
+        if !isSecret && KasperSettings.ghostHideReadReceipts && KasperSettings.ghostApplies(to: peerId) {
+            items.append(.action(ContextMenuActionItem(text: "Прочитать сейчас", icon: kasperMenuIcon("checkmark.circle"), action: { _, f in
+                f(.dismissWithoutContent)
+                let _ = (KasperActions.sendReadReceipt(account: context.account, peerId: peerId)
+                |> deliverOnMainQueue).startStandalone(next: { success in
+                    controllerInteraction.displayUndo(.info(title: nil, text: success ? "Собеседник увидит, что вы прочитали" : "Не удалось отправить прочтение", timeout: nil, customUndoText: nil))
+                })
+            })))
+        }
+
+        // Призрак в этом чате
+        let excluded = KasperSettings.isGhostExcluded(peerId)
+        items.append(.action(ContextMenuActionItem(text: excluded ? "Включить призрак в этом чате" : "Выключить призрак в этом чате", icon: kasperMenuIcon(excluded ? "eye.slash" : "eye"), action: { _, f in
+            f(.dismissWithoutContent)
+            KasperSettings.setGhostExcluded(peerId, !excluded)
+            controllerInteraction.displayUndo(.info(title: nil, text: excluded ? "Призрак снова действует в этом чате" : "В этом чате призрак выключен: прочтение и «печатает…» отправляются как обычно", timeout: nil, customUndoText: nil))
+        })))
+
+        // Экспорт чата: текстовый файл уходит в «Избранное»
+        if !isSecret {
+            items.append(.action(ContextMenuActionItem(text: "Экспорт чата в файл", icon: kasperMenuIcon("square.and.arrow.up"), action: { _, f in
+                f(.dismissWithoutContent)
+                kasperExportChat(context: context, peerId: peerId, controllerInteraction: controllerInteraction)
+            })))
+        }
+
+        c?.pushItems(items: .single(ContextController.Items(content: .list(items))))
+    })
+    return [.action(root)]
+}
+
+private func kasperMessageInfoText(_ message: Message) -> String {
+    let formatter = DateFormatter()
+    formatter.locale = Locale(identifier: "ru_RU")
+    formatter.dateFormat = "dd.MM.yyyy HH:mm:ss"
+    func date(_ timestamp: Int32) -> String {
+        return formatter.string(from: Date(timeIntervalSince1970: Double(timestamp)))
+    }
+
+    var lines: [String] = []
+    lines.append("ID сообщения: \(message.id.id)")
+    lines.append("ID чата: \(message.id.peerId.id._internalGetInt64Value())")
+    if let author = message.author {
+        lines.append("ID автора: \(author.id.id._internalGetInt64Value())")
+    }
+    lines.append("Отправлено: \(date(message.timestamp))")
+    for attribute in message.attributes {
+        if let attribute = attribute as? EditedMessageAttribute, !attribute.isHidden {
+            lines.append("Изменено: \(date(attribute.date))")
+        }
+        if let attribute = attribute as? ViewCountMessageAttribute {
+            lines.append("Просмотров: \(attribute.count)")
+        }
+        if let attribute = attribute as? ForwardCountMessageAttribute {
+            lines.append("Пересылок: \(attribute.count)")
+        }
+    }
+    if let forwardInfo = message.forwardInfo {
+        var source = forwardInfo.authorSignature ?? ""
+        if let author = forwardInfo.author {
+            source = EnginePeer(author).compactDisplayTitle
+        } else if let sourcePeer = forwardInfo.source {
+            source = EnginePeer(sourcePeer).compactDisplayTitle
+        }
+        lines.append("Переслано из: \(source.isEmpty ? "скрытый аккаунт" : source)")
+        lines.append("Оригинал от: \(date(forwardInfo.date))")
+    }
+    if message.text.hasSuffix(KasperSettings.deletedMarker) {
+        lines.append("Удалено собеседником, сохранено Kasper")
+    }
+    lines.append("Символов: \(message.text.count)")
+    return lines.joined(separator: "\n")
+}
+
+/// Сохраняет переписку (до 5000 сообщений, которые уже есть на телефоне) в .txt
+/// и отправляет файл в «Избранное».
+private func kasperExportChat(context: AccountContext, peerId: PeerId, controllerInteraction: ChatControllerInteraction) {
+    let _ = (KasperActions.exportChatText(account: context.account, peerId: peerId, limit: 5000)
+    |> deliverOnMainQueue).startStandalone(next: { result in
+        if result.count == 0 {
+            controllerInteraction.displayUndo(.info(title: nil, text: "В этом чате пока нечего сохранять", timeout: nil, customUndoText: nil))
+            return
+        }
+        let safeTitle = String(result.title.map { "/\\:?*\"<>|".contains($0) ? "_" : $0 }).prefix(40)
+        let fileName = "Kasper - \(safeTitle).txt"
+        let path = NSTemporaryDirectory() + "kasper-export-\(Int64.random(in: 1 ..< Int64.max)).txt"
+        guard let data = result.text.data(using: .utf8), (try? data.write(to: URL(fileURLWithPath: path), options: .atomic)) != nil else {
+            controllerInteraction.displayUndo(.info(title: nil, text: "Не удалось сохранить файл", timeout: nil, customUndoText: nil))
+            return
+        }
+        let id = Int64.random(in: Int64.min ... Int64.max)
+        let file = TelegramMediaFile(fileId: EngineMedia.Id(namespace: Namespaces.Media.LocalFile, id: id), partialReference: nil, resource: LocalFileReferenceMediaResource(localFilePath: path, randomId: id), previewRepresentations: [], videoThumbnails: [], immediateThumbnailData: nil, mimeType: "text/plain", size: Int64(data.count), attributes: [.FileName(fileName: fileName)], alternativeRepresentations: [])
+        let message: EnqueueMessage = .message(text: "", attributes: [], inlineStickers: [:], mediaReference: .standalone(media: file), threadId: nil, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])
+        let _ = enqueueMessages(account: context.account, peerId: context.account.peerId, messages: [message]).startStandalone()
+        controllerInteraction.displayUndo(.forward(savedMessages: true, text: "Экспорт: \(result.count) сообщений — файл в «Избранном»"))
+    })
+}
