+import Foundation
+import Postbox
+import SwiftSignalKit
+import TelegramApi
+
+// MARK: - Прочтение по запросу
+
+/// Отправляет отметку о прочтении до последнего сообщения чата — даже когда
+/// «Не отправлять прочтение» включено. Секретные чаты не поддерживаются.
+func kasperPushReadReceipt(postbox: Postbox, network: Network, peerId: PeerId) -> Signal<Bool, NoError> {
+    return postbox.transaction { transaction -> (Peer?, Int32?) in
+        let peer = transaction.getPeer(peerId)
+        let maxId = transaction.getTopPeerMessageId(peerId: peerId, namespace: Namespaces.Message.Cloud)?.id
+        return (peer, maxId)
+    }
+    |> mapToSignal { peer, maxId -> Signal<Bool, NoError> in
+        guard let peer = peer, let maxId = maxId else {
+            return .single(false)
+        }
+        if peerId.namespace == Namespaces.Peer.CloudChannel {
+            guard let inputChannel = apiInputChannel(peer) else {
+                return .single(false)
+            }
+            return network.request(Api.functions.channels.readHistory(channel: inputChannel, maxId: maxId))
+            |> map { _ -> Bool in
+                return true
+            }
+            |> `catch` { _ -> Signal<Bool, NoError> in
+                return .single(false)
+            }
+        } else if peerId.namespace == Namespaces.Peer.CloudUser || peerId.namespace == Namespaces.Peer.CloudGroup {
+            guard let inputPeer = apiInputPeer(peer) else {
+                return .single(false)
+            }
+            return network.request(Api.functions.messages.readHistory(peer: inputPeer, maxId: maxId))
+            |> map { _ -> Bool in
+                return true
+            }
+            |> `catch` { _ -> Signal<Bool, NoError> in
+                return .single(false)
+            }
+        } else {
+            return .single(false)
+        }
+    }
+}
+
+/// Призрак: «Прочитать, когда отвечаю» — после отправки сообщения отмечаем чат прочитанным.
+func kasperReadOnReply(postbox: Postbox, network: Network, peerId: PeerId) {
+    guard KasperSettings.ghostHideReadReceipts, KasperSettings.ghostReadOnReply, KasperSettings.ghostApplies(to: peerId) else {
+        return
+    }
+    let _ = kasperPushReadReceipt(postbox: postbox, network: network, peerId: peerId).start()
+}
+
+public enum KasperActions {
+    /// «Прочитать сейчас» из меню сообщения.
+    public static func sendReadReceipt(account: Account, peerId: PeerId) -> Signal<Bool, NoError> {
+        return kasperPushReadReceipt(postbox: account.postbox, network: account.network, peerId: peerId)
+    }
+
+    /// Меняет текст сообщения только на этом телефоне. Собеседник ничего не увидит,
+    /// а при следующем обновлении сообщения от Telegram текст может вернуться.
+    public static func editLocally(account: Account, messageId: MessageId, text: String) -> Signal<Void, NoError> {
+        return account.postbox.transaction { transaction -> Void in
+            transaction.updateMessage(messageId, update: { currentMessage in
+                var storeForwardInfo: StoreMessageForwardInfo?
+                if let forwardInfo = currentMessage.forwardInfo {
+                    storeForwardInfo = StoreMessageForwardInfo(authorId: forwardInfo.author?.id, sourceId: forwardInfo.source?.id, sourceMessageId: forwardInfo.sourceMessageId, date: forwardInfo.date, authorSignature: forwardInfo.authorSignature, psaType: forwardInfo.psaType, flags: forwardInfo.flags)
+                }
+                // старая разметка относится к старому тексту — убираем её
+                let attributes = currentMessage.attributes.filter { !($0 is TextEntitiesMessageAttribute) }
+                return .update(StoreMessage(
+                    id: currentMessage.id,
+                    customStableId: nil,
+                    globallyUniqueId: currentMessage.globallyUniqueId,
+                    groupingKey: currentMessage.groupingKey,
+                    threadId: currentMessage.threadId,
+                    timestamp: currentMessage.timestamp,
+                    flags: StoreMessageFlags(currentMessage.flags),
+                    tags: currentMessage.tags,
+                    globalTags: currentMessage.globalTags,
+                    localTags: currentMessage.localTags,
+                    forwardInfo: storeForwardInfo,
+                    authorId: currentMessage.author?.id,
+                    text: text,
+                    attributes: attributes,
+                    media: currentMessage.media
+                ))
+            })
+        }
+    }
+
+    /// Текст переписки для экспорта: последние `limit` сообщений, которые уже есть на телефоне.
+    public static func exportChatText(account: Account, peerId: PeerId, limit: Int) -> Signal<(title: String, text: String, count: Int), NoError> {
+        return account.postbox.transaction { transaction -> (title: String, text: String, count: Int) in
+            let title = transaction.getPeer(peerId)?.debugDisplayTitle ?? "Чат"
+            var messages: [Message] = []
+            transaction.scanTopMessages(peerId: peerId, namespace: Namespaces.Message.Cloud, limit: limit, { message in
+                messages.append(message)
+                return true
+            })
+            messages.sort(by: { $0.index < $1.index })
+
+            let formatter = DateFormatter()
+            formatter.locale = Locale(identifier: "ru_RU")
+            formatter.dateFormat = "dd.MM.yyyy HH:mm:ss"
+
+            var lines: [String] = []
+            lines.append("Kasper · экспорт чата «\(title)»")
+            lines.append("Сообщений: \(messages.count), выгружено \(formatter.string(from: Date()))")
+            lines.append("")
+            for message in messages {
+                let date = formatter.string(from: Date(timeIntervalSince1970: Double(message.timestamp)))
+                let author: String
+                if let peer = message.author {
+                    author = peer.debugDisplayTitle
+                } else {
+                    author = title
+                }
+                var body = message.text
+                let media = kasperDescribeMedia(message.media)
+                if !media.isEmpty {
+                    body = body.isEmpty ? media : "\(media) \(body)"
+                }
+                if body.isEmpty {
+                    body = "[служебное сообщение]"
+                }
+                lines.append("[\(date)] \(author): \(body)")
+            }
+            return (title, lines.joined(separator: "\n"), messages.count)
+        }
+    }
+}
+
+private func kasperDescribeMedia(_ media: [Media]) -> String {
+    var parts: [String] = []
+    for item in media {
+        if item is TelegramMediaImage {
+            parts.append("[фото]")
+        } else if let file = item as? TelegramMediaFile {
+            if file.isVoice {
+                parts.append("[голосовое]")
+            } else if file.isInstantVideo {
+                parts.append("[кружок]")
+            } else if file.isSticker {
+                parts.append("[стикер]")
+            } else if file.isVideo {
+                parts.append("[видео]")
+            } else if file.isMusic {
+                parts.append("[аудио \(file.fileName ?? "")]")
+            } else {
+                parts.append("[файл \(file.fileName ?? "")]")
+            }
+        } else if item is TelegramMediaMap {
+            parts.append("[геопозиция]")
+        } else if item is TelegramMediaContact {
+            parts.append("[контакт]")
+        } else if item is TelegramMediaPoll {
+            parts.append("[опрос]")
+        }
+    }
+    return parts.joined(separator: " ")
+}
+
+// MARK: - История онлайна
+
+/// Когда собеседники появлялись в сети. Записывается из обновлений, которые Telegram
+/// и так присылает клиенту, пока Kasper запущен. Хранится только на этом телефоне.
+public enum KasperPresenceLog {
+    public struct Session: Codable, Equatable {
+        public var start: Int32
+        public var end: Int32?
+    }
+
+    private static let perUserLimit = 30
+    private static let userLimit = 1000
+    private static let lock = NSLock()
+    private static var cached: [String: [Session]]?
+    private static var saveScheduled = false
+
+    private static var fileUrl: URL? {
+        guard let directory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+            return nil
+        }
+        let folder = directory.appendingPathComponent("Kasper", isDirectory: true)
+        try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true, attributes: nil)
+        return folder.appendingPathComponent("presence-history.json")
+    }
+
+    private static func loadLocked() -> [String: [Session]] {
+        if let cached = cached {
+            return cached
+        }
+        var result: [String: [Session]] = [:]
+        if let url = fileUrl, let data = try? Data(contentsOf: url), let decoded = try? JSONDecoder().decode([String: [Session]].self, from: data) {
+            result = decoded
+        }
+        cached = result
+        return result
+    }
+
+    private static func scheduleSaveLocked() {
+        if saveScheduled {
+            return
+        }
+        saveScheduled = true
+        DispatchQueue.global(qos: .utility).asyncAfter(deadline: .now() + 15.0, execute: {
+            lock.lock()
+            saveScheduled = false
+            let snapshot = cached ?? [:]
+            lock.unlock()
+            if let url = fileUrl, let data = try? JSONEncoder().encode(snapshot) {
+                try? data.write(to: url, options: .atomic)
+            }
+        })
+    }
+
+    static func record(userId: Int64, status: Api.UserStatus) {
+        guard KasperSettings.presenceHistory else {
+            return
+        }
+        let now = Int32(Date().timeIntervalSince1970)
+        let key = "\(userId)"
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        var log = loadLocked()
+        var sessions = log[key] ?? []
+        switch status {
+        case .userStatusOnline:
+            if let last = sessions.last, last.end == nil, now - last.start < 6 * 60 * 60 {
+                // уже отмечен в сети
+                return
+            }
+            if let last = sessions.last, last.end == nil {
+                sessions[sessions.count - 1].end = last.start
+            }
+            sessions.append(Session(start: now, end: nil))
+        case let .userStatusOffline(data):
+            if let last = sessions.last, last.end == nil {
+                sessions[sessions.count - 1].end = max(last.start, data.wasOnline)
+            } else if sessions.last?.end != data.wasOnline {
+                sessions.append(Session(start: data.wasOnline, end: data.wasOnline))
+            } else {
+                return
+            }
+        default:
+            return
+        }
+        if sessions.count > perUserLimit {
+            sessions.removeFirst(sessions.count - perUserLimit)
+        }
+        log[key] = sessions
+        if log.count > userLimit {
+            // вытесняем тех, кого дольше всего не видели
+            let sorted = log.sorted(by: { ($0.value.last?.start ?? 0) < ($1.value.last?.start ?? 0) })
+            for (oldKey, _) in sorted.prefix(log.count - userLimit) {
+                log.removeValue(forKey: oldKey)
+            }
+        }
+        cached = log
+        scheduleSaveLocked()
+    }
+
+    public static func sessions(userId: Int64) -> [Session] {
+        lock.lock()
+        let result = loadLocked()["\(userId)"] ?? []
+        lock.unlock()
+        return result
+    }
+
+    public static var trackedCount: Int {
+        lock.lock()
+        let result = loadLocked().count
+        lock.unlock()
+        return result
+    }
+
+    public static func clear() {
+        lock.lock()
+        cached = [:]
+        lock.unlock()
+        if let url = fileUrl {
+            try? FileManager.default.removeItem(at: url)
+        }
+    }
+
+    /// Последние появления в сети одной строкой на каждое: «сегодня 14:03 – 14:20».
+    public static func describe(userId: Int64, limit: Int = 5) -> String? {
+        let sessions = self.sessions(userId: userId)
+        if sessions.isEmpty {
+            return nil
+        }
+        let now = Int32(Date().timeIntervalSince1970)
+        let calendar = Calendar.current
+        let dayFormatter = DateFormatter()
+        dayFormatter.locale = Locale(identifier: "ru_RU")
+        dayFormatter.dateFormat = "d MMM"
+        let timeFormatter = DateFormatter()
+        timeFormatter.locale = Locale(identifier: "ru_RU")
+        timeFormatter.dateFormat = "HH:mm"
+
+        func day(_ timestamp: Int32) -> String {
+            let date = Date(timeIntervalSince1970: Double(timestamp))
+            if calendar.isDateInToday(date) {
+                return "сегодня"
+            } else if calendar.isDateInYesterday(date) {
+                return "вчера"
+            } else {
+                return dayFormatter.string(from: date)
+            }
+        }
+        func time(_ timestamp: Int32) -> String {
+            return timeFormatter.string(from: Date(timeIntervalSince1970: Double(timestamp)))
+        }
+
+        var lines: [String] = []
+        for session in sessions.reversed().prefix(limit) {
+            let start = "\(day(session.start)) \(time(session.start))"
+            if let end = session.end {
+                if end - session.start < 60 {
+                    lines.append(start)
+                } else {
+                    lines.append("\(start) – \(time(end))")
+                }
+            } else if now - session.start < 6 * 60 * 60 {
+                lines.append("\(start) – сейчас")
+            } else {
+                lines.append(start)
+            }
+        }
+        return lines.joined(separator: "\n")
+    }
+}
+
+// MARK: - Частицы
+
+/// Частицы, которые летят поверх интерфейса (только на этом телефоне).
+public enum KasperParticles: String, CaseIterable {
+    case snow
+    case stars
+    case hearts
+    case leaves
+    case confetti
+
+    public var title: String {
+        switch self {
+        case .snow: return "❄️ Снег"
+        case .stars: return "✨ Звёзды"
+        case .hearts: return "❤️ Сердца"
+        case .leaves: return "🍂 Листопад"
+        case .confetti: return "🎉 Конфетти"
+        }
+    }
+
+    public static var current: KasperParticles? {
+        return KasperParticles(rawValue: KasperSettings.particles)
+    }
+}
