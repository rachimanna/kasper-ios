+            NotificationCenter.default.post(name: overlaysChangedNotification, object: nil)
+        }
+    }
+
+    // MARK: - Резервная копия настроек
+
+    /// Ключи, которые не попадают в экспорт: личные API-ключи и служебные данные.
+    private static let exportExcludedKeys: Set<String> = [
+        Key.elevenLabsApiKey,
+        Key.elevenLabsLastError,
+        Key.virusTotalKey,
+        Key.expandedSections
+    ]
+
+    private static func isExportable(_ key: String) -> Bool {
+        // данные плагинов принадлежат плагинам: не копируем и не сбрасываем их
+        return key.hasPrefix("kasper.") && !key.hasPrefix("kasper.plugin.") && !exportExcludedKeys.contains(key)
+    }
+
+    /// Все настройки Kasper в JSON. API-ключи ElevenLabs и VirusTotal не включаются.
+    public static func exportJSON() -> String? {
+        var result: [String: Any] = [:]
+        for (key, value) in defaults.dictionaryRepresentation() where isExportable(key) {
+            if JSONSerialization.isValidJSONObject([value]) {
+                result[key] = value
+            }
+        }
+        guard let data = try? JSONSerialization.data(withJSONObject: result, options: [.prettyPrinted, .sortedKeys]) else {
+            return nil
+        }
+        return String(data: data, encoding: .utf8)
+    }
+
+    /// Загружает настройки из JSON. Возвращает число применённых настроек или nil, если текст не подходит.
+    public static func importJSON(_ text: String) -> Int? {
+        guard let data = text.data(using: .utf8),
+              let object = try? JSONSerialization.jsonObject(with: data),
+              let dictionary = object as? [String: Any] else {
+            return nil
+        }
+        var count = 0
+        for (key, value) in dictionary where isExportable(key) {
+            defaults.set(value, forKey: key)
+            count += 1
+        }
+        if count != 0 {
+            postAllChangeNotifications()
+        }
+        return count
+    }
+
+    /// Сбрасывает все настройки Kasper к стандартным. API-ключи остаются.
+    public static func resetAll() {
+        // подобранные голоса ElevenLabs не сбрасываем: иначе их пришлось бы подбирать заново
+        let preserved: Set<String> = [Key.elevenLabsVoiceMap, Key.elevenLabsNameMap]
+        for key in defaults.dictionaryRepresentation().keys where isExportable(key) && !preserved.contains(key) {
+            defaults.removeObject(forKey: key)
+        }
+        postAllChangeNotifications()
+    }
+
+    private static func postAllChangeNotifications() {
+        let center = NotificationCenter.default
+        center.post(name: tabsChangedNotification, object: nil)
+        center.post(name: localStarsChangedNotification, object: nil)
+        center.post(name: animationSpeedChangedNotification, object: nil)
+        center.post(name: overlaysChangedNotification, object: nil)
+    }
