+/// и кастомные эмодзи не меняются.
+func kasperTransformingOutgoingText(_ text: NSAttributedString) -> NSAttributedString {
+    // пустой текст (например, при пересылке) не превращаем в сообщение с одной подписью
+    if text.string.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+        return text
+    }
+    let result = NSMutableAttributedString(attributedString: text)
+    if KasperSettings.latinCaps {
+        let protectedKeys: [NSAttributedString.Key] = [
+            ChatTextInputAttributes.monospace,
+            ChatTextInputAttributes.textUrl,
+            ChatTextInputAttributes.textMention,
+            ChatTextInputAttributes.customEmoji,
+            ChatTextInputAttributes.date
+        ]
+        var runs: [NSRange] = []
+        result.enumerateAttributes(in: NSRange(location: 0, length: result.length), options: [], using: { attributes, range, _ in
+            if !protectedKeys.contains(where: { attributes[$0] != nil }) {
+                runs.append(range)
+            }
+        })
+        for range in runs {
+            let original = (result.string as NSString).substring(with: range)
+            var transformed = ""
+            for character in original {
+                let upper = String(character).uppercased()
+                // длину сохраняем, чтобы не сдвинуть оформление
+                guard upper.utf16.count == String(character).utf16.count, let upperCharacter = upper.first else {
+                    transformed.append(character)
+                    continue
+                }
+                transformed.append(kasperLatinCapsMap[upperCharacter] ?? upperCharacter)
+            }
+            if transformed != original && transformed.utf16.count == range.length {
+                result.replaceCharacters(in: range, with: transformed)
+            }
+        }
+    }
+    let signature = KasperSettings.messageSignature.trimmingCharacters(in: .whitespacesAndNewlines)
+    if !signature.isEmpty {
+        result.append(NSAttributedString(string: "\n\n" + signature))
+    }
+    return result
+}
