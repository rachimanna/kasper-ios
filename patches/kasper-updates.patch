+/// Выбор частиц поверх интерфейса.
+private func kasperParticlesRows(reload: @escaping () -> Void) -> KasperGroup {
+    let current = KasperParticles.current
+    var rows: KasperGroup = [
+        .sectionTitle(id: "particles-title", text: "ЧАСТИЦЫ ПОВЕРХ ЭКРАНА"),
+        .choice(id: "particles-off", title: "Выключены", selected: current == nil, action: {
+            KasperSettings.particles = ""
+            reload()
+        })
+    ]
+    for particles in KasperParticles.allCases {
+        rows.append(.choice(id: "particles-\(particles.rawValue)", title: particles.title, selected: current == particles, action: {
+            KasperSettings.particles = particles.rawValue
+            reload()
+        }))
+    }
+    rows.append(.text(id: "particles-footer", text: "Снег, звёзды и другие частицы медленно падают поверх всего интерфейса и не мешают нажатиям. Видны только вам."))
+    return rows
+}
+
+/// Резервная копия настроек Kasper через буфер обмена.
+private func kasperBackupRows(context: AccountContext, navigation: KasperNavigation, reload: @escaping () -> Void) -> KasperGroup {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let ok = TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+    return [
+        .sectionTitle(id: "backup-title", text: "НАСТРОЙКИ KASPER"),
+        .action(id: "backup-export", title: "Скопировать настройки", destructive: false, action: {
+            guard let json = KasperSettings.exportJSON() else {
+                navigation.present(textAlertController(context: context, title: "Не получилось", text: "Не удалось собрать настройки.", actions: [ok]))
+                return
+            }
+            UIPasteboard.general.string = json
+            navigation.present(textAlertController(context: context, title: "Скопировано", text: "Настройки Kasper в буфере обмена. Сохраните их в «Избранное» или заметки, чтобы потом вставить на другом телефоне или после переустановки.", actions: [ok]))
+        }),
+        .action(id: "backup-import", title: "Вставить настройки из буфера", destructive: false, action: {
+            guard let text = UIPasteboard.general.string, let count = KasperSettings.importJSON(text) else {
+                navigation.present(textAlertController(context: context, title: "Не получилось", text: "В буфере обмена нет настроек Kasper. Сначала скопируйте их кнопкой «Скопировать настройки».", actions: [ok]))
+                return
+            }
+            reload()
+            navigation.present(textAlertController(context: context, title: "Готово", text: "Применено настроек: \(count). Часть изменений вступит в силу после перезапуска Kasper.", actions: [ok]))
+        }),
+        .action(id: "backup-reset", title: "Сбросить все настройки Kasper", destructive: true, action: {
+            navigation.present(textAlertController(context: context, title: "Сбросить настройки?", text: "Все переключатели Kasper вернутся к стандартным. Ключи ElevenLabs и VirusTotal, история изменений и сохранённые удалённые сообщения останутся.", actions: [
+                TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+                TextAlertAction(type: .destructiveAction, title: "Сбросить", action: {
+                    KasperSettings.resetAll()
+                    reload()
+                })
+            ]))
+        }),
+        .text(id: "backup-footer", text: "Настройки копируются как текст. Личные API-ключи ElevenLabs и VirusTotal в копию не попадают.")
+    ]
+}
