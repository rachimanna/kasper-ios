+import Foundation
+import UIKit
+import TelegramCore
+
+/// Kasper: то, что рисуется поверх всего интерфейса, — частицы (снег, звёзды…)
+/// и счётчик памяти. Слой не перехватывает нажатия и виден только на этом телефоне.
+final class KasperOverlays {
+    static let shared = KasperOverlays()
+
+    private var observers: [NSObjectProtocol] = []
+    private weak var hostWindow: UIWindow?
+    private var particlesView: KasperParticlesView?
+    private var memoryLabel: UILabel?
+    private var memoryTimer: Timer?
+
+    func start() {
+        guard self.observers.isEmpty else {
+            return
+        }
+        let center = NotificationCenter.default
+        self.observers.append(center.addObserver(forName: UIWindow.didBecomeKeyNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.apply()
+        }))
+        self.observers.append(center.addObserver(forName: KasperSettings.overlaysChangedNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.apply()
+        }))
+        DispatchQueue.main.async { [weak self] in
+            self?.apply()
+        }
+    }
+
+    /// Главное окно приложения: не клавиатура и не системные окна.
+    private func mainWindow() -> UIWindow? {
+        var candidates: [UIWindow] = []
+        for scene in UIApplication.shared.connectedScenes {
+            guard let windowScene = scene as? UIWindowScene else {
+                continue
+            }
+            for window in windowScene.windows {
+                let className = NSStringFromClass(type(of: window))
+                if className.contains("Keyboard") || className.contains("TextEffects") || window.isHidden {
+                    continue
+                }
+                candidates.append(window)
+            }
+        }
+        return candidates.first(where: { $0.isKeyWindow }) ?? candidates.first
+    }
+
+    private func apply() {
+        guard let window = self.mainWindow() else {
+            return
+        }
+        if self.hostWindow !== window {
+            self.particlesView?.removeFromSuperview()
+            self.particlesView = nil
+            self.memoryLabel?.removeFromSuperview()
+            self.memoryLabel = nil
+            self.hostWindow = window
+        }
+
+        if let particles = KasperParticles.current {
+            let view: KasperParticlesView
+            if let current = self.particlesView {
+                view = current
+            } else {
+                view = KasperParticlesView(frame: window.bounds)
+                view.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+                view.isUserInteractionEnabled = false
+                // поверх всех соседних слоёв окна, даже тех, что добавлены позже
+                view.layer.zPosition = 10000.0
+                window.addSubview(view)
+                self.particlesView = view
+            }
+            view.update(particles)
+        } else {
+            self.particlesView?.removeFromSuperview()
+            self.particlesView = nil
+        }
+
+        if KasperSettings.memoryMonitor {
+            if self.memoryLabel == nil {
+                let label = UILabel()
+                label.font = UIFont.monospacedDigitSystemFont(ofSize: 10.0, weight: .semibold)
+                label.textColor = .white
+                label.backgroundColor = UIColor(white: 0.0, alpha: 0.45)
+                label.textAlignment = .center
+                label.layer.cornerRadius = 7.0
+                label.clipsToBounds = true
+                label.isUserInteractionEnabled = false
+                label.layer.zPosition = 10001.0
+                window.addSubview(label)
+                self.memoryLabel = label
+            }
+            if self.memoryTimer == nil {
+                let timer = Timer(timeInterval: 1.0, repeats: true, block: { [weak self] _ in
+                    self?.updateMemoryLabel()
+                })
+                RunLoop.main.add(timer, forMode: .common)
+                self.memoryTimer = timer
+            }
+            self.updateMemoryLabel()
+        } else {
+            self.memoryTimer?.invalidate()
+            self.memoryTimer = nil
+            self.memoryLabel?.removeFromSuperview()
+            self.memoryLabel = nil
+        }
+    }
+
+    private func updateMemoryLabel() {
+        guard let label = self.memoryLabel, let window = self.hostWindow else {
+            return
+        }
+        let text: String
+        if let bytes = kasperMemoryFootprint() {
+            text = String(format: "%.0f МБ", Double(bytes) / (1024.0 * 1024.0))
+        } else {
+            text = "— МБ"
+        }
+        label.text = text
+        let size = label.sizeThatFits(CGSize(width: 200.0, height: 20.0))
+        let width = ceil(size.width) + 12.0
+        // под часами в строке состояния
+        let top = max(window.safeAreaInsets.top - 4.0, 20.0)
+        label.frame = CGRect(x: 18.0, y: top, width: width, height: 14.0)
+    }
+}
+
+/// Сколько памяти сейчас занимает приложение (как в «Настройки iOS → Хранилище»).
+private func kasperMemoryFootprint() -> UInt64? {
+    var info = task_vm_info_data_t()
+    var count = mach_msg_type_number_t(MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<integer_t>.size)
+    let result = withUnsafeMutablePointer(to: &info) { pointer -> kern_return_t in
+        return pointer.withMemoryRebound(to: integer_t.self, capacity: Int(count)) { reboundPointer -> kern_return_t in
+            return task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), reboundPointer, &count)
+        }
+    }
+    guard result == KERN_SUCCESS else {
+        return nil
+    }
+    return info.phys_footprint
+}
+
+/// Частицы на CAEmitterLayer: рисуются системой, почти не тратят батарею.
+private final class KasperParticlesView: UIView {
+    private let emitter = CAEmitterLayer()
+    private var current: KasperParticles?
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.backgroundColor = .clear
+        self.layer.addSublayer(self.emitter)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        self.emitter.frame = self.bounds
+        self.emitter.emitterPosition = CGPoint(x: self.bounds.midX, y: -20.0)
+        self.emitter.emitterSize = CGSize(width: self.bounds.width * 1.2, height: 1.0)
+    }
+
+    func update(_ particles: KasperParticles) {
+        if self.current == particles {
+            return
+        }
+        self.current = particles
+        self.emitter.emitterShape = .line
+        self.emitter.emitterMode = .outline
+        self.emitter.renderMode = .unordered
+        self.emitter.emitterCells = self.cells(for: particles)
+        self.setNeedsLayout()
+    }
+
+    private func cells(for particles: KasperParticles) -> [CAEmitterCell] {
+        switch particles {
+        case .snow:
+            return [self.cell(image: kasperDotImage(diameter: 10.0), birthRate: 8.0, velocity: 40.0, scale: 0.5, scaleRange: 0.35, spin: 0.0, alpha: 0.85)]
+        case .stars:
+            return [
+                self.cell(image: kasperGlyphImage("✦", size: 18.0, color: .white), birthRate: 3.0, velocity: 30.0, scale: 0.6, scaleRange: 0.3, spin: 0.6, alpha: 0.9),
+                self.cell(image: kasperGlyphImage("✧", size: 18.0, color: UIColor(red: 0.8, green: 0.7, blue: 1.0, alpha: 1.0)), birthRate: 2.0, velocity: 25.0, scale: 0.5, scaleRange: 0.3, spin: 0.4, alpha: 0.9)
+            ]
+        case .hearts:
+            return [self.cell(image: kasperGlyphImage("❤️", size: 22.0, color: .red), birthRate: 1.6, velocity: 45.0, scale: 0.6, scaleRange: 0.3, spin: 0.3, alpha: 0.9)]
+        case .leaves:
+            return [
+                self.cell(image: kasperGlyphImage("🍂", size: 24.0, color: .orange), birthRate: 1.2, velocity: 45.0, scale: 0.6, scaleRange: 0.3, spin: 1.2, alpha: 0.95),
+                self.cell(image: kasperGlyphImage("🍁", size: 24.0, color: .red), birthRate: 0.8, velocity: 45.0, scale: 0.55, scaleRange: 0.3, spin: 1.0, alpha: 0.95)
+            ]
+        case .confetti:
+            let colors: [UIColor] = [.systemPink, .systemYellow, .systemTeal, .systemPurple, .systemGreen, .systemOrange]
+            return colors.map { color in
+                return self.cell(image: kasperRectImage(color: color), birthRate: 1.6, velocity: 80.0, scale: 0.7, scaleRange: 0.3, spin: 3.0, alpha: 1.0)
+            }
+        }
+    }
+
+    private func cell(image: UIImage?, birthRate: Float, velocity: CGFloat, scale: CGFloat, scaleRange: CGFloat, spin: CGFloat, alpha: Float) -> CAEmitterCell {
+        let cell = CAEmitterCell()
+        cell.contents = image?.cgImage
+        cell.birthRate = birthRate
+        cell.lifetime = 16.0
+        cell.velocity = velocity
+        cell.velocityRange = velocity * 0.5
+        cell.emissionLongitude = .pi
+        cell.emissionRange = .pi / 8.0
+        cell.yAcceleration = 6.0
+        cell.scale = scale
+        cell.scaleRange = scaleRange
+        cell.spin = spin
+        cell.spinRange = spin
+        cell.alphaRange = 0.2
+        cell.color = UIColor(white: 1.0, alpha: CGFloat(alpha)).cgColor
+        return cell
+    }
+}
+
+private func kasperDotImage(diameter: CGFloat) -> UIImage? {
+    let renderer = UIGraphicsImageRenderer(size: CGSize(width: diameter, height: diameter))
+    return renderer.image { context in
+        UIColor.white.setFill()
+        context.cgContext.fillEllipse(in: CGRect(x: 0.0, y: 0.0, width: diameter, height: diameter))
+    }
+}
+
+private func kasperRectImage(color: UIColor) -> UIImage? {
+    let size = CGSize(width: 8.0, height: 14.0)
+    let renderer = UIGraphicsImageRenderer(size: size)
+    return renderer.image { context in
+        color.setFill()
+        context.cgContext.fill(CGRect(origin: .zero, size: size))
+    }
+}
+
+private func kasperGlyphImage(_ glyph: String, size: CGFloat, color: UIColor) -> UIImage? {
+    let attributes: [NSAttributedString.Key: Any] = [
+        .font: UIFont.systemFont(ofSize: size),
+        .foregroundColor: color
+    ]
+    let string = NSAttributedString(string: glyph, attributes: attributes)
+    let bounds = string.boundingRect(with: CGSize(width: 200.0, height: 200.0), options: [.usesLineFragmentOrigin], context: nil)
+    let imageSize = CGSize(width: ceil(bounds.width), height: ceil(bounds.height))
+    if imageSize.width <= 0.0 || imageSize.height <= 0.0 {
+        return nil
+    }
+    let renderer = UIGraphicsImageRenderer(size: imageSize)
+    return renderer.image { _ in
+        string.draw(at: .zero)
+    }
+}
